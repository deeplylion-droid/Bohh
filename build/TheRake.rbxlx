		Fing0RA = Vector3.new(0.9715, 1.2, -1.533),
		Fing0RB = Vector3.new(0.8725, 0.48, -1.7695),
		Fing1RA = Vector3.new(1.0705, 1.2, -1.511),
		Fing1RB = Vector3.new(1.0375, 0.48, -1.7365),
		Fing2RA = Vector3.new(1.1695, 1.2, -1.511),
		Fing2RB = Vector3.new(1.2025, 0.48, -1.7365),
		Fing3RA = Vector3.new(1.2685, 1.2, -1.533),
		Fing3RB = Vector3.new(1.3675, 0.48, -1.7695),
		HipR = Vector3.new(0.5, 3.75, 0.25),
		KneeR = Vector3.new(0.56, 2.05, -0.78),
		AnkleR = Vector3.new(0.56, 0.48, 0.36),
		ToeR = Vector3.new(0.56, 0.12, -0.28),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">RakeRig</string><ProtectedString name="Source"><![CDATA[-- Corpo di The Rake: radice invisibile (HumanoidRootPart) più la mesh con scheletro (40 ossa),
-- animata dai client tramite Bone.Transform. Usato dal server per la creatura vera e dai client
-- per le allucinazioni (sagoma nera ancorata).
local Models = require(script.Parent:WaitForChild("Models"))
local RakeAsset = require(script.Parent:WaitForChild("RakeAsset"))

local RakeRig = {}

-- Il centro della HumanoidRootPart sta 3.7 stud sopra il suolo
RakeRig.HIP_HEIGHT = 2.7
RakeRig.ROOT_HEIGHT = 3.7

-- rootCF: CFrame del centro della radice. opts.ghost = sagoma nera ancorata (allucinazione).
function RakeRig.build(model: Model, rootCF: CFrame, opts: { ghost: boolean? }?)
	local ghost = opts and opts.ghost or false
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CFrame = rootCF
	root.Anchored = ghost
	root.CanCollide = not ghost
	root.CanQuery = not ghost
	root.Parent = model

	local template = Models.template("Rake_Body")
	local body: BasePart
	if template then
		body = (template :: BasePart):Clone()
	else
		body = Instance.new("Part")
		body.Color = Color3.fromRGB(190, 184, 172)
		body.Material = Enum.Material.SmoothPlastic
	end
	body.Name = "Body"
	body.Size = RakeAsset.size
	body.CFrame = rootCF * CFrame.new(RakeAsset.center - Vector3.new(0, RakeRig.ROOT_HEIGHT, 0))
	body.Anchored = ghost
	body.CanCollide = false
	body.CanTouch = false
	body.CanQuery = not ghost
	body.Massless = true
	body.CastShadow = true
	if ghost then
		(body :: any).TextureID = ""
		body.Color = Color3.fromRGB(6, 6, 6)
	end
	body.Parent = model
	if not ghost then
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = body
		weld.Parent = body
	end
	model.PrimaryPart = root
	return { root = root, body = body, head = body }
end

return RakeRig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Sfx</string><ProtectedString name="Source"><![CDATA[-- Suoni dai fogli di effetti sintetizzati (Audio, Audio2, Audio3): ogni effetto è un intervallo
-- di uno dei file, riprodotto con Sound.PlaybackRegion.
local Shared = script.Parent
local SHEETS = {
	require(Shared:WaitForChild("Audio")),
	require(Shared:WaitForChild("Audio2")),
	require(Shared:WaitForChild("Audio3")),
}

local Sfx = {}

local function find(name: string)
	for _, sheet in SHEETS do
		local region = sheet.REGIONS[name]
		if region then
			return region, sheet.SFX
		end
	end
	return nil, SHEETS[1].SFX
end

function Sfx.new(name: string, parent: Instance?, props: { [string]: any }?): Sound
	local region, id = find(name)
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 6
	sound.RollOffMaxDistance = 120
	if region then
		local range = NumberRange.new(region.start, region.start + region.length)
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = range
		if region.loop then
			sound.LoopRegion = range
			sound.Looped = true
		end
	end
	if props then
		for key, value in props do
			(sound :: any)[key] = value
		end
	end
	sound.Parent = parent
	return sound
end

-- Suono singolo in un punto del mondo, eliminato a fine riproduzione
function Sfx.at(name: string, position: Vector3, props: { [string]: any }?)
	local holder = Instance.new("Part")
	holder.Name = "Suono"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.CFrame = CFrame.new(position)
	local sound = Sfx.new(name, holder, props)
	holder.Parent = workspace
	sound:Play()
	local region = find(name)
	task.delay((region and region.length or 3) / math.max(sound.PlaybackSpeed, 0.1) + 0.5, function()
		holder:Destroy()
	end)
	return sound
end

return Sfx
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX24"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX23"><Properties><string name="Name">RakeHunt</string><ProtectedString name="Source"><![CDATA[-- Avvia la partita (tutta la logica è nel modulo Game).
require(script.Game)()
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Cameras</string><ProtectedString name="Source"><![CDATA[-- Telecamere di sorveglianza: piazzamento, batteria, rilevamento della creatura e copertura della mappa.
-- Tipi: Fissa (economica), IR (vede di notte), Motorizzata (ruota dal tablet), Trappola (scatta sul movimento).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(Shared:WaitForChild("Models"))
local Sfx = require(Shared:WaitForChild("Sfx"))
local Forest = require(script.Parent.Forest)

local C = Config.CAMERAS
local make = Forest.make

local Cameras = {}

local ctx
local folder: Folder
local nextId = 0
local data: { [Model]: { useful: boolean, notified: number, lastSnap: number } } = {}
local keyCells: { Vector3 } = {}

-- Mesh del corpo e distanza della lente dal centro del corpo per ogni tipo
local BODIES = {
	Fissa = { mesh = "Cam_Body", lens = 1.17, lensR = 0.3 },
	IR = { mesh = "Cam_IR", lens = 1.02, lensR = 0.24 },
	Motorizzata = { mesh = "Cam_Motor", lens = 0.97, lensR = 0.2 },
	Trappola = { mesh = "Cam_Trap", lens = 0.47, lensR = 0.13 },
}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function inCone(cf: CFrame, target: Vector3, range: number): boolean
	local to = flat(target - cf.Position)
	if to.Magnitude > range then
		return false
	end
	if to.Magnitude < 1 then
		return true
	end
	local look = flat(cf.LookVector).Unit
	return math.deg(math.acos(math.clamp(look:Dot(to.Unit), -1, 1))) <= C.FOV / 2
end

function Cameras.init(c)
	ctx = c
	folder = make("Folder", ctx.world, { Name = "Telecamere" })
	-- Celle "importanti" per la copertura: sentieri e punti di interesse
	local half = Forest.HALF
	local cell = C.COVERAGE_CELL
	for x = -half + cell / 2, half, cell do
		for z = -half + cell / 2, half, cell do
			local p = Vector3.new(x, 0, z)
			local _, poiDist = Forest.nearestPoi(p)
			if not Forest.inLake(p) and (Forest.distToPath(p) < 14 or poiDist < 40) then
				table.insert(keyCells, p)
			end
		end
	end
end

function Cameras.folder(): Folder
	return folder
end

function Cameras.updateCoverage()
	local online = {}
	for _, m in folder:GetChildren() do
		if m:GetAttribute("Online") and m.PrimaryPart then
			table.insert(online, m)
		end
	end
	local covered = 0
	for _, p in keyCells do
		for _, m in online do
			local range = m:GetAttribute("Type") == "Trappola" and C.TRAP_RANGE or C.VIEW_RANGE
			if inCone(m.PrimaryPart.CFrame, p, range) then
				covered += 1
				break
			end
		end
	end
	ctx.state:SetAttribute("Coverage", #keyCells > 0 and math.floor(covered / #keyCells * 100 + 0.5) or 0)
	ctx.state:SetAttribute("CamerasActive", #online)
end

function Cameras.reset()
	folder:ClearAllChildren()
	table.clear(data)
	nextId = 0
	Cameras.updateCoverage()
end

local function setOnline(m: Model, online: boolean)
	m:SetAttribute("Online", online)
	local led = m:FindFirstChild("Led") :: BasePart?
	if led then
		led.Color = online and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(40, 40, 40)
	end
end

function Cameras.recover(player: Player, m: Model)
	if not m.Parent or not ctx.team.isStanding(player) then
		return
	end
	local camType = m:GetAttribute("Type")
	local key = "Kits_" .. camType
	player:SetAttribute(key, (player:GetAttribute(key) or 0) + 1)
	data[m] = nil
	m:Destroy()
	ctx.notify(("Telecamera %s recuperata (batteria ricaricata)."):format(camType), player)
	Cameras.updateCoverage()
end

function Cameras.place(player: Player)
	if not ctx.round.active then
		ctx.notify("Le telecamere si piazzano durante la notte.", player)
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp or not ctx.team.isStanding(player) then
		return
	end
	local camType = player:GetAttribute("CamType") or "Fissa"
	local key = "Kits_" .. camType
	local kits = player:GetAttribute(key) or 0
	if kits <= 0 then
		ctx.notify(("Non hai più telecamere %s: premi R per cambiare tipo."):format(camType), player)
		return
	end

	local look = flat(hrp.CFrame.LookVector)
	look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
	local base = hrp.Position + look * 3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	local ground = workspace:Raycast(base + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), params)
	local y = ground and ground.Position.Y or 0

	nextId += 1
	local m = Cameras.build(camType, base, y, look)
	local label = Forest.describe(base)
	Cameras.register(m, nextId, camType, player, label)
	player:SetAttribute(key, kits - 1)
	ctx.notify(("📷 Camera %d (%s) piazzata %s."):format(nextId, camType, label), player)
	Cameras.updateCoverage()
end

-- Modello 3D della telecamera appoggiato a terra in (base.X, y, base.Z) e rivolto verso look
function Cameras.build(camType: string, base: Vector3, y: number, look: Vector3): Model
	local m = Instance.new("Model")
	local spec = BODIES[camType] or BODIES.Fissa
	local trap = camType == "Trappola"
	local mountY = y + (trap and 3.1 or 3.75)
	local bodyY = mountY + (camType == "Motorizzata" and 0.95 or (trap and 0 or 0.5))
	local bodyPos = Vector3.new(base.X, bodyY, base.Z)
	local bodyCF = CFrame.lookAt(bodyPos, bodyPos + look)
	local visual = { CanCollide = false, CanQuery = false, CastShadow = true }
	if trap then
		Models.mesh("Cam_Stake", bodyCF, 1, visual, m)
	else
		Models.mesh("Cam_Tripod", CFrame.new(base.X, mountY, base.Z) * (bodyCF - bodyCF.Position), 1, visual, m)
	end
	Models.mesh(spec.mesh, bodyCF, 1, visual, m)
	local body = make("Part", m, {
		Name = "Body",
		Size = Vector3.new(0.6, 0.6, 0.6),
		CFrame = bodyCF,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	make("Part", m, {
		Name = "Obiettivo",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.04, spec.lensR * 2, spec.lensR * 2),
		CFrame = bodyCF * CFrame.new(0, 0, -spec.lens) * CFrame.Angles(0, math.pi / 2, 0),
		Color = Color3.fromRGB(20, 30, 45),
		Material = Enum.Material.Glass,
		Reflectance = 0.4,
		CanCollide = false,
		CanQuery = false,
	})
	make("Part", m, {
		Name = "Led",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.09, 0.09, 0.09),
		CFrame = bodyCF * CFrame.new(trap and 0.2 or 0.38, trap and 0.5 or 0.3, -(trap and 0.34 or 0.72)),
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
	})
	if camType == "IR" then
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			make("Part", m, {
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.08, 0.08, 0.08),
				CFrame = bodyCF * CFrame.new(math.cos(a) * 0.34, math.sin(a) * 0.34, -0.74),
				Color = Color3.fromRGB(90, 10, 10),
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
			})
		end
	end
	-- illuminatore a infrarossi: lo accende solo il client che sta guardando questa camera
	make("SpotLight", body, {
		Name = "Illuminatore",
		Face = Enum.NormalId.Front,
		Angle = 75,
		Range = camType == "IR" and 95 or 70,
		Brightness = 2.2,
		Shadows = false,
		Color = Color3.fromRGB(215, 235, 215),
		Enabled = false,
	})
	local flash = make("PointLight", body, { Range = 30, Brightness = 6, Enabled = false, Color = Color3.fromRGB(255, 255, 255) })
	flash.Name = "Flash"
	if trap then
		local snapSound = Sfx.new("TrapClick", body, { Volume = 1, RollOffMaxDistance = 60 })
		snapSound.Name = "Scatto"
	end
	m.PrimaryPart = body
	return m
end

function Cameras.register(m: Model, id: number, camType: string, player: Player, label: string)
	m.Name = "Cam" .. id
	m:SetAttribute("Id", id)
	m:SetAttribute("Type", camType)
	m:SetAttribute("Owner", player.UserId)
	m:SetAttribute("OwnerName", player.DisplayName)
	m:SetAttribute("Battery", C.BATTERY)
	m:SetAttribute("Online", true)
	m:SetAttribute("Label", label)
	m:SetAttribute("Sees", false)
	local look = m.PrimaryPart.CFrame.LookVector
	m:SetAttribute("Yaw", math.deg(math.atan2(-look.X, -look.Z)))

	local prompt = make("ProximityPrompt", m.PrimaryPart, {
		ActionText = "Recupera",
		ObjectText = ("Camera %d · %s"):format(id, camType),
		HoldDuration = 1,
		MaxActivationDistance = 8,
		RequiresLineOfSight = false,
	})
	prompt.Triggered:Connect(function(p)
		Cameras.recover(p, m)
	end)

	data[m] = { useful = false, notified = 0, lastSnap = 0 }
	m.Parent = folder
end

function Cameras.rotate(player: Player, id: any, dir: any)
	if typeof(id) ~= "number" or (dir ~= 1 and dir ~= -1) then
		return
	end
	for _, m in folder:GetChildren() do
		if m:GetAttribute("Id") == id then
			if m:GetAttribute("Type") ~= "Motorizzata" or not m:GetAttribute("Online") then
				return
			end
			local yaw = (m:GetAttribute("Yaw") or 0) + dir * 20
			m:SetAttribute("Yaw", yaw)
			m:PivotTo(CFrame.new(m.PrimaryPart.Position) * CFrame.Angles(0, math.rad(yaw), 0))
			Cameras.updateCoverage()
			return
		end
	end
end

local function snap(m: Model, rakePos: Vector3)
	local body = m.PrimaryPart
	local flash = body:FindFirstChild("Flash") :: PointLight?
	if flash then
		flash.Enabled = true
		task.delay(0.15, function()
			flash.Enabled = false
		end)
	end
	local sound = body:FindFirstChild("Scatto") :: Sound?
	if sound then
		sound:Play()
	end
	ctx.notifyAll(("📸 La camera trappola %d (%s) ha fotografato qualcosa!"):format(m:GetAttribute("Id"), m:GetAttribute("Label")))
	ctx.addTracking(C.TRAP_TRACKING)
	ctx.setLastSeen(rakePos)
end

function Cameras.tick(dt: number)
	local rakePos = ctx.rake.position()
	local noise = ctx.weather.cameraNoise
	local now = os.clock()
	local changed = false
	for _, m in folder:GetChildren() do
		local body = m.PrimaryPart
		local info = data[m]
		if not body or not info then
			continue
		end
		local online = m:GetAttribute("Online")
		if online then
			local battery = math.max(0, m:GetAttribute("Battery") - dt)
			m:SetAttribute("Battery", battery)
			if battery <= 0 then
				online = false
				setOnline(m, false)
				changed = true
				ctx.notifyAll(("🔋 La camera %d (%s) si è scaricata."):format(m:GetAttribute("Id"), m:GetAttribute("Label")))
			end
		end

		local camType = m:GetAttribute("Type")
		local sees = false
		if online and rakePos then
			local range = camType == "Trappola" and C.TRAP_RANGE or C.VIEW_RANGE
			if camType == "IR" then
				range *= C.IR_RANGE_BONUS
			end
			range *= 1 - noise * 0.5
			sees = inCone(body.CFrame, rakePos, range) and ctx.rake.visibleFrom(body.Position, { folder })
		end

		if camType == "Trappola" then
			if sees and now - info.lastSnap > C.TRAP_COOLDOWN then
				info.lastSnap = now
				snap(m, rakePos)
				if not info.useful then
					info.useful = true
					ctx.credit(m:GetAttribute("Owner"), "sightings")
				end
			end
			sees = false
		elseif sees then
			ctx.addTracking(Config.EVIDENCE.SIGHTING_RATE * dt)
			ctx.setLastSeen(rakePos)
			if not info.useful then
				info.useful = true
				ctx.credit(m:GetAttribute("Owner"), "sightings")
			end
			if now - info.notified > 30 then
				info.notified = now
				ctx.notifyAll(("📹 Movimento sulla camera %d (%s)!"):format(m:GetAttribute("Id"), m:GetAttribute("Label")))
			end
		end
		if m:GetAttribute("Sees") ~= sees then
			m:SetAttribute("Sees", sees)
		end
	end
	if changed then
		Cameras.updateCoverage()
	end
end

return Cameras
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Evidence</string><ProtectedString name="Source"><![CDATA[-- Prove e tracciamento: impronte, graffi, peli, sangue e carcasse lasciati dalla creatura.
-- Peli e sangue vanno analizzati al laboratorio. Alcune tracce sono depistaggi.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Forest = require(script.Parent.Forest)

local E = Config.EVIDENCE
local make = Forest.make

local Evidence = {}

local ctx
local folder: Folder
local rng = Random.new()
local analyzing = false

local DROP_TABLE = { "Impronte", "Impronte", "Impronte", "Graffi", "Graffi", "Peli", "Sangue", "Carcassa" }

local builders = {}

function builders.Impronte(m: Model, cf: CFrame): BasePart
	local main
	for i = 0, 2 do
		local side = i % 2 == 0 and -0.6 or 0.6
		local footprint = make("Part", m, {
			Size = Vector3.new(1.1, 0.1, 1.9),
			CFrame = cf * CFrame.new(side, 0.05, -i * 2.6),
			Color = Color3.fromRGB(45, 32, 25),
			Material = Enum.Material.Mud,
			CanCollide = false,
		})
		for t = -1, 1 do
			make("Part", m, {
				Size = Vector3.new(0.15, 0.1, 0.8),
				CFrame = cf * CFrame.new(side + t * 0.35, 0.06, -i * 2.6 - 1.3) * CFrame.Angles(0, t * 0.3, 0),
				Color = Color3.fromRGB(35, 25, 20),
				Material = Enum.Material.Mud,
				CanCollide = false,
			})
		end
		main = main or footprint
	end
	return main
end

function builders.Graffi(m: Model, cf: CFrame): BasePart
	local stump = make("Part", m, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 2.4, 2.4),
		CFrame = cf * CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(80, 58, 40),
		Material = Enum.Material.Wood,
	})
	for i = -1, 1 do
		make("Part", m, {
			Size = Vector3.new(0.12, 1.8, 0.08),
			CFrame = cf * CFrame.new(i * 0.4, 1.6, -1.2) * CFrame.Angles(0, 0, 0.35),
			Color = Color3.fromRGB(215, 190, 150),
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end
	return stump
end

function builders.Peli(m: Model, cf: CFrame): BasePart
	local main
	for i = 1, 3 do
		local p = make("Part", m, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.6, 0.6, 0.6),
			CFrame = cf * CFrame.new(rng:NextNumber(-0.6, 0.6), 0.25, rng:NextNumber(-0.6, 0.6)),
			Color = Color3.fromRGB(150, 145, 135),
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
		main = main or p
	end
	return main
end

function builders.Sangue(m: Model, cf: CFrame): BasePart
	local main
	for i = 1, 4 do
		local d = rng:NextNumber(0.6, 2.2)
		local p = make("Part", m, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.08, d, d),
			CFrame = cf * CFrame.new(rng:NextNumber(-1.5, 1.5), 0.05, -i * 0.9) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(85, 10, 12),
			Material = Enum.Material.Glass,
			CanCollide = false,
		})
		main = main or p
	end
	return main
end

function builders.Carcassa(m: Model, cf: CFrame): BasePart
	local body = make("Part", m, {
		Size = Vector3.new(1.6, 1.3, 4),
		CFrame = cf * CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, 0.3),
		Color = Color3.fromRGB(110, 75, 50),
		Material = Enum.Material.Fabric,
	})
	make("Part", m, {
		Size = Vector3.new(0.9, 0.9, 1.4),
		CFrame = cf * CFrame.new(0.3, 0.45, -2.6) * CFrame.Angles(0.2, 0.4, 0),
		Color = Color3.fromRGB(100, 70, 48),
		Material = Enum.Material.Fabric,
	})
	for i = -1, 1 do
		make("Part", m, {
			Size = Vector3.new(0.2, 1.3, 0.2),
			CFrame = cf * CFrame.new(-0.6, 1.2, i * 0.8) * CFrame.Angles(0, 0, -0.4),
			Color = Color3.fromRGB(225, 215, 195),
			CanCollide = false,
		})
	end
	return body
end

local function groundY(pos: Vector3): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(Vector3.new(pos.X, 40, pos.Z), Vector3.new(0, -80, 0), params)
	return hit and hit.Position.Y or 0
end

local function collect(player: Player, m: Model)
	if not m.Parent or not ctx.round.active or not ctx.team.isStanding(player) then
		return
	end
	local kind = m:GetAttribute("Type")
	local fake = m:GetAttribute("Fake")
	m:Destroy()
	if fake then
		ctx.notify("🐾 Traccia falsa! The Rake ti ha depistato.", player)
		ctx.rake.addAggression(4)
		return
	end
	ctx.credit(player.UserId, "evidence")
	ctx.state:SetAttribute("Evidence", (ctx.state:GetAttribute("Evidence") or 0) + 1)
	local value = E.TRACKING[kind] or 5
	if E.NEEDS_LAB[kind] then
		player:SetAttribute("Samples", (player:GetAttribute("Samples") or 0) + 1)
		player:SetAttribute("SamplePoints", (player:GetAttribute("SamplePoints") or 0) + value * E.LAB_MULTIPLIER)
		ctx.notify(("🧪 Campione raccolto (%s): portalo al laboratorio della Ranger Station."):format(kind), player)
	else
		ctx.addTracking(value)
		ctx.notify(("🔎 Prova raccolta: %s (+%d%% tracciamento)"):format(kind, value), player)
	end
end

function Evidence.spawn(kind: string, pos: Vector3, fake: boolean)
	local existing = folder:GetChildren()
	if #existing >= E.MAX_ACTIVE then
		existing[1]:Destroy()
	end
	local m = Instance.new("Model")
	m.Name = kind
	local cf = CFrame.new(pos.X, groundY(pos), pos.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local main = builders[kind](m, cf)
	m:SetAttribute("Type", kind)
	m:SetAttribute("Fake", fake)
	local prompt = make("ProximityPrompt", main, {
		ActionText = "Raccogli",
		ObjectText = "Prova: " .. kind,
		HoldDuration = 1.5,
		MaxActivationDistance = 9,
		RequiresLineOfSight = false,
	})
	prompt.Triggered:Connect(function(player)
		collect(player, m)
	end)
	m.Parent = folder
end

-- Lascia una traccia vicino alla creatura (o un depistaggio lontano)
function Evidence.dropNear(pos: Vector3)
	if rng:NextNumber() < E.FAKE_CHANCE then
		local fakePos = Forest.randomGround(rng, pos, 80, 150)
		Evidence.spawn(rng:NextNumber() < 0.6 and "Impronte" or "Graffi", fakePos, true)
	else
		Evidence.spawn(DROP_TABLE[rng:NextInteger(1, #DROP_TABLE)], Forest.randomGround(rng, pos, 2, 6), false)
	end
end

-- Tracce iniziali intorno alla tana
function Evidence.seed(lair: Vector3)
	for _ = 1, E.START_COUNT do
		Evidence.spawn(DROP_TABLE[rng:NextInteger(1, #DROP_TABLE)], Forest.randomGround(rng, lair, 15, 130), false)
	end
end

function Evidence.analyze(player: Player)
	if not ctx.round.active or not ctx.team.isStanding(player) then
		return
	end
	local samples = player:GetAttribute("Samples") or 0
	if samples <= 0 then
		ctx.notify("Non hai campioni da analizzare: raccogli peli o sangue nel bosco.", player)
		return
	end
	if analyzing then
		ctx.notify("Il laboratorio è già occupato.", player)
		return
	end
	analyzing = true
	local points = player:GetAttribute("SamplePoints") or 0
	player:SetAttribute("Samples", 0)
	player:SetAttribute("SamplePoints", 0)
	ctx.notifyAll(("🔬 Analisi di %d campion%s in corso (%d s)… il generatore fa rumore e attira la creatura!"):format(
		samples,
		samples == 1 and "e" or "i",
		E.LAB_TIME
	))
	ctx.rake.addAggression(10)
	ctx.rake.hearNoise(Forest.STATION, 1)
	local light = Forest.labLight
	task.spawn(function()
		local finish = os.clock() + E.LAB_TIME
		while os.clock() < finish and ctx.round.active do
			if light then
				light.Color = light.Color == Color3.fromRGB(120, 200, 255) and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(120, 200, 255)
			end
			task.wait(0.4)
		end
		if light then
			light.Color = Color3.fromRGB(120, 200, 255)
		end
		analyzing = false
		if ctx.round.active then
			ctx.addTracking(points)
			ctx.notifyAll(("🔬 Analisi completata: +%d%% tracciamento."):format(points))
		end
	end)
end

function Evidence.init(c)
	ctx = c
	folder = make("Folder", ctx.world, { Name = "Prove" })
end

function Evidence.reset()
	folder:ClearAllChildren()
	analyzing = false
end

return Evidence
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Forest</string><ProtectedString name="Source"><![CDATA[-- Il bosco: terreno irregolare (colline, creste rocciose, paludi, lago e pareti ai confini) generato una
-- volta per server, sentieri, punti di interesse, e vegetazione con modelli 3D rigenerata a ogni notte.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(Shared:WaitForChild("Models"))

local MAP = Config.MAP
local SIZE = MAP.SIZE
local HALF = SIZE / 2
local LAKE = MAP.LAKE
local PATH_W = MAP.PATH_WIDTH

local Forest = {}
Forest.HALF = HALF
Forest.WATER_LEVEL = -5
Forest.SWAMP_WATER = -6.4

local seedRng = Random.new()
local SX, SZ = seedRng:NextNumber(-500, 500), seedRng:NextNumber(-500, 500)

local WOOD = Color3.fromRGB(96, 70, 48)
local DARK_WOOD = Color3.fromRGB(58, 42, 30)
local M = Enum.Material

---------------------------------------------------------------------------------------------
-- Utilità

local function make(className: string, parent: Instance?, props: { [string]: any }): any
	local inst = Instance.new(className)
	if inst:IsA("BasePart") then
		inst.Anchored = true
		inst.TopSurface = Enum.SurfaceType.Smooth
		inst.BottomSurface = Enum.SurfaceType.Smooth
	end
	for key, value in props do
		(inst :: any)[key] = value
	end
	inst.Parent = parent
	return inst
end
Forest.make = make

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function smoothstep(a: number, b: number, x: number): number
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Luce che i client fanno tremolare (più forte quando la creatura è vicina)
local function flicker(light: Light)
	light:SetAttribute("BaseBrightness", light.Brightness)
	CollectionService:AddTag(light, "Flicker")
end
Forest.flicker = flicker

---------------------------------------------------------------------------------------------
-- Altezza del terreno

local function fbm(x: number, z: number): number
	local total, amp, norm, freq = 0, 1, 0, 1 / 210
	for i = 1, 4 do
		total += math.noise(x * freq + SX + i * 31.7, z * freq + SZ - i * 17.3, i * 0.37) * amp
		norm += amp
		amp *= 0.5
		freq *= 2.03
	end
	return total / norm * 2
end

local function ridge(x: number, z: number): number
	local n = math.noise(x / 150 + SX * 0.5, z / 150 - SZ * 0.5, 4.2)
	return (1 - math.min(1, math.abs(n) * 2.4)) ^ 3
end

-- Pesi dei quattro biomi, sfumati lungo gli assi
local function biomeWeights(x: number, z: number)
	local a = smoothstep(-55, 55, x)
	local b = smoothstep(-55, 55, z)
	return a * (1 - b), (1 - a) * (1 - b), (1 - a) * b, a * b -- pineta, campeggio, palude, miniera
end

local function natural(x: number, z: number): number
	local wP, wC, wS, wM = biomeWeights(x, z)
	local n = fbm(x, z)
	local r = ridge(x, z)
	local h = wP * (n * 20 + r * 15 + 2) + wC * (n * 12 + 1) + wS * (n * 4 - 4.6) + wM * (n * 18 + r * 26 + 9)
	h += math.noise(x / 23 + SX, z / 23 + SZ, 9.1) * 1.6
	local edge = math.max(math.abs(x), math.abs(z))
	h += smoothstep(HALF - 110, HALF + 20, edge) ^ 1.6 * 58
	local d = flat(Vector3.new(x, 0, z) - LAKE.center).Magnitude
	if d < LAKE.radius + 35 then
		local bottom = Forest.WATER_LEVEL - 9 + (d / LAKE.radius) ^ 2 * 6
		h = lerp(h, bottom, smoothstep(LAKE.radius + 35, LAKE.radius * 0.7, d))
	end
	return h
end

-- Punti di interesse con la loro quota (il terreno viene spianato intorno)
local POIS = {}
for i, poi in MAP.POIS do
	local h = natural(poi.pos.X, poi.pos.Z)
	if poi.name == "Lago" then
		h = math.max(h, Forest.WATER_LEVEL + 1.4)
	end
	POIS[i] = { name = poi.name, radius = poi.radius, pos = Vector3.new(poi.pos.X, h, poi.pos.Z) }
end
Forest.POIS = POIS
Forest.STATION = POIS[1].pos

local PATHS = {}
for _, pair in MAP.PATHS do
	table.insert(PATHS, { POIS[pair[1]].pos, POIS[pair[2]].pos })
end
Forest.PATHS = PATHS

function Forest.distToSegment(p: Vector3, a: Vector3, b: Vector3): (number, number)
	local ab = flat(b - a)
	local ap = flat(p - a)
	local t = math.clamp(ap:Dot(ab) / ab:Dot(ab), 0, 1)
	return (ap - ab * t).Magnitude, t
end

-- Distanza dal sentiero più vicino e quota del sentiero in quel punto
local function pathInfo(x: number, z: number): (number, number)
	local p = Vector3.new(x, 0, z)
	local best, bestT, bestSeg = math.huge, 0, nil
	for _, seg in PATHS do
		local d, t = Forest.distToSegment(p, seg[1], seg[2])
		if d < best then
			best, bestT, bestSeg = d, t, seg
		end
	end
	if best > PATH_W / 2 + 8 then
		return best, 0
	end
	local c = bestSeg[1]:Lerp(bestSeg[2], bestT)
	return best, math.max(natural(c.X, c.Z), Forest.WATER_LEVEL + 0.9)
end

function Forest.distToPath(p: Vector3): number
	return (pathInfo(p.X, p.Z))
end

function Forest.heightAt(x: number, z: number): number
	local h = natural(x, z)
	local pd, py = pathInfo(x, z)
	if pd < PATH_W / 2 + 8 then
		h = lerp(h, py, smoothstep(PATH_W / 2 + 8, PATH_W / 2, pd))
	end
	for _, poi in POIS do
		local d = flat(Vector3.new(x, 0, z) - poi.pos).Magnitude
		if d < poi.radius + 30 then
			h = lerp(h, poi.pos.Y, smoothstep(poi.radius + 30, poi.radius, d))
		end
	end
	return h
end

function Forest.waterAt(x: number, z: number): number
	if flat(Vector3.new(x, 0, z) - LAKE.center).Magnitude < LAKE.radius + 45 then
		return Forest.WATER_LEVEL
	end
	local _, _, wS = biomeWeights(x, z)
	if wS > 0.5 then
		return Forest.SWAMP_WATER
	end
	return -math.huge
end

function Forest.groundAt(x: number, z: number): Vector3
	return Vector3.new(x, Forest.heightAt(x, z), z)
end

function Forest.slopeAt(x: number, z: number): number
	local dx = Forest.heightAt(x + 2, z) - Forest.heightAt(x - 2, z)
	local dz = Forest.heightAt(x, z + 2) - Forest.heightAt(x, z - 2)
	return math.sqrt(dx * dx + dz * dz) / 4
end

function Forest.isDry(p: Vector3): boolean
	return Forest.heightAt(p.X, p.Z) > Forest.waterAt(p.X, p.Z) + 0.4
end

function Forest.biomeAt(pos: Vector3): string
	if pos.X >= 0 and pos.Z < 0 then
		return "Pineta fitta"
	elseif pos.X < 0 and pos.Z < 0 then
		return "Ruderi del campeggio"
	elseif pos.X < 0 then
		return "Palude"
	end
	return "Miniera"
end

function Forest.inLake(p: Vector3, margin: number?): boolean
	return flat(p - LAKE.center).Magnitude < LAKE.radius + (margin or 0)
end

function Forest.inStation(p: Vector3, margin: number?): boolean
	return flat(p - Forest.STATION).Magnitude < MAP.STATION_RADIUS + (margin or 0)
end

function Forest.isOpenGround(p: Vector3, margin: number): boolean
	for _, poi in POIS do
		if flat(p - poi.pos).Magnitude < poi.radius + margin then
			return false
		end
	end
	return Forest.distToPath(p) >= PATH_W / 2 + margin
end

function Forest.clampToMap(p: Vector3): Vector3
	local limit = HALF - 40
	local x, z = math.clamp(p.X, -limit, limit), math.clamp(p.Z, -limit, limit)
	return Forest.groundAt(x, z)
end

-- Punto a terra (asciutto) tra minR e maxR da center
function Forest.randomGround(rng: Random, center: Vector3, minR: number, maxR: number): Vector3
	local p = Forest.clampToMap(center)
	for _ = 1, 30 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(minR, maxR)
		p = Forest.clampToMap(center + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r))
		if Forest.isDry(p) and Forest.slopeAt(p.X, p.Z) < 1 then
			return p
		end
	end
	return p
end

function Forest.nearestPoi(pos: Vector3)
	local best, bestDist = POIS[1], math.huge
	for _, poi in POIS do
		local d = flat(pos - poi.pos).Magnitude
		if d < bestDist then
			best, bestDist = poi, d
		end
	end
	return best, bestDist
end

function Forest.describe(pos: Vector3): string
	local poi, dist = Forest.nearestPoi(pos)
	if dist < poi.radius + 45 then
		return "vicino a " .. poi.name
	end
	return Forest.biomeAt(pos)
end

---------------------------------------------------------------------------------------------
-- Terreno (WriteVoxels a blocchi)

local function surfaceMaterial(x: number, z: number, h: number, slope: number, water: number): Enum.Material
	if h < water - 0.3 then
		return M.Mud
	end
	local pd = pathInfo(x, z)
	local wP, wC, wS, wM = biomeWeights(x, z)
	if pd < PATH_W / 2 then
		return wS > 0.5 and M.WoodPlanks or M.Ground
	end
	for i, poi in POIS do
		if flat(Vector3.new(x, 0, z) - poi.pos).Magnitude < poi.radius * 0.8 then
			if i == 3 then
				return M.LeafyGrass
			elseif i == 4 then
				return M.Sand
			elseif i == 6 then
				return M.Slate
			end
			return M.Ground
		end
	end
	if slope > 1.05 or h > 40 then
		return M.Rock
	elseif slope > 0.7 then
		return M.Slate
	end
	local patch = math.noise(x / 38 + SX, z / 38 - SZ, 2.7)
	if h < water + 0.9 then
		return M.Mud
	end
	local best = math.max(wP, wC, wS, wM)
	if best == wP then
		return patch > 0.22 and M.LeafyGrass or (patch < -0.28 and M.Ground or M.Grass)
	elseif best == wC then
		return patch > 0.1 and M.LeafyGrass or M.Grass
	elseif best == wS then
		return patch > 0.15 and M.Grass or M.Mud
	end
	return patch > 0.2 and M.Rock or (patch < -0.25 and M.Grass or M.Ground)
end

local function buildTerrain()
	local terrain = workspace.Terrain
	terrain:Clear()
	local RES = 4
	local EXT = HALF + 48
	local N = math.floor(EXT * 2 / RES)
	local X0 = -EXT
	local CHUNK = 32
	for cx = 0, N - 1, CHUNK do
		for cz = 0, N - 1, CHUNK do
			local nx, nz = math.min(CHUNK, N - cx), math.min(CHUNK, N - cz)
			local heights, waters = {}, {}
			local lo, hi = math.huge, -math.huge
			for i = 1, nx + 2 do
				heights[i], waters[i] = {}, {}
				for k = 1, nz + 2 do
					local x = X0 + (cx + i - 2) * RES + RES / 2
					local z = X0 + (cz + k - 2) * RES + RES / 2
					local h = Forest.heightAt(x, z)
					heights[i][k] = h
					waters[i][k] = Forest.waterAt(x, z)
					if i > 1 and k > 1 and i <= nx + 1 and k <= nz + 1 then
						lo = math.min(lo, h)
						hi = math.max(hi, h, waters[i][k] > -1e6 and waters[i][k] or h)
					end
				end
			end
			local minY = math.floor((lo - 12) / RES) * RES
			local maxY = math.ceil((hi + 4) / RES) * RES
			local ny = (maxY - minY) / RES
			local mats, occs = {}, {}
			for i = 1, nx do
				mats[i], occs[i] = {}, {}
				for y = 1, ny do
					mats[i][y], occs[i][y] = {}, {}
				end
				for k = 1, nz do
					local h = heights[i + 1][k + 1]
					local water = waters[i + 1][k + 1]
					local slope = math.sqrt((heights[i + 2][k + 1] - heights[i][k + 1]) ^ 2 + (heights[i + 1][k + 2] - heights[i + 1][k]) ^ 2) / (2 * RES)
					local x = X0 + (cx + i - 1) * RES + RES / 2
					local z = X0 + (cz + k - 1) * RES + RES / 2
					local surface = surfaceMaterial(x, z, h, slope, water)
					for y = 1, ny do
						local bottom = minY + (y - 1) * RES
						local occ = math.clamp((h - bottom) / RES, 0, 1)
						local mat = surface
						if h - bottom > 8 then
							mat = slope > 0.7 and M.Rock or M.Ground
						end
						if occ <= 0.02 then
							if bottom < water then
								mat, occ = M.Water, 1
							else
								mat, occ = M.Air, 0
							end
						end
						mats[i][y][k] = mat
						occs[i][y][k] = occ
					end
				end
			end
			local min = Vector3.new(X0 + cx * RES, minY, X0 + cz * RES)
			local region = Region3.new(min, min + Vector3.new(nx * RES, ny * RES, nz * RES))
			terrain:WriteVoxels(region, RES, mats, occs)
			task.wait()
		end
	end

	terrain.WaterColor = Color3.fromRGB(16, 24, 20)
	terrain.WaterTransparency = 0.25
	terrain.WaterReflectance = 0.7
	terrain.WaterWaveSize = 0.04
	terrain.WaterWaveSpeed = 4
	for mat, color in {
		[M.Grass] = Color3.fromRGB(44, 56, 32),
		[M.LeafyGrass] = Color3.fromRGB(50, 58, 32),
		[M.Mud] = Color3.fromRGB(46, 38, 30),
		[M.Ground] = Color3.fromRGB(58, 46, 34),
		[M.Rock] = Color3.fromRGB(78, 80, 82),
		[M.Slate] = Color3.fromRGB(64, 64, 66),
		[M.Sand] = Color3.fromRGB(82, 74, 58),
		[M.WoodPlanks] = Color3.fromRGB(70, 54, 40),
	} do
		terrain:SetMaterialColor(mat, color)
	end
end

---------------------------------------------------------------------------------------------
-- Costruzioni

-- Parete lungo l'asse X locale (da -length/2 a +length/2) con aperture {center, width, bottom, top}
local function wall(parent: Instance, origin: CFrame, length: number, height: number, thickness: number, openings, color: Color3, material: Enum.Material)
	local cuts = table.clone(openings)
	table.sort(cuts, function(a, b)
		return a.center < b.center
	end)
	local x = -length / 2
	local function piece(x0: number, x1: number, y0: number, y1: number)
		if x1 - x0 > 0.05 and y1 - y0 > 0.05 then
			make("Part", parent, {
				Size = Vector3.new(x1 - x0, y1 - y0, thickness),
				CFrame = origin * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, 0),
				Color = color,
				Material = material,
			})
		end
	end
	for _, o in cuts do
		local x0, x1 = o.center - o.width / 2, o.center + o.width / 2
		piece(x, x0, 0, height)
		piece(x0, x1, 0, o.bottom)
		piece(x0, x1, o.top, height)
		if o.glass then
			make("Part", parent, {
				Size = Vector3.new(o.width, o.top - o.bottom, 0.15),
				CFrame = origin * CFrame.new(o.center, (o.bottom + o.top) / 2, 0),
				Color = Color3.fromRGB(40, 50, 55),
				Material = M.Glass,
				Transparency = 0.55,
			})
			for _, y in { o.bottom, o.top } do
				make("Part", parent, {
					Size = Vector3.new(o.width + 0.4, 0.3, thickness + 0.2),
					CFrame = origin * CFrame.new(o.center, y, 0),
					Color = DARK_WOOD,
					Material = M.Wood,
				})
			end
			make("Part", parent, {
				Size = Vector3.new(0.2, o.top - o.bottom, thickness + 0.1),
				CFrame = origin * CFrame.new(o.center, (o.bottom + o.top) / 2, 0),
				Color = DARK_WOOD,
				Material = M.Wood,
			})
		end
		x = x1
	end
	piece(x, length / 2, 0, height)
end

-- Tetto a due falde centrato su origin (colmo lungo l'asse X locale)
local function gableRoof(parent: Instance, origin: CFrame, width: number, depth: number, rise: number, color: Color3, material: Enum.Material)
	local half = depth / 2
	local slope = math.sqrt(half * half + rise * rise)
	local angle = math.atan2(rise, half)
	for _, side in { -1, 1 } do
		make("Part", parent, {
			Size = Vector3.new(width, 0.5, slope + 1.2),
			CFrame = origin * CFrame.new(0, rise / 2, side * half / 2) * CFrame.Angles(side * angle, 0, 0),
			Color = color,
			Material = material,
		})
	end
	for _, end_ in { -1, 1 } do
		for _, side in { -1, 1 } do
			make("WedgePart", parent, {
				Size = Vector3.new(0.6, rise, half),
				CFrame = origin * CFrame.new(end_ * (width / 2 - 1.2), rise / 2, side * half / 2) * CFrame.Angles(0, side > 0 and math.pi or 0, 0),
				Color = color:Lerp(Color3.new(0, 0, 0), 0.2),
				Material = M.WoodPlanks,
			})
		end
	end
	make("Part", parent, {
		Size = Vector3.new(width + 0.4, 0.6, 0.6),
		CFrame = origin * CFrame.new(0, rise + 0.1, 0),
		Color = DARK_WOOD,
		Material = M.Wood,
	})
end

local function lamp(parent: Instance, cf: CFrame, range: number, brightness: number, color: Color3, flickering: boolean?): BasePart
	local bulb = make("Part", parent, {
		Name = "Lampada",
		Size = Vector3.new(0.6, 0.6, 0.6),
		Shape = Enum.PartType.Ball,
		CFrame = cf,
		Material = M.Neon,
		Color = color,
		CanCollide = false,
		CastShadow = false,
	})
	local light = make("PointLight", bulb, { Range = range, Brightness = brightness, Color = color, Shadows = true })
	if flickering then
		flicker(light)
	end
	return bulb
end

local function sign(parent: Instance, cf: CFrame, text: string, width: number?)
	local w = width or 5
	make("Part", parent, { Size = Vector3.new(0.4, 5, 0.4), CFrame = cf * CFrame.new(0, 2.5, 0), Color = DARK_WOOD, Material = M.Wood })
	local board = make("Part", parent, {
		Size = Vector3.new(w, 1.3, 0.25),
		CFrame = cf * CFrame.new(0, 4.4, 0.3),
		Color = WOOD,
		Material = M.WoodPlanks,
	})
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = make("SurfaceGui", board, { Face = face, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40 })
		make("TextLabel", gui, {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = text,
			TextScaled = true,
			Font = Enum.Font.Antique,
			TextColor3 = Color3.fromRGB(225, 210, 175),
		})
	end
end

local function buildStation(parent: Instance)
	local m = make("Model", parent, { Name = "RangerStation" })
	local base = CFrame.new(Forest.STATION)
	local W, D, H = 40, 28, 10
	local FLOOR = 2
	local wallColor = Color3.fromRGB(88, 66, 46)
	make("Part", m, {
		Name = "Fondamenta",
		Size = Vector3.new(W + 2, 4, D + 2),
		CFrame = base * CFrame.new(0, FLOOR - 2, 0),
		Color = Color3.fromRGB(70, 70, 72),
		Material = M.Cobblestone,
	})
	make("Part", m, {
		Name = "Pavimento",
		Size = Vector3.new(W, 0.4, D),
		CFrame = base * CFrame.new(0, FLOOR + 0.2, 0),
		Color = Color3.fromRGB(84, 60, 40),
		Material = M.WoodPlanks,
	})
	local f = FLOOR + 0.4
	local function window(c: number)
		return { center = c, width = 5, bottom = 3, top = 6.5, glass = true }
	end
	wall(m, base * CFrame.new(0, f, -D / 2 + 0.5), W, H, 1, { window(-10), window(10) }, wallColor, M.WoodPlanks)
	wall(m, base * CFrame.new(0, f, D / 2 - 0.5), W, H, 1, { window(-12), { center = 0, width = 6, bottom = 0, top = 8 }, window(12) }, wallColor, M.WoodPlanks)
	wall(m, base * CFrame.new(-W / 2 + 0.5, f, 0) * CFrame.Angles(0, math.pi / 2, 0), D - 2, H, 1, { window(0) }, wallColor, M.WoodPlanks)
	wall(m, base * CFrame.new(W / 2 - 0.5, f, 0) * CFrame.Angles(0, math.pi / 2, 0), D - 2, H, 1, { window(-5) }, wallColor, M.WoodPlanks)
	for _, x in { -W / 2, W / 2 } do
		for _, z in { -D / 2, D / 2 } do
			make("Part", m, {
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(H + 0.5, 1.6, 1.6),
				CFrame = base * CFrame.new(x, f + H / 2, z) * CFrame.Angles(0, 0, math.pi / 2),
				Color = DARK_WOOD,
				Material = M.Wood,
			})
		end
	end
	make("Part", m, { Size = Vector3.new(W, 0.4, D), CFrame = base * CFrame.new(0, f + H + 0.2, 0), Color = DARK_WOOD, Material = M.WoodPlanks })
	gableRoof(m, base * CFrame.new(0, f + H + 0.4, 0), W + 5, D + 5, 6, Color3.fromRGB(62, 52, 46), M.CorrodedMetal)
	local chimney = make("Part", m, {
		Size = Vector3.new(2.4, 9, 2.4),
		CFrame = base * CFrame.new(-W / 2 + 6, f + H + 4, -5),
		Color = Color3.fromRGB(80, 50, 42),
		Material = M.Brick,
	})
	make("Smoke", chimney, { Color = Color3.fromRGB(60, 60, 62), Opacity = 0.08, RiseVelocity = 4, Size = 3 })

	-- portico
	make("Part", m, { Size = Vector3.new(W, 0.4, 6), CFrame = base * CFrame.new(0, FLOOR + 0.2, D / 2 + 3), Color = Color3.fromRGB(78, 56, 38), Material = M.WoodPlanks })
	for i = 1, 3 do
		make("Part", m, {
			Size = Vector3.new(8, 0.5, 1.2),
			CFrame = base * CFrame.new(0, FLOOR - i * 0.65 + 0.15, D / 2 + 6 + i * 1.1 - 0.5),
			Color = Color3.fromRGB(70, 50, 34),
			Material = M.WoodPlanks,
		})
	end
	for _, x in { -W / 2 + 0.5, -6, 6, W / 2 - 0.5 } do
		make("Part", m, { Size = Vector3.new(0.6, 7.5, 0.6), CFrame = base * CFrame.new(x, f + 3.75, D / 2 + 5.6), Color = DARK_WOOD, Material = M.Wood })
	end
	for _, seg in { { -W / 2 + 0.5, -6 }, { 6, W / 2 - 0.5 } } do
		local cx, len = (seg[1] + seg[2]) / 2, seg[2] - seg[1]
		make("Part", m, { Size = Vector3.new(len, 0.3, 0.3), CFrame = base * CFrame.new(cx, f + 2.8, D / 2 + 5.6), Color = WOOD, Material = M.Wood })
		make("Part", m, { Size = Vector3.new(len, 0.25, 0.25), CFrame = base * CFrame.new(cx, f + 1.5, D / 2 + 5.6), Color = WOOD, Material = M.Wood })
	end
	make("Part", m, {
		Size = Vector3.new(W + 1, 0.4, 7.5),
		CFrame = base * CFrame.new(0, f + 7.9, D / 2 + 3) * CFrame.Angles(math.rad(-12), 0, 0),
		Color = Color3.fromRGB(62, 52, 46),
		Material = M.CorrodedMetal,
	})
	local porchLamp = lamp(m, base * CFrame.new(-4.5, f + 7, D / 2 + 0.2), 22, 1.4, Color3.fromRGB(255, 196, 120), true)
	porchLamp.Size = Vector3.new(0.5, 0.5, 0.5)

	-- interno
	local inside = lamp(m, base * CFrame.new(0, f + H - 1.2, -2), 34, 1.1, Color3.fromRGB(255, 205, 140), true)
	make("Part", m, { Size = Vector3.new(0.08, 1, 0.08), CFrame = inside.CFrame * CFrame.new(0, 0.8, 0), Color = Color3.new(0, 0, 0) })
	make("SpawnLocation", m, {
		Name = "Spawn",
		Size = Vector3.new(6, 0.2, 6),
		CFrame = base * CFrame.new(0, f + 0.1, 4),
		Neutral = true,
		Duration = 0,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})

	local function prompt(part: BasePart, action: string, object: string)
		return make("ProximityPrompt", part, {
			ActionText = action,
			ObjectText = object,
			HoldDuration = 0.3,
			MaxActivationDistance = 9,
			RequiresLineOfSight = false,
		})
	end

	local desk = make("Part", m, {
		Name = "SalaDiControllo",
		Size = Vector3.new(12, 0.4, 3),
		CFrame = base * CFrame.new(0, f + 3, -D / 2 + 2.6),
		Color = Color3.fromRGB(70, 52, 38),
		Material = M.Wood,
	})
	for _, x in { -5.6, 5.6 } do
		make("Part", m, { Size = Vector3.new(0.4, 3, 2.6), CFrame = base * CFrame.new(x, f + 1.5, -D / 2 + 2.6), Color = DARK_WOOD, Material = M.Wood })
	end
	for i = -1, 1 do
		local monitor = make("Part", m, {
			Size = Vector3.new(2.8, 2.2, 2),
			CFrame = base * CFrame.new(i * 3.6, f + 4.3, -D / 2 + 2.2),
			Color = Color3.fromRGB(46, 44, 40),
			Material = M.SmoothPlastic,
		})
		local screen = make("Part", m, {
			Size = Vector3.new(2.3, 1.7, 0.1),
			CFrame = monitor.CFrame * CFrame.new(0, 0, 1.02),
			Color = Color3.fromRGB(28, 70, 52),
			Material = M.Neon,
			CanCollide = false,
		})
		local gui = make("SurfaceGui", screen, { Face = Enum.NormalId.Back, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 60, LightInfluence = 0 })
		make("TextLabel", gui, {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = ("CAM %02d\nNESSUN SEGNALE"):format(i + 2),
			TextScaled = true,
			Font = Enum.Font.Code,
			TextColor3 = Color3.fromRGB(140, 255, 180),
		})
		make("PointLight", screen, { Range = 7, Brightness = 0.5, Color = Color3.fromRGB(80, 220, 150) })
		-- i client ci mostrano le anteprime delle telecamere (CamFeed)
		screen:SetAttribute("Index", i + 2)
		CollectionService:AddTag(screen, "MonitorScreen")
	end
	local board = make("Part", m, {
		Size = Vector3.new(9, 5, 0.2),
		CFrame = base * CFrame.new(-11, f + 5.5, -D / 2 + 1.1),
		Color = Color3.fromRGB(120, 100, 70),
		Material = M.Fabric,
	})
	local mapGui = make("SurfaceGui", board, { Face = Enum.NormalId.Back, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40 })
	make("TextLabel", mapGui, {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "RISERVA DI BLACKWOOD\n\nTorre (NE) · Campeggio (NO)\nLago e Palude (SO) · Miniera (SE)\n\nNON USCIRE DA SOLI DOPO IL TRAMONTO",
		TextScaled = true,
		Font = Enum.Font.SpecialElite,
		TextColor3 = Color3.fromRGB(40, 30, 20),
	})

	local crate = make("Part", m, {
		Name = "Rifornimento",
		Size = Vector3.new(4, 3, 3),
		CFrame = base * CFrame.new(-W / 2 + 3.5, f + 1.5, 2),
		Color = Color3.fromRGB(64, 76, 48),
		Material = M.WoodPlanks,
	})
	make("Part", m, { Size = Vector3.new(3, 6.5, 2), CFrame = base * CFrame.new(-W / 2 + 2.5, f + 3.25, -4), Color = Color3.fromRGB(70, 78, 72), Material = M.DiamondPlate })
	local lab = make("Part", m, {
		Name = "Laboratorio",
		Size = Vector3.new(3.5, 0.4, 9),
		CFrame = base * CFrame.new(W / 2 - 3, f + 3, 4),
		Color = Color3.fromRGB(190, 195, 198),
		Material = M.SmoothPlastic,
	})
	make("Part", m, { Size = Vector3.new(3.3, 2.8, 8.8), CFrame = base * CFrame.new(W / 2 - 3, f + 1.4, 4), Color = Color3.fromRGB(120, 124, 126), Material = M.Metal })
	for i = 1, 4 do
		make("Part", m, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.9, 0.5, 0.5),
			CFrame = base * CFrame.new(W / 2 - 3, f + 3.65, 1 + i * 1.3) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(150, 200, 190),
			Material = M.Glass,
			Transparency = 0.4,
		})
	end
	local labLight = make("Part", m, {
		Name = "LuceLaboratorio",
		Size = Vector3.new(0.5, 0.5, 0.5),
		Shape = Enum.PartType.Ball,
		CFrame = base * CFrame.new(W / 2 - 3, f + 3.6, 7.5),
		Material = M.Neon,
		Color = Color3.fromRGB(120, 200, 255),
	})
	make("PointLight", labLight, { Range = 6, Brightness = 0.8, Color = Color3.fromRGB(120, 200, 255) })
	local stove = make("Part", m, {
		Size = Vector3.new(2.5, 3, 2.5),
		CFrame = base * CFrame.new(-W / 2 + 6, f + 1.5, -5),
		Color = Color3.fromRGB(30, 30, 32),
		Material = M.Metal,
	})
	flicker(make("PointLight", stove, { Range = 9, Brightness = 1, Color = Color3.fromRGB(255, 120, 50) }))
	for _, z in { -11, -6 } do
		make("Part", m, { Size = Vector3.new(7, 1.2, 3), CFrame = base * CFrame.new(10, f + 0.9, z), Color = Color3.fromRGB(60, 70, 55), Material = M.Fabric })
	end
	local gen = make("Part", m, {
		Size = Vector3.new(4, 3, 3),
		CFrame = base * CFrame.new(W / 2 + 4, 1.5, -6),
		Color = Color3.fromRGB(90, 70, 30),
		Material = M.CorrodedMetal,
	})
	lamp(m, gen.CFrame * CFrame.new(0, 1.8, 1.4), 6, 0.6, Color3.fromRGB(255, 80, 60), true)
	sign(m, base * CFrame.new(9, 0, D / 2 + 14) * CFrame.Angles(0, math.rad(-15), 0), "RANGER STATION\nRiserva di Blackwood", 7)

	Forest.stationPrompts = {
		control = prompt(desk, "Apri il tablet", "Sala di controllo"),
		supply = prompt(crate, "Rifornisciti", "Dardi, torcia e visore"),
		lab = prompt(lab, "Analizza campioni", "Laboratorio"),
	}
	Forest.labLight = labLight
end

local function buildTower(parent: Instance, pos: Vector3)
	local m = make("Model", parent, { Name = "Torre" })
	local h = 24
	local base = CFrame.new(pos)
	for _, x in { -4, 4 } do
		for _, z in { -4, 4 } do
			make("Part", m, { Size = Vector3.new(1, h + 3, 1), CFrame = base * CFrame.new(x, (h + 3) / 2 - 2, z), Color = WOOD, Material = M.Wood })
			make("Part", m, { Size = Vector3.new(0.5, 7, 0.5), CFrame = base * CFrame.new(x, h + 4.5, z), Color = WOOD, Material = M.Wood })
		end
	end
	for y = 5, h - 2, 6 do
		for _, side in { -1, 1 } do
			make("Part", m, { Size = Vector3.new(0.4, 0.4, 9.5), CFrame = base * CFrame.new(side * 4.3, y, 0) * CFrame.Angles(0.55, 0, 0), Color = DARK_WOOD, Material = M.Wood })
			make("Part", m, { Size = Vector3.new(9.5, 0.4, 0.4), CFrame = base * CFrame.new(0, y, side * 4.3) * CFrame.Angles(0, 0, 0.55), Color = DARK_WOOD, Material = M.Wood })
		end
	end
	make("Part", m, { Size = Vector3.new(11, 0.6, 11), CFrame = base * CFrame.new(0, h + 0.3, 0), Color = WOOD, Material = M.WoodPlanks })
	for _, info in { { Vector3.new(11, 3, 0.4), Vector3.new(0, 2, -5.3) }, { Vector3.new(0.4, 3, 11), Vector3.new(-5.3, 2, 0) }, { Vector3.new(0.4, 3, 11), Vector3.new(5.3, 2, 0) } } do
		make("Part", m, { Size = info[1], CFrame = base * CFrame.new(info[2] + Vector3.new(0, h, 0)), Color = WOOD, Material = M.WoodPlanks })
	end
	gableRoof(m, base * CFrame.new(0, h + 8, 0), 12.5, 12.5, 3, Color3.fromRGB(60, 50, 44), M.CorrodedMetal)
	make("TrussPart", m, { Size = Vector3.new(2, h, 2), CFrame = base * CFrame.new(0, h / 2, 6.5), Color = DARK_WOOD })
	local lantern = lamp(m, base * CFrame.new(3.5, h + 5.5, -3.5), 14, 0.6, Color3.fromRGB(255, 160, 80), true)
	lantern.Size = Vector3.new(0.4, 0.4, 0.4)
end

local function buildCamp(parent: Instance, pos: Vector3)
	local m = make("Model", parent, { Name = "Campeggio" })
	local base = CFrame.new(pos)
	local tents = {
		{ Vector3.new(-14, 0, -8), 25, Color3.fromRGB(110, 54, 36), false },
		{ Vector3.new(10, 0, -14), -40, Color3.fromRGB(52, 70, 96), true },
		{ Vector3.new(15, 0, 9), 70, Color3.fromRGB(96, 96, 52), false },
	}
	for _, t in tents do
		local tb = base * CFrame.new(t[1]) * CFrame.Angles(0, math.rad(t[2]), 0)
		local h, len, d = 4.5, 7, 3.2
		make("WedgePart", m, { Size = Vector3.new(len, h, d), CFrame = tb * CFrame.new(0, h / 2, -d / 2), Color = t[3], Material = M.Fabric })
		if t[4] then
			make("WedgePart", m, { Size = Vector3.new(len, h * 0.5, d * 1.4), CFrame = tb * CFrame.new(0, h * 0.25, d * 0.7) * CFrame.Angles(0.25, math.pi, 0.1), Color = t[3], Material = M.Fabric })
		else
			make("WedgePart", m, { Size = Vector3.new(len, h, d), CFrame = tb * CFrame.new(0, h / 2, d / 2) * CFrame.Angles(0, math.pi, 0), Color = t[3], Material = M.Fabric })
		end
	end
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Models.mesh("Rock3", base * CFrame.new(math.cos(a) * 2.4, -0.2, math.sin(a) * 2.4) * CFrame.Angles(0, a, 0), 0.4, { CanCollide = true }, m)
	end
	local embers = make("Part", m, {
		Size = Vector3.new(2.6, 0.3, 2.6),
		CFrame = base * CFrame.new(0, 0.15, 0),
		Color = Color3.fromRGB(120, 40, 14),
		Material = M.Neon,
		CanCollide = false,
	})
	flicker(make("PointLight", embers, { Range = 14, Brightness = 1.3, Color = Color3.fromRGB(255, 110, 40), Shadows = true }))
	make("Fire", embers, { Heat = 3, Size = 2.5, Color = Color3.fromRGB(255, 120, 40), SecondaryColor = Color3.fromRGB(120, 30, 10) })
	for _, a in { 0.5, 2.6, 4.4 } do
		Models.mesh("Log1", base * CFrame.new(math.cos(a) * 6, -0.45, math.sin(a) * 6) * CFrame.Angles(0, -a + math.pi / 2, 0), 0.4, { CanCollide = true, CanQuery = true }, m)
	end
	local car = base * CFrame.new(-16, 0, 14) * CFrame.Angles(0.04, math.rad(35), 0.05)
	make("Part", m, { Size = Vector3.new(6.5, 2.2, 13), CFrame = car * CFrame.new(0, 2.2, 0), Color = Color3.fromRGB(70, 40, 32), Material = M.CorrodedMetal })
	make("Part", m, { Size = Vector3.new(6, 2, 6.5), CFrame = car * CFrame.new(0, 4.3, 0.8), Color = Color3.fromRGB(64, 38, 30), Material = M.CorrodedMetal })
	make("Part", m, { Size = Vector3.new(5.6, 1.6, 0.1), CFrame = car * CFrame.new(0, 4.3, -2.5) * CFrame.Angles(0.3, 0, 0), Color = Color3.fromRGB(30, 36, 38), Material = M.Glass, Transparency = 0.4 })
	for _, x in { -3, 3 } do
		for _, z in { -4, 4 } do
			make("Part", m, {
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1, 2.4, 2.4),
				CFrame = car * CFrame.new(x, 1.1, z),
				Color = Color3.fromRGB(20, 20, 20),
				Material = M.Fabric,
			})
		end
	end
	make("Part", m, { Size = Vector3.new(8, 0.5, 3), CFrame = base * CFrame.new(-4, 2.8, -20), Color = WOOD, Material = M.WoodPlanks })
	make("Part", m, { Size = Vector3.new(8, 0.4, 1), CFrame = base * CFrame.new(-4, 1.6, -21.7), Color = WOOD, Material = M.WoodPlanks })
	sign(m, base * CFrame.new(20, 0, -2) * CFrame.Angles(0, math.rad(80), 0.08), "CAMPEGGIO CHIUSO", 5)
end

local function buildDock(parent: Instance, pos: Vector3)
	local m = make("Model", parent, { Name = "Pontile" })
	local dir = flat(LAKE.center - pos).Unit
	local start = pos + dir * 4
	local cf = CFrame.lookAt(start, start + dir)
	local length = 26
	for i = 0, length - 1, 1.1 do
		make("Part", m, {
			Size = Vector3.new(5, 0.3, 1),
			CFrame = cf * CFrame.new(0, 0.6, -i) * CFrame.Angles(0, 0, (i * 7 % 3 - 1) * 0.02),
			Color = WOOD:Lerp(DARK_WOOD, (i * 13 % 7) / 7),
			Material = M.WoodPlanks,
		})
	end
	for i = 1, 4 do
		for _, x in { -2.4, 2.4 } do
			make("Part", m, {
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(10, 0.7, 0.7),
				CFrame = cf * CFrame.new(x, -3.5, -i * length / 4.2) * CFrame.Angles(0, 0, math.pi / 2),
				Color = DARK_WOOD,
				Material = M.Wood,
			})
		end
	end
	local boat = cf * CFrame.new(5.5, -0.7, -length + 5) * CFrame.Angles(0.06, 0.4, 0.12)
	make("Part", m, { Size = Vector3.new(3.2, 0.3, 9), CFrame = boat, Color = Color3.fromRGB(80, 60, 44), Material = M.WoodPlanks })
	for _, side in { -1, 1 } do
		make("Part", m, { Size = Vector3.new(0.3, 1.2, 9), CFrame = boat * CFrame.new(side * 1.6, 0.6, 0) * CFrame.Angles(0, 0, side * -0.3), Color = Color3.fromRGB(72, 54, 40), Material = M.WoodPlanks })
	end
	make("Part", m, { Size = Vector3.new(0.3, 3, 0.3), CFrame = cf * CFrame.new(-2.3, 2, -length + 1), Color = DARK_WOOD, Material = M.Wood })
	lamp(m, cf * CFrame.new(-2.3, 3.7, -length + 1), 12, 0.5, Color3.fromRGB(255, 170, 90), true)
end

local function effigy(parent: Instance, cf: CFrame, scale: number)
	local m = make("Model", parent, { Name = "Effigie" })
	local function stick(a: Vector3, b: Vector3, thick: number)
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		make("Part", m, {
			Size = Vector3.new(thick, thick, len),
			CFrame = cf * CFrame.lookAt(mid, b, math.abs((b - a).Unit.Y) > 0.9 and Vector3.zAxis or Vector3.yAxis),
			Color = Color3.fromRGB(70, 56, 42),
			Material = M.Wood,
			CanCollide = false,
			CanQuery = false,
		})
	end
	local s = scale
	stick(Vector3.new(0, 0, 0), Vector3.new(0, -2.6 * s, 0.05), 0.12 * s)
	stick(Vector3.new(-1.2 * s, -0.7 * s, 0), Vector3.new(1.2 * s, -0.75 * s, 0), 0.1 * s)
	stick(Vector3.new(0, -2.4 * s, 0), Vector3.new(-0.7 * s, -3.8 * s, 0.1), 0.1 * s)
	stick(Vector3.new(0, -2.4 * s, 0), Vector3.new(0.7 * s, -3.8 * s, -0.1), 0.1 * s)
	stick(Vector3.new(-0.5 * s, -0.2 * s, 0), Vector3.new(0.5 * s, -1.4 * s, 0), 0.08 * s)
	stick(Vector3.new(0.5 * s, -0.2 * s, 0), Vector3.new(-0.5 * s, -1.4 * s, 0), 0.08 * s)
	stick(Vector3.new(0, 0, 0), Vector3.new(0, 3 * s, 0), 0.04)
end

local function buildCabin(parent: Instance, pos: Vector3)
	local m = make("Model", parent, { Name = "Capanno" })
	local base = CFrame.lookAt(pos, Vector3.new(Forest.STATION.X, pos.Y, Forest.STATION.Z))
	local W, D, H = 16, 12, 8
	local color = Color3.fromRGB(62, 48, 36)
	make("Part", m, { Size = Vector3.new(W, 1, D), CFrame = base * CFrame.new(0, 0.5, 0), Color = DARK_WOOD, Material = M.WoodPlanks })
	local win = { center = -4.5, width = 3, bottom = 3, top = 5.5, glass = true }
	wall(m, base * CFrame.new(0, 1, -D / 2 + 0.4), W, H, 0.8, { { center = 2, width = 4, bottom = 0, top = 7 }, win }, color, M.WoodPlanks)
	wall(m, base * CFrame.new(0, 1, D / 2 - 0.4), W, H, 0.8, {}, color, M.WoodPlanks)
	wall(m, base * CFrame.new(-W / 2 + 0.4, 1, 0) * CFrame.Angles(0, math.pi / 2, 0), D - 1.6, H, 0.8, { { center = 0, width = 3, bottom = 3, top = 5.5, glass = true } }, color, M.WoodPlanks)
	wall(m, base * CFrame.new(W / 2 - 0.4, 1, 0) * CFrame.Angles(0, math.pi / 2, 0), D - 1.6, H, 0.8, {}, color, M.WoodPlanks)
	gableRoof(m, base * CFrame.new(0, H + 1, 0), W + 3, D + 3, 4.5, Color3.fromRGB(48, 42, 38), M.WoodPlanks)
	make("Part", m, { Size = Vector3.new(4, 7, 0.3), CFrame = base * CFrame.new(4.2, 4.5, -D / 2 - 1.2) * CFrame.Angles(0, math.rad(-60), 0), Color = Color3.fromRGB(70, 52, 38), Material = M.WoodPlanks })
	make("Part", m, { Size = Vector3.new(4, 2.6, 2.5), CFrame = base * CFrame.new(-3, 2.3, 2), Color = WOOD, Material = M.Wood })
	local candle = lamp(m, base * CFrame.new(-3, 3.9, 2), 12, 0.7, Color3.fromRGB(255, 70, 40), true)
	candle.Size = Vector3.new(0.3, 0.3, 0.3)
	effigy(m, base * CFrame.new(1.5, H + 0.5, 1), 1)
	effigy(m, base * CFrame.new(-6, H + 0.5, -1), 0.8)
end

local function buildMine(parent: Instance, pos: Vector3)
	local m = make("Model", parent, { Name = "Miniera" })
	local base = CFrame.lookAt(pos, Vector3.new(Forest.STATION.X, pos.Y, Forest.STATION.Z))
	local back = -base.LookVector
	local terrain = workspace.Terrain
	-- parete rocciosa alle spalle dell'ingresso
	terrain:FillBall(pos + back * 22 + Vector3.new(0, 4, 0), 22, M.Rock)
	terrain:FillBall(pos + back * 26 + base.RightVector * 18 + Vector3.new(0, 2, 0), 18, M.Rock)
	terrain:FillBall(pos + back * 26 - base.RightVector * 18 + Vector3.new(0, 1, 0), 17, M.Rock)
	terrain:FillBlock(base * CFrame.new(0, 5, 6), Vector3.new(7, 10, 14), M.Air)
	local function part(size: Vector3, offset: Vector3, color: Color3, material: Enum.Material?)
		return make("Part", m, { Size = size, CFrame = base * CFrame.new(offset), Color = color, Material = material or M.Wood })
	end
	for _, z in { 0, 3, 6 } do
		part(Vector3.new(1.2, 9.5, 1.2), Vector3.new(-3.6, 4.75, z), DARK_WOOD)
		part(Vector3.new(1.2, 9.5, 1.2), Vector3.new(3.6, 4.75, z), DARK_WOOD)
		part(Vector3.new(9, 1.2, 1.4), Vector3.new(0, 9.9, z), DARK_WOOD)
	end
	part(Vector3.new(7, 9.5, 0.6), Vector3.new(0, 4.75, 12), Color3.fromRGB(4, 4, 5), M.SmoothPlastic)
	for _, x in { -1.4, 1.4 } do
		part(Vector3.new(0.3, 0.3, 30), Vector3.new(x, 0.15, -8), Color3.fromRGB(60, 50, 46), M.CorrodedMetal)
	end
	for z = -22, 10, 2 do
		part(Vector3.new(4, 0.25, 0.7), Vector3.new(0, 0.05, z), DARK_WOOD)
	end
	part(Vector3.new(3.6, 2.4, 4.5), Vector3.new(0.2, 1.7, -9), Color3.fromRGB(70, 60, 50), M.CorrodedMetal)
	local l = lamp(m, base * CFrame.new(3.2, 8, -0.8), 16, 0.8, Color3.fromRGB(255, 150, 70), true)
	l.Size = Vector3.new(0.4, 0.4, 0.4)
	sign(m, base * CFrame.new(-6, 0, -4) * CFrame.Angles(0, math.rad(20), 0.1), "PERICOLO\nMINIERA CHIUSA", 5)
	for i = 1, 4 do
		local a = i * 1.3
		Models.mesh("Boulder1", base * CFrame.new(math.cos(a) * 14, -1.5, -math.abs(math.sin(a)) * 6 + 2) * CFrame.Angles(0, a, 0), 0.5 + i * 0.08, { CanCollide = true, CanQuery = true }, m)
	end
end

local function buildSignposts(parent: Instance)
	local m = make("Model", parent, { Name = "Cartelli" })
	for i = 2, #POIS do
		local poi = POIS[i]
		local dir = flat(poi.pos - Forest.STATION).Unit
		local side = Vector3.new(dir.Z, 0, -dir.X)
		local p = Forest.STATION + dir * (MAP.STATION_RADIUS + 14) + side * 6
		local ground = Forest.groundAt(p.X, p.Z)
		sign(m, CFrame.lookAt(ground, ground + side), poi.name .. "  →", 6)
	end
end

local function buildBounds(parent: Instance)
	local m = make("Model", parent, { Name = "Confini" })
	local h = 300
	for _, info in {
		{ Vector3.new(SIZE + 20, h, 2), Vector3.new(0, 0, HALF + 1) },
		{ Vector3.new(SIZE + 20, h, 2), Vector3.new(0, 0, -HALF - 1) },
		{ Vector3.new(2, h, SIZE + 20), Vector3.new(HALF + 1, 0, 0) },
		{ Vector3.new(2, h, SIZE + 20), Vector3.new(-HALF - 1, 0, 0) },
	} do
		make("Part", m, { Size = info[1], CFrame = CFrame.new(info[2]), Transparency = 1, CanQuery = false })
	end
end

function Forest.build(world: Instance)
	Models.load()
	local props = make("Folder", world, { Name = "Mappa" })
	buildTerrain()
	buildStation(props)
	buildTower(props, POIS[2].pos)
	buildCamp(props, POIS[3].pos)
	buildDock(props, POIS[4].pos)
	buildCabin(props, POIS[5].pos)
	buildMine(props, POIS[6].pos)
	buildSignposts(props)
	buildBounds(props)
	Forest.vegetation = make("Folder", world, { Name = "Vegetazione" })
end

---------------------------------------------------------------------------------------------
-- Vegetazione (rigenerata a ogni notte)

local TREES = {
	-- nome mesh, raggio del tronco, peso per bioma {pineta, campeggio, palude, miniera}
	{ "Pine1", 1.2, { 3, 2, 0.3, 1.5 } },
	{ "Pine2", 1.35, { 3, 1.5, 0.3, 1.5 } },
	{ "Pine3", 1.0, { 2, 2, 0.4, 1 } },
	{ "Pine4", 1.5, { 2.5, 1, 0.2, 1 } },
	{ "Snag1", 1.1, { 0.6, 0.6, 1.2, 1 } },
	{ "Dead1", 0.9, { 0.2, 0.3, 3, 0.4 } },
	{ "Dead2", 0.9, { 0.1, 0.3, 3, 0.4 } },
	{ "Dead3", 0.9, { 0.1, 0.3, 3, 0.4 } },
	{ "Broad1", 0.8, { 0, 3, 0.2, 0 } },
	{ "Broad2", 0.8, { 0, 3, 0.2, 0 } },
}
local BIOME_INDEX = { ["Pineta fitta"] = 1, ["Ruderi del campeggio"] = 2, Palude = 3, Miniera = 4 }
local DENSITY = { 1, 0.65, 0.6, 0.45 }

local function pickTree(rng: Random, biome: number)
	local total = 0
	for _, t in TREES do
		total += t[3][biome]
	end
	local roll = rng:NextNumber(0, total)
	for _, t in TREES do
		roll -= t[3][biome]
		if roll <= 0 then
			return t
		end
	end
	return TREES[1]
end

local function plant(rng: Random, folder: Instance, tree, ground: Vector3)
	local name = tree[1]
	local scale = rng:NextNumber(0.8, 1.25)
	local cf = CFrame.new(ground) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0) * CFrame.Angles(rng:NextNumber(-0.04, 0.04), 0, rng:NextNumber(-0.04, 0.04))
	local visual = { CanCollide = false, CanQuery = false, CastShadow = true }
	local trunkName = Models.info(name .. "_Trunk") and name .. "_Trunk" or name
	local info = Models.info(trunkName)
	Models.mesh(trunkName, cf, scale, visual, folder)
	for _, suffix in { "_Foliage", "_Leaves" } do
		if Models.info(name .. suffix) then
			Models.mesh(name .. suffix, cf, scale, visual, folder)
		end
	end
	-- collisione semplice sul tronco (per giocatori, creatura e linee di vista)
	local height = math.min(info and info.size.Y * 0.55 or 12, 22) * scale
	local d = tree[2] * 2 * scale
	make("Part", folder, {
		Name = "Tronco",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, d, d),
		CFrame = CFrame.new(ground + Vector3.new(0, height / 2 - 1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Transparency = 1,
		CastShadow = false,
	})
end

local function scatter(rng: Random, count: number, accept: (Vector3, string) -> boolean, place: (Vector3, string) -> ())
	local placed, attempts = 0, 0
	while placed < count and attempts < count * 12 do
		attempts += 1
		local x, z = rng:NextNumber(-HALF + 12, HALF - 12), rng:NextNumber(-HALF + 12, HALF - 12)
		local p = Forest.groundAt(x, z)
		local biome = Forest.biomeAt(p)
		if accept(p, biome) then
			place(p, biome)
			placed += 1
		end
		if attempts % 80 == 0 then
			task.wait()
		end
	end
end

function Forest.regenerate(rng: Random)
	local folder = Forest.vegetation
	folder:ClearAllChildren()
	local V = Config.VEGETATION
	local function dryFlat(p: Vector3, maxSlope: number, margin: number): boolean
		return Forest.isDry(p) and Forest.slopeAt(p.X, p.Z) < maxSlope and Forest.isOpenGround(p, margin) and not Forest.inLake(p, 6)
	end

	scatter(rng, V.TREES, function(p, biome)
		return rng:NextNumber() <= DENSITY[BIOME_INDEX[biome]] and dryFlat(p, 0.95, 4)
	end, function(p, biome)
		plant(rng, folder, pickTree(rng, BIOME_INDEX[biome]), p - Vector3.new(0, 0.3, 0))
	end)

	local cover = { CanCollide = false, CanQuery = false, CastShadow = false }
	local solid = { CanCollide = true, CanQuery = true, CastShadow = true }
	local function spin(p: Vector3): CFrame
		return CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	end
	scatter(rng, V.BUSHES, function(p, biome)
		return biome ~= "Palude" and dryFlat(p, 0.9, 1)
	end, function(p)
		Models.mesh("Bush" .. rng:NextInteger(1, 3), spin(p - Vector3.new(0, 0.4, 0)), rng:NextNumber(0.7, 1.4), cover, folder)
	end)
	scatter(rng, V.FERNS, function(p, biome)
		return biome ~= "Miniera" and dryFlat(p, 0.9, 0.5)
	end, function(p)
		Models.mesh("Fern" .. rng:NextInteger(1, 2), spin(p - Vector3.new(0, 0.1, 0)), rng:NextNumber(0.8, 1.5), cover, folder)
	end)
	scatter(rng, V.REEDS, function(p)
		local w = Forest.waterAt(p.X, p.Z)
		return p.Y > w - 1.2 and p.Y < w + 1.0 and Forest.isOpenGround(p, 0)
	end, function(p)
		Models.mesh("Reeds1", spin(Vector3.new(p.X, math.max(p.Y, Forest.waterAt(p.X, p.Z) - 1) - 0.2, p.Z)), rng:NextNumber(0.8, 1.4), cover, folder)
	end)
	scatter(rng, V.ROCKS, function(p, biome)
		return (biome == "Miniera" or rng:NextNumber() < 0.5) and Forest.isDry(p) and Forest.isOpenGround(p, 1)
	end, function(p)
		Models.mesh("Rock" .. rng:NextInteger(1, 3), spin(p - Vector3.new(0, 0.6, 0)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), 0, 0), rng:NextNumber(0.6, 1.8), solid, folder)
	end)
	scatter(rng, V.BOULDERS, function(p, biome)
		return (biome == "Miniera" or biome == "Pineta fitta") and Forest.slopeAt(p.X, p.Z) > 0.35 and Forest.isOpenGround(p, 8)
	end, function(p)
		Models.mesh("Boulder1", spin(p - Vector3.new(0, 2.5, 0)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), 0, rng:NextNumber(-0.2, 0.2)), rng:NextNumber(0.6, 1.3), solid, folder)
	end)
	scatter(rng, V.LOGS, function(p)
		return dryFlat(p, 0.4, 5)
	end, function(p)
		Models.mesh("Log1", spin(p - Vector3.new(0, 0.5, 0)), rng:NextNumber(0.7, 1.1), solid, folder)
	end)
	scatter(rng, V.STUMPS, function(p)
		return dryFlat(p, 0.6, 2)
	end, function(p)
		Models.mesh("Stump1", spin(p - Vector3.new(0, 0.3, 0)), rng:NextNumber(0.7, 1.2), solid, folder)
	end)
	scatter(rng, V.MUSHROOMS, function(p, biome)
		return (biome == "Palude" or biome == "Ruderi del campeggio") and dryFlat(p, 0.6, 1)
	end, function(p)
		Models.mesh("Mushrooms1", spin(p - Vector3.new(0, 0.05, 0)), rng:NextNumber(0.8, 1.6), cover, folder)
	end)
	scatter(rng, V.EFFIGIES, function(p, biome)
		return (biome == "Palude" or biome == "Ruderi del campeggio" or rng:NextNumber() < 0.3) and dryFlat(p, 0.5, 6)
	end, function(p)
		-- figura di rami appesa a un palo storto
		make("Part", folder, {
			Size = Vector3.new(0.5, 10, 0.5),
			CFrame = CFrame.new(p + Vector3.new(0, 4.5, 0)) * CFrame.Angles(rng:NextNumber(-0.1, 0.1), 0, rng:NextNumber(-0.1, 0.1)),
			Color = DARK_WOOD,
			Material = M.Wood,
		})
		local yaw = rng:NextNumber(0, math.pi * 2)
		make("Part", folder, {
			Size = Vector3.new(0.35, 0.35, 3.5),
			CFrame = CFrame.new(p + Vector3.new(0, 9, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -1.4),
			Color = DARK_WOOD,
			Material = M.Wood,
		})
		effigy(folder, CFrame.new(p + Vector3.new(0, 8.6, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -2.6), rng:NextNumber(0.8, 1.2))
	end)
end

return Forest
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Game</string><ProtectedString name="Source"><![CDATA[-- The Rake: Caccia nei Boschi — ciclo della partita.
-- Attesa -> Briefing (alla Ranger Station) -> Notte (caccia) -> Debriefing (XP e ranghi).
-- Avviato da init.server.luau; i test lo richiamano direttamente.
return function()
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Lighting = game:GetService("Lighting")

	local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
	local Forest = require(script.Parent.Forest)
	local Rake = require(script.Parent.Rake)
	local Cameras = require(script.Parent.Cameras)
	local Evidence = require(script.Parent.Evidence)
	local Team = require(script.Parent.Team)
	local Objectives = require(script.Parent.Objectives)
	local Progression = require(script.Parent.Progression)

	Players.CharacterAutoLoads = false

	-- Stato condiviso letto dai client (attributi)
	local state = Instance.new("Folder")
	state.Name = "RakeState"
	state.Parent = ReplicatedStorage

	local remotes = Instance.new("Folder")
	remotes.Name = "RakeRemotes"
	for _, name in { "Notify", "Debrief", "OpenTablet", "FireDart", "CycleCameraType", "RotateCamera", "DartFx" } do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = remotes
	end
	remotes.Parent = ReplicatedStorage

	local world = Instance.new("Folder")
	world.Name = "RakeHunt"
	world.Parent = workspace

	local rng = Random.new()

	local ctx = {
		state = state,
		remotes = remotes,
		world = world,
		round = { active = false, captured = false },
		stats = {},
		weather = Config.WEATHER[1],
		aggressionMultiplier = 1,
		nightProgress = 0,
		forest = Forest,
		rake = Rake,
		cameras = Cameras,
		evidence = Evidence,
		team = Team,
		objectives = Objectives,
	}

	function ctx.notify(text: string, player: Player)
		remotes.Notify:FireClient(player, text)
	end

	function ctx.notifyAll(text: string)
		remotes.Notify:FireAllClients(text)
	end

	function ctx.isNight(): boolean
		return Lighting.ClockTime >= 19.5 or Lighting.ClockTime < 6
	end

	function ctx.credit(userId: number?, field: string)
		local s = userId and ctx.stats[userId]
		if s then
			s[field] = (s[field] or 0) + 1
		end
	end

	local revealed = { zone = false, area = false, exact = false }
	local nextAreaUpdate, nextPulse = 0, 0
	local areaMarker: BasePart? = nil

	function ctx.setLastSeen(pos: Vector3)
		state:SetAttribute("LastSeenX", pos.X)
		state:SetAttribute("LastSeenZ", pos.Z)
		state:SetAttribute("LastSeenTime", workspace:GetServerTimeNow())
	end

	function ctx.addTracking(amount: number)
		if not ctx.round.active then
			return
		end
		local t = math.clamp((state:GetAttribute("Tracking") or 0) + amount, 0, 100)
		state:SetAttribute("Tracking", t)
		local R = Config.EVIDENCE.REVEAL
		if t >= R.ZONE and not revealed.zone then
			revealed.zone = true
			local zone = Forest.biomeAt(ctx.round.lair)
			state:SetAttribute("ZoneHint", zone)
			ctx.notifyAll(("🗺 Tracciamento %d%%: la tana della creatura è nella zona \"%s\"."):format(R.ZONE, zone))
		end
		if t >= R.AREA and not revealed.area then
			revealed.area = true
			nextAreaUpdate = 0
			ctx.notifyAll(("🗺 Tracciamento %d%%: l'area di caccia è segnata in rosso sulla mappa e nel bosco."):format(R.AREA))
		end
		if t >= R.EXACT and not revealed.exact then
			revealed.exact = true
			nextPulse = 0
			ctx.notifyAll("🎯 Tracciamento completo: la posizione della creatura viene rivelata a intervalli!")
		end
	end

	function ctx.onCapture(player: Player)
		ctx.round.captured = true
		ctx.credit(player.UserId, "capture")
		ctx.notifyAll(("🏆 %s ha catturato The Rake!"):format(player.DisplayName))
	end

	for _, module in { Rake, Cameras, Evidence, Team, Objectives } do
		module.init(ctx)
	end

	---------------------------------------------------------------------------------------------
	-- Mappa e luci

	Forest.build(world)
	Forest.regenerate(rng)

	local prompts = Forest.stationPrompts
	prompts.control.Triggered:Connect(function(player)
		remotes.OpenTablet:FireClient(player)
	end)
	prompts.supply.Triggered:Connect(function(player)
		Team.supply(player)
	end)
	prompts.lab.Triggered:Connect(function(player)
		Evidence.analyze(player)
	end)

	remotes.FireDart.OnServerEvent:Connect(function(player, targetPos)
		Team.fireDart(player, targetPos)
	end)
	remotes.CycleCameraType.OnServerEvent:Connect(function(player)
		Team.cycleCamType(player)
	end)
	remotes.RotateCamera.OnServerEvent:Connect(function(player, id, dir)
		Cameras.rotate(player, id, dir)
	end)

	-- Illuminazione notturna: atmosfera densa, luna fredda, colori desaturati. Le ombre dinamiche di
	-- torce e lampade dipendono da Lighting.Technology = Future (impostato nel file del luogo).
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(6, 7, 10)
	Lighting.OutdoorAmbient = Color3.fromRGB(18, 20, 28)
	Lighting.EnvironmentDiffuseScale = 0.25
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.ShadowSoftness = 0.25
	Lighting.ExposureCompensation = 0

	local function effect(className: string, props: { [string]: any })
		local existing = Lighting:FindFirstChildOfClass(className)
		if existing then
			existing:Destroy()
		end
		return Forest.make(className, Lighting, props)
	end

	local atmosphere = effect("Atmosphere", {
		Density = 0.4,
		Offset = 0.2,
		Color = Color3.fromRGB(70, 80, 96),
		Decay = Color3.fromRGB(34, 40, 52),
		Glare = 0,
		Haze = 2.2,
	})
	effect("Sky", {
		StarCount = 3000,
		MoonAngularSize = 12,
		SunAngularSize = 14,
		CelestialBodiesShown = true,
	})
	effect("ColorCorrectionEffect", {
		Name = "Notte",
		Brightness = -0.02,
		Contrast = 0.16,
		Saturation = -0.32,
		TintColor = Color3.fromRGB(205, 218, 238),
	})
	effect("BloomEffect", { Intensity = 0.7, Size = 28, Threshold = 1.6 })
	effect("DepthOfFieldEffect", { FarIntensity = 0.22, FocusDistance = 25, InFocusRadius = 45, NearIntensity = 0 })
	effect("SunRaysEffect", { Intensity = 0.04, Spread = 0.6 })

	local function setDusk()
		Lighting.ClockTime = 18.6
		Lighting.Brightness = 1.6
		atmosphere.Density = 0.3
	end

	local function applyNight(progress: number)
		local hour = Config.NIGHT_START_HOUR + progress * Config.NIGHT_HOURS
		Lighting.ClockTime = hour % 24
		-- Verso l'alba la luce torna e la nebbia si dirada
		local dawn = math.clamp((progress - 0.88) / 0.12, 0, 1)
		Lighting.Brightness = 0.9 + dawn * 1.2
		atmosphere.Density = ctx.weather.density * (1 - dawn * 0.4)
	end

	setDusk()

	---------------------------------------------------------------------------------------------
	-- Giocatori

	local function setPhase(name: string)
		state:SetAttribute("Phase", name)
	end

	local function newStats(player: Player)
		ctx.stats[player.UserId] = { name = player.DisplayName, evidence = 0, sightings = 0, revives = 0, capture = 0 }
	end

	local function onPlayerAdded(player: Player)
		player.CameraMaxZoomDistance = 14
		player.CameraMinZoomDistance = 0.5
		player.CharacterAdded:Connect(function(char)
			Team.watchCharacter(player, char)
		end)
		Progression.load(player)
		local phase = state:GetAttribute("Phase")
		if phase == "Briefing" or phase == "Notte" then
			-- Chi entra a partita in corso si unisce alla squadra alla stazione
			newStats(player)
			Team.spawn(player, true)
			ctx.notifyAll(("%s si è unito alla spedizione."):format(player.DisplayName))
		else
			Team.spawn(player, false)
		end
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		Objectives.onDowned(player)
		Progression.release(player)
	end)

	---------------------------------------------------------------------------------------------
	-- Ciclo della partita

	local function countdown(seconds: number)
		for t = seconds, 1, -1 do
			state:SetAttribute("TimeLeft", t)
			task.wait(1)
		end
		state:SetAttribute("TimeLeft", 0)
	end

	local function chooseWeather()
		local total = 0
		for _, w in Config.WEATHER do
			total += w.weight
		end
		local roll = rng:NextNumber(0, total)
		for _, w in Config.WEATHER do
			roll -= w.weight
			if roll <= 0 then
				return w
			end
		end
		return Config.WEATHER[1]
	end

	local function resetState()
		for name, value in {
			Tracking = 0,
			Evidence = 0,
			Coverage = 0,
			CamerasActive = 0,
			ZoneHint = "",
			HintX = 0,
			HintZ = 0,
			HintR = 0,
			LastSeenTime = 0,
			RakeState = "Assente",
			ObjectiveProgress = "",
		} do
			state:SetAttribute(name, value)
		end
		revealed = { zone = false, area = false, exact = false }
		if areaMarker then
			areaMarker:Destroy()
			areaMarker = nil
		end
	end

	local function updateReveal()
		local now = os.clock()
		local pos = Rake.position()
		if not pos then
			return
		end
		if revealed.area and now >= nextAreaUpdate then
			nextAreaUpdate = now + 20
			local center = Forest.randomGround(rng, pos, 0, 35)
			local radius = 70
			state:SetAttribute("HintX", center.X)
			state:SetAttribute("HintZ", center.Z)
			state:SetAttribute("HintR", radius)
			if not areaMarker then
				-- colonna di luce rossa visibile sopra gli alberi
				areaMarker = Forest.make("Part", world, {
					Name = "AreaDiCaccia",
					Shape = Enum.PartType.Cylinder,
					Material = Enum.Material.Neon,
					Color = Color3.fromRGB(255, 40, 30),
					Transparency = 0.55,
					CanCollide = false,
					CanQuery = false,
					CastShadow = false,
					Size = Vector3.new(220, 2.5, 2.5),
				})
				Forest.make("PointLight", areaMarker, { Range = 40, Brightness = 2, Color = Color3.fromRGB(255, 40, 30) })
			end
			local marker = areaMarker :: BasePart
			marker.CFrame = CFrame.new(center + Vector3.new(0, 105, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		end
		if revealed.exact and now >= nextPulse then
			nextPulse = now + 30
			Rake.setRevealed(true)
			ctx.setLastSeen(pos)
			task.delay(8, function()
				Rake.setRevealed(false)
			end)
		end
	end

	local function runNight(): (string, string)
		-- La tana è in un punto di interesse a caso (mai la stazione)
		local poi = Forest.POIS[rng:NextInteger(2, #Forest.POIS)]
		local lair = Forest.randomGround(rng, poi.pos, 50, 110)
		ctx.round.lair = lair
		ctx.round.active = true
		Rake.spawn(lair)
		Evidence.seed(lair)
		setPhase("Notte")
		ctx.notifyAll("🌲 Cala la notte. Qualcosa si muove tra gli alberi…")

		local start = os.clock()
		local last = start
		while true do
			task.wait(0.25)
			local now = os.clock()
			local dt = now - last
			last = now
			local progress = math.clamp((now - start) / Config.NIGHT_DURATION, 0, 1)
			ctx.nightProgress = progress
			applyNight(progress)
			state:SetAttribute("TimeLeft", math.max(0, math.ceil(Config.NIGHT_DURATION - (now - start))))

			Team.tick(dt)
			Cameras.tick(dt)
			updateReveal()
			state:SetAttribute("ObjectiveProgress", Objectives.progressText())

			local result, reason = Objectives.check()
			if result then
				return result, reason :: string
			end
			if #Players:GetPlayers() == 0 then
				return "lose", "La squadra ha abbandonato il bosco."
			end
			if not Team.anyStanding() then
				return "lose", "Tutta la squadra è stata abbattuta."
			end
			if progress >= 1 then
				return Objectives.onDawn()
			end
		end
	end

	local function debrief(result: string, reason: string)
		ctx.round.active = false
		setPhase("Debriefing")
		Rake.despawn()
		state:SetAttribute("RakeState", "Assente")
		local XP = Config.XP
		local won = result == "win"
		ctx.notifyAll((won and "✅ " or "❌ ") .. reason)

		for _, player in Players:GetPlayers() do
			local s = ctx.stats[player.UserId]
			if s then
				local survived = player:GetAttribute("Status") == "OK"
				local breakdown = {
					{ "Prove raccolte", s.evidence * XP.EVIDENCE },
					{ "Telecamere utili", s.sightings * XP.CAMERA_SIGHTING },
					{ "Rianimazioni", s.revives * XP.REVIVE },
					{ "Cattura", s.capture * XP.CAPTURE },
					{ "Sopravvivenza", survived and XP.SURVIVE or 0 },
					{ "Obiettivo", won and XP.WIN or 0 },
				}
				local xp = 0
				for _, row in breakdown do
					xp += row[2]
				end
				if not won then
					xp = math.floor(xp * XP.LOSS_MULTIPLIER)
				end
				Progression.award(player, xp, {
					Runs = 1,
					Wins = won and 1 or 0,
					Captures = s.capture,
					Evidence = s.evidence,
					Revives = s.revives,
				})
				local profile = Progression.get(player)
				local total = profile and profile.XP or xp
				local rank, nextXp = Progression.rankFor(total)
				remotes.Debrief:FireClient(player, {
					won = won,
					reason = reason,
					objective = Objectives.current(),
					xp = xp,
					halved = not won,
					breakdown = breakdown,
					totalXP = total,
					rank = rank,
					nextXP = nextXp,
					level = Progression.levelFor(total),
				})
			end
		end
		countdown(Config.DEBRIEF)
	end

	while true do
		-- Attesa
		setPhase("Attesa")
		setDusk()
		resetState()
		while #Players:GetPlayers() < Config.MIN_PLAYERS do
			state:SetAttribute("TimeLeft", 0)
			task.wait(1)
		end

		-- Briefing: nuova foresta, meteo e obiettivo; tutti alla Ranger Station con l'attrezzatura
		setPhase("Briefing")
		ctx.round = { active = false, captured = false }
		ctx.stats = {}
		Rake.despawn()
		Cameras.reset()
		Evidence.reset()
		Objectives.cleanup()
		Forest.regenerate(rng)
		ctx.weather = chooseWeather()
		state:SetAttribute("Weather", ctx.weather.name)
		Objectives.start(rng)
		for _, player in Players:GetPlayers() do
			newStats(player)
			task.spawn(Team.spawn, player, true)
		end
		countdown(Config.BRIEFING)

		local result, reason = runNight()
		debrief(result, reason)

		-- Pulizia e ritorno alla lobby
		Objectives.cleanup()
		Cameras.reset()
		Evidence.reset()
		resetState()
		for _, player in Players:GetPlayers() do
			task.spawn(Team.spawn, player, false)
		end
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Objectives</string><ProtectedString name="Source"><![CDATA[-- Obiettivi di partita: Ricognizione, Caccia, Sopravvivenza, Reperto.
-- La cattura della creatura vale come vittoria con qualsiasi obiettivo.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Forest = require(script.Parent.Forest)

local make = Forest.make

local Objectives = {}

local LIST = { "Ricognizione", "Caccia", "Sopravvivenza", "Reperto" }

local ctx
local current = "Caccia"
local tape: Model? = nil
local tapePoi = ""

local function tapeCarrier(): Player?
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("CarryingTape") then
			return player
		end
	end
	return nil
end

local function setCarrierHighlight(player: Player, on: boolean)
	local char = player.Character
	if not char then
		return
	end
	local existing = char:FindFirstChild("NastroHighlight")
	if on and not existing then
		make("Highlight", char, {
			Name = "NastroHighlight",
			FillTransparency = 1,
			OutlineColor = Color3.fromRGB(255, 70, 70),
		})
	elseif not on and existing then
		existing:Destroy()
	end
end

local function spawnTape(pos: Vector3)
	if tape then
		tape:Destroy()
	end
	local m = Instance.new("Model")
	m.Name = "NastroAudio"
	local part = make("Part", m, {
		Name = "Nastro",
		Size = Vector3.new(1.2, 0.35, 0.8),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.4, 0)),
		Color = Color3.fromRGB(20, 20, 20),
		Material = Enum.Material.SmoothPlastic,
	})
	make("Part", m, {
		Size = Vector3.new(0.8, 0.05, 0.5),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.6, 0)),
		Color = Color3.fromRGB(200, 40, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	make("PointLight", part, { Range = 7, Brightness = 0.8, Color = Color3.fromRGB(255, 60, 60) })
	local prompt = make("ProximityPrompt", part, {
		ActionText = "Prendi",
		ObjectText = "Nastro audio",
		HoldDuration = 1,
		MaxActivationDistance = 9,
		RequiresLineOfSight = false,
	})
	prompt.Triggered:Connect(function(player)
		if not ctx.round.active or not ctx.team.isStanding(player) or tape ~= m then
			return
		end
		m:Destroy()
		tape = nil
		player:SetAttribute("CarryingTape", true)
		setCarrierHighlight(player, true)
		ctx.notifyAll(("📼 %s ha il nastro audio! Riportatelo alla Ranger Station."):format(player.DisplayName))
	end)
	m.Parent = ctx.world
	tape = m
end

function Objectives.init(c)
	ctx = c
end

function Objectives.start(rng: Random)
	current = Config.FORCED_OBJECTIVE or LIST[rng:NextInteger(1, #LIST)]
	ctx.aggressionMultiplier = current == "Sopravvivenza" and 1.5 or 1
	local text
	if current == "Ricognizione" then
		text = ("Piazza %d telecamere attive e documenta %d prove."):format(Config.RECON_CAMERAS, Config.RECON_EVIDENCE)
	elseif current == "Caccia" then
		text = "Trova The Rake, stordiscilo con i dardi tranquillanti e catturalo."
	elseif current == "Sopravvivenza" then
		text = "Resta vivo fino all'alba. Stanotte la creatura è più aggressiva."
	else
		local poi = Forest.POIS[rng:NextInteger(2, #Forest.POIS)]
		tapePoi = poi.name
		-- Sul lato del punto di interesse rivolto verso la stazione (mai dentro rocce o acqua)
		local toStation = (Forest.STATION - poi.pos) * Vector3.new(1, 0, 1)
		local side = Vector3.new(-toStation.Z, 0, toStation.X).Unit
		local sign = rng:NextNumber() < 0.5 and -1 or 1
		local spot = poi.pos + toStation.Unit * rng:NextNumber(10, 14) + side * sign * rng:NextNumber(3.5, 6)
		spawnTape(Forest.groundAt(spot.X, spot.Z))
		text = ("Recupera il nastro audio (%s) e riportalo alla Ranger Station."):format(tapePoi)
	end
	ctx.state:SetAttribute("Objective", current)
	ctx.state:SetAttribute("ObjectiveText", text)
end

function Objectives.current(): string
	return current
end

function Objectives.progressText(): string
	local s = ctx.state
	if current == "Ricognizione" then
		return ("Camere attive %d/%d · Prove %d/%d"):format(
			s:GetAttribute("CamerasActive") or 0,
			Config.RECON_CAMERAS,
			s:GetAttribute("Evidence") or 0,
			Config.RECON_EVIDENCE
		)
	elseif current == "Caccia" then
		return ("Tracciamento %d%%"):format(math.floor(s:GetAttribute("Tracking") or 0))
	elseif current == "Sopravvivenza" then
		return "Resisti fino alle 06:00"
	end
	local carrier = tapeCarrier()
	return carrier and ("Il nastro è in mano a %s"):format(carrier.DisplayName) or ("Il nastro è %s"):format(tape and "nel bosco" or "perso")
end

-- Restituisce "win" e una descrizione quando l'obiettivo è completato
function Objectives.check(): (string?, string?)
	if ctx.round.captured then
		return "win", "The Rake è stato catturato!"
	end
	local s = ctx.state
	if current == "Ricognizione" then
		if (s:GetAttribute("CamerasActive") or 0) >= Config.RECON_CAMERAS and (s:GetAttribute("Evidence") or 0) >= Config.RECON_EVIDENCE then
			return "win", "Ricognizione completata: il bosco è sotto sorveglianza."
		end
	elseif current == "Reperto" then
		local carrier = tapeCarrier()
		if carrier and ctx.team.isStanding(carrier) then
			local hrp = carrier.Character and carrier.Character:FindFirstChild("HumanoidRootPart")
			if hrp and Forest.inStation(hrp.Position) then
				return "win", ("%s ha riportato il nastro alla Ranger Station."):format(carrier.DisplayName)
			end
		end
	end
	return nil, nil
end

function Objectives.onDawn(): (string, string)
	if current == "Sopravvivenza" then
		return "win", "È l'alba: la squadra è sopravvissuta alla notte."
	end
	return "lose", "È sorta l'alba prima che completaste l'obiettivo."
end

-- Chi porta il nastro e viene colpito lo lascia cadere
function Objectives.onDowned(player: Player)
	if not player:GetAttribute("CarryingTape") then
		return
	end
	player:SetAttribute("CarryingTape", false)
	setCarrierHighlight(player, false)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if hrp and ctx.round.active then
		spawnTape(Forest.groundAt(hrp.Position.X, hrp.Position.Z))
		ctx.notifyAll("📼 Il nastro è caduto a terra!")
	end
end

function Objectives.cleanup()
	if tape then
		tape:Destroy()
		tape = nil
	end
	for _, player in Players:GetPlayers() do
		player:SetAttribute("CarryingTape", false)
		setCarrierHighlight(player, false)
	end
end

return Objectives
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[-- Progressione persistente (DataStore): XP, livello e rango "Criptidologo".
-- In Studio serve "Enable Studio Access to API Services", altrimenti i dati restano solo in memoria.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Progression = {}

local DEFAULT = { XP = 0, Runs = 0, Wins = 0, Captures = 0, Evidence = 0, Revives = 0 }

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("RakeHunt_Profili_v1")
	end)
	if ok then
		store = result
	end
end

local profiles: { [Player]: { [string]: number } } = {}

local function key(player: Player): string
	return "p_" .. player.UserId
end

function Progression.rankFor(xp: number): (string, number?)
	local name, nextXp = Config.RANKS[1].name, nil
	for i, rank in Config.RANKS do
		if xp >= rank.xp then
			name = rank.name
			nextXp = Config.RANKS[i + 1] and Config.RANKS[i + 1].xp or nil
		end
	end
	return name, nextXp
end

function Progression.levelFor(xp: number): number
	return math.floor(math.sqrt(xp / 40)) + 1
end

local function refresh(player: Player)
	local data = profiles[player]
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	local rank = Progression.rankFor(data.XP)
	;(stats:FindFirstChild("Rango") :: StringValue).Value = rank
	;(stats:FindFirstChild("Livello") :: IntValue).Value = Progression.levelFor(data.XP)
	player:SetAttribute("XP", data.XP)
end

function Progression.load(player: Player)
	local data = table.clone(DEFAULT)
	if store then
		local ok, saved = pcall(function()
			return (store :: DataStore):GetAsync(key(player))
		end)
		if ok and type(saved) == "table" then
			for k, v in saved do
				data[k] = v
			end
		elseif not ok then
			warn("[Progressione] Caricamento fallito per " .. player.Name .. ": " .. tostring(saved))
		end
	end
	profiles[player] = data

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local rank = Instance.new("StringValue")
	rank.Name = "Rango"
	rank.Parent = stats
	local level = Instance.new("IntValue")
	level.Name = "Livello"
	level.Parent = stats
	stats.Parent = player
	refresh(player)
end

function Progression.get(player: Player)
	return profiles[player]
end

function Progression.save(player: Player)
	local data = profiles[player]
	if not store or not data then
		return
	end
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync(key(player), data)
	end)
	if not ok then
		warn("[Progressione] Salvataggio fallito per " .. player.Name .. ": " .. tostring(err))
	end
end

function Progression.award(player: Player, xp: number, counters: { [string]: number })
	local data = profiles[player]
	if not data then
		return
	end
	data.XP += xp
	for k, v in counters do
		data[k] = (data[k] or 0) + v
	end
	refresh(player)
	task.spawn(Progression.save, player)
end

function Progression.release(player: Player)
	Progression.save(player)
	profiles[player] = nil
end

game:BindToClose(function()
	for _, player in Players:GetPlayers() do
		Progression.save(player)
	end
end)

return Progression
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Rake</string><ProtectedString name="Source"><![CDATA[-- The Rake: creatura controllata dal server. Comportamento elusivo "colpisci e scappa":
--   Vaga      → gira intorno alla tana finché non trova qualcuno
--   Pedina    → segue il bersaglio alle spalle, fuori dalla sua vista, nascosto dietro gli alberi
--   Mostra    → compare davanti al bersaglio, resta immobile a fissarlo, poi sparisce
--   Carica    → scatta (più veloce di chi corre) verso dove il bersaglio sta andando, colpisce
--   Finta     → carica e si ferma a pochi metri urlando, poi scappa
--   Attacco   → resta sopra la vittima un istante (jumpscare), poi fugge
--   Fuga      → corre lontano, fuori vista, e torna a pedinare
-- Teme la luce diretta, sente spari e corse, scappa quando viene colpito da un dardo.
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local RakeRig = require(Shared:WaitForChild("RakeRig"))
local Sfx = require(Shared:WaitForChild("Sfx"))
local Forest = require(script.Parent.Forest)

local R = Config.RAKE

local Rake = {}
Rake.model = nil :: Model?

local ctx
local rng = Random.new()
local hum: Humanoid, root: BasePart, head: BasePart
local highlight: Highlight, capturePrompt: ProximityPrompt
local footsteps: Sound?, callSound: Sound?, screechSound: Sound?, jawSound: Sound?, growlSound: Sound?
local brain: { [string]: any } = {}
local revealed = false
local loopToken = nil

-- Stato pubblicato per HUD e animazione dei client
local MODE_STATE = {
	Vaga = "Inattiva",
	Pedina = "Curiosa",
	Mostra = "Territoriale",
	Carica = "Aggressiva",
	Finta = "Aggressiva",
	Attacco = "Attacco",
	Fuga = "Fuga",
}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function range(pair: { number }): number
	return rng:NextNumber(pair[1], pair[2])
end

local function setState(name: string)
	if brain.state ~= name then
		brain.state = name
		ctx.state:SetAttribute("RakeState", name)
	end
end

local function setMode(mode: string, duration: number?)
	brain.mode = mode
	brain.modeStart = os.clock()
	brain.modeUntil = duration and os.clock() + duration or math.huge
	brain.goal = nil
	brain.seenTime = 0
	brain.standing = false
	if hum then
		hum.AutoRotate = true
	end
	setState(MODE_STATE[mode] or "Inattiva")
end

local function playSound(s: Sound?)
	if s then
		s:Play()
	end
end

---------------------------------------------------------------------------------------------
-- Modello

local function build(pos: Vector3): Model
	local m = Instance.new("Model")
	m.Name = "TheRake"
	local rig = RakeRig.build(m, CFrame.new(pos + Vector3.new(0, RakeRig.ROOT_HEIGHT, 0)))
	root = rig.root
	head = rig.head

	hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = RakeRig.HIP_HEIGHT
	hum.MaxHealth = 1e6
	hum.Health = 1e6
	hum.WalkSpeed = R.WALK_SPEED
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.AutoJumpEnabled = false
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.Parent = m

	highlight = Instance.new("Highlight")
	highlight.Enabled = false
	highlight.FillTransparency = 0.7
	highlight.FillColor = Color3.fromRGB(255, 60, 60)
	highlight.OutlineColor = Color3.fromRGB(255, 80, 80)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = m

	capturePrompt = Instance.new("ProximityPrompt")
	capturePrompt.ActionText = "Cattura"
	capturePrompt.ObjectText = "The Rake (stordito)"
	capturePrompt.HoldDuration = R.CAPTURE_TIME
	capturePrompt.MaxActivationDistance = 12
	capturePrompt.RequiresLineOfSight = false
	capturePrompt.Enabled = false
	capturePrompt.Parent = root

	footsteps = Sfx.new("Steps", root, { Volume = 1.2, RollOffMaxDistance = 110, PlaybackSpeed = 0.8 })
	callSound = Sfx.new("Call", head, { Volume = 2.2, RollOffMinDistance = 12, RollOffMaxDistance = 320 })
	screechSound = Sfx.new("Screech", head, { Volume = 2.5, RollOffMinDistance = 10, RollOffMaxDistance = 220 })
	jawSound = Sfx.new("JawClicks", head, { Volume = 1.8, RollOffMinDistance = 6, RollOffMaxDistance = 90 })
	growlSound = Sfx.new("Growl", head, { Volume = 2, RollOffMinDistance = 8, RollOffMaxDistance = 130 })
	return m
end

---------------------------------------------------------------------------------------------
-- Movimento

local function computePath(dest: Vector3)
	local path = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 7, AgentCanJump = false, WaypointSpacing = 6 })
	local ok = pcall(function()
		path:ComputeAsync(root.Position, dest)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		brain.path = path:GetWaypoints()
		brain.pathIndex = 2
	else
		brain.path = nil
	end
	brain.pathGoal = dest
	brain.pathTime = os.clock()
end

local function moveTo(dest: Vector3, speed: number, direct: boolean?)
	hum.WalkSpeed = speed
	if direct then
		brain.path = nil
		hum:MoveTo(dest)
		return
	end
	local refresh = speed >= R.CHASE_SPEED and 1 or 2
	if not brain.pathGoal or flat(brain.pathGoal - dest).Magnitude > 8 or os.clock() - brain.pathTime > refresh then
		computePath(dest)
	end
	local waypoints = brain.path
	if waypoints and waypoints[brain.pathIndex] then
		local wp = waypoints[brain.pathIndex].Position
		if flat(wp - root.Position).Magnitude < 4 then
			brain.pathIndex += 1
			local nextWp = waypoints[brain.pathIndex]
			if nextWp then
				hum:MoveTo(nextWp.Position)
			end
		else
			hum:MoveTo(wp)
		end
	else
		hum:MoveTo(dest)
	end
end

local function stop()
	hum.WalkSpeed = 0
	hum:MoveTo(root.Position)
end

local function face(pos: Vector3)
	hum.AutoRotate = false
	local look = flat(pos - root.Position)
	if look.Magnitude > 0.5 then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
	end
end

local function avoidStation(goal: Vector3): Vector3
	if Forest.inStation(goal, 12) then
		local away = flat(goal - Forest.STATION)
		if away.Magnitude < 1 then
			away = Vector3.new(1, 0, 0)
		end
		local p = Forest.STATION + away.Unit * (Config.MAP.STATION_RADIUS + 18)
		return Forest.groundAt(p.X, p.Z)
	end
	return goal
end

---------------------------------------------------------------------------------------------
-- Percezione

local function rayClear(from: Vector3, to: Vector3, ignore: { Instance }): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(from, to - from, params)
	return result == nil or (Rake.model ~= nil and result.Instance:IsDescendantOf(Rake.model)) or (result.Position - to).Magnitude < 2
end

function Rake.visibleFrom(origin: Vector3, ignore: { Instance }): boolean
	if not Rake.model then
		return false
	end
	for _, target in { head.Position, root.Position } do
		if rayClear(origin, target, ignore) then
			return true
		end
	end
	return false
end

function Rake.position(): Vector3?
	if Rake.model and root and root.Parent then
		return root.Position
	end
	return nil
end

-- Il giocatore vede il punto? (cono di 60 gradi davanti al personaggio e linea di vista)
local function sees(s, pos: Vector3): boolean
	if not s.head then
		return false
	end
	local to = pos - s.head.Position
	local d = to.Magnitude
	if d > 90 or d < 0.1 then
		return d < 0.1
	end
	local look = flat(s.root.CFrame.LookVector)
	if look.Magnitude < 0.1 or math.deg(math.acos(math.clamp(look.Unit:Dot(flat(to).Unit), -1, 1))) > 60 then
		return false
	end
	return rayClear(s.head.Position, pos, { s.char, ctx.cameras.folder() })
end

local function seenByAnyone(survivors, pos: Vector3): boolean
	for _, s in survivors do
		if sees(s, pos) then
			return true
		end
	end
	return false
end

-- Punto a distanza [rmin, rmax] dal bersaglio, dietro le sue spalle e nascosto a tutti
local function hiddenSpot(survivors, target, rmin: number, rmax: number, spread: number): Vector3
	local back = -flat(target.root.CFrame.LookVector)
	if back.Magnitude < 0.1 then
		back = Vector3.new(0, 0, 1)
	end
	local fallback
	for _ = 1, 14 do
		local dir = CFrame.Angles(0, rng:NextNumber(-spread, spread), 0) * back.Unit
		local p = avoidStation(Forest.clampToMap(target.root.Position + dir * rng:NextNumber(rmin, rmax)))
		if Forest.isDry(p) then
			fallback = fallback or p
			if not seenByAnyone(survivors, p + Vector3.new(0, 4, 0)) then
				return p
			end
		end
	end
	return fallback or Forest.randomGround(rng, target.root.Position, rmin, rmax)
end

-- Punto davanti al bersaglio, nel suo campo visivo e con la vista libera
local function revealSpot(target): Vector3?
	local look = flat(target.root.CFrame.LookVector)
	if look.Magnitude < 0.1 then
		return nil
	end
	for _ = 1, 12 do
		local dir = CFrame.Angles(0, rng:NextNumber(-0.45, 0.45), 0) * look.Unit
		local p = avoidStation(Forest.clampToMap(target.root.Position + dir * rng:NextNumber(22, 32)))
		if Forest.isDry(p) and target.head and rayClear(target.head.Position, p + Vector3.new(0, 5, 0), { target.char }) then
			return p
		end
	end
	return nil
end

local function pickTarget(survivors)
	local best, bestScore = nil, -math.huge
	for _, s in survivors do
		local iso = 150
		for _, other in survivors do
			if other ~= s then
				iso = math.min(iso, (other.root.Position - s.root.Position).Magnitude)
			end
		end
		local d = (s.root.Position - root.Position).Magnitude
		local score = iso * 0.8 - d * 0.5
		if s.player:GetAttribute("CarryingTape") then
			score += 60
		end
		if Forest.inStation(s.root.Position) then
			score -= 150
		end
		if brain.target == s.player then
			score += 25 -- non cambia bersaglio di continuo
		end
		s.isolation = iso
		if score > bestScore then
			best, bestScore = s, score
		end
	end
	return best
end

---------------------------------------------------------------------------------------------
-- Reazioni

local function flee(from: Vector3, duration: number)
	setMode("Fuga", duration)
	brain.fleeFrom = from
	brain.nextAction = os.clock() + duration + rng:NextNumber(4, 9)
end

local function updateLight(dt: number, survivors)
	local exposedBy = nil
	for _, s in survivors do
		if s.player:GetAttribute("TorchOn") and s.head then
			local toRake = root.Position - s.head.Position
			local d = toRake.Magnitude
			if d < R.LIGHT_RANGE and d > 0.1 then
				local angle = math.deg(math.acos(math.clamp(s.root.CFrame.LookVector:Dot(toRake.Unit), -1, 1)))
				if angle < R.LIGHT_ANGLE and Rake.visibleFrom(s.head.Position, { s.char }) then
					exposedBy = s
					break
				end
			end
		end
	end
	if exposedBy then
		brain.light += dt
		if brain.light >= R.LIGHT_TO_FLEE then
			brain.light = 0
			brain.aggression = math.max(0, brain.aggression - 8)
			playSound(screechSound)
			flee(exposedBy.root.Position, range(R.FLEE_TIME))
			ctx.notify("🔦 La luce l'ha respinto! Ma tornerà…", exposedBy.player)
		end
	else
		brain.light = math.max(0, brain.light - dt * 0.5)
	end
end

-- Rumori (spari, corse, laboratorio): la attirano verso la fonte
function Rake.hearNoise(pos: Vector3, loudness: number)
	if not Rake.model or brain.knockedUntil > 0 or brain.captured then
		return
	end
	local d = (pos - root.Position).Magnitude
	if d > 260 * loudness then
		return
	end
	brain.aggression = math.min(100, brain.aggression + 6 * loudness)
	brain.noise = pos
	brain.noiseTime = os.clock()
end

local function knockout()
	brain.knockedUntil = os.clock() + R.KNOCKOUT_TIME
	stop()
	hum.PlatformStand = true
	capturePrompt.Enabled = true
	highlight.FillColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.Enabled = true
	if footsteps then
		footsteps:Stop()
	end
	setState("Stordita")
	ctx.notifyAll(("💤 The Rake è a terra! Catturalo (tieni premuto E) entro %d secondi."):format(R.KNOCKOUT_TIME))
end

local function wake()
	brain.knockedUntil = 0
	brain.sedation = 1
	brain.aggression = 90
	hum.PlatformStand = false
	hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	capturePrompt.Enabled = false
	highlight.FillColor = Color3.fromRGB(255, 60, 60)
	highlight.OutlineColor = Color3.fromRGB(255, 80, 80)
	highlight.Enabled = revealed
	ctx.notifyAll("⚠ The Rake si è risvegliato… ed è furioso!")
	playSound(screechSound)
	flee(root.Position, 6)
end

function Rake.hitByDart(player: Player)
	if not Rake.model or brain.knockedUntil > 0 or brain.captured then
		return
	end
	brain.sedation += 1
	if brain.sedation >= R.DARTS_TO_KNOCKOUT then
		knockout()
	else
		brain.aggression = math.min(100, brain.aggression + 10)
		ctx.notify(("🎯 Dardo a segno! Sedazione %d/%d"):format(math.floor(brain.sedation), R.DARTS_TO_KNOCKOUT), player)
		-- colpito: scappa subito
		local shooter = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		flee(shooter and shooter.Position or root.Position, range(R.FLEE_TIME))
	end
end

function Rake.addAggression(amount: number)
	if brain.aggression then
		brain.aggression = math.clamp(brain.aggression + amount, 0, 100)
	end
end

function Rake.setRevealed(on: boolean)
	revealed = on
	if highlight and brain.knockedUntil == 0 then
		highlight.Enabled = on
	end
end

---------------------------------------------------------------------------------------------
-- Cervello

local function chooseAction(now: number, target)
	local p = brain.aggression / 100
	local interval = R.ACTION_INTERVAL[1] + (R.ACTION_INTERVAL[2] - R.ACTION_INTERVAL[1]) * p
	brain.nextAction = now + interval + rng:NextNumber(0, 4)
	local roll = rng:NextNumber()
	if roll < 0.45 - p * 0.3 then
		local spot = revealSpot(target)
		if spot then
			brain.revealSpot = spot
			setMode("Mostra", 9)
			return
		end
	end
	if roll < 0.7 - p * 0.25 then
		setMode("Finta", R.CHARGE_TIMEOUT)
	else
		setMode("Carica", R.CHARGE_TIMEOUT)
	end
	playSound(growlSound)
end

local function step(dt: number)
	local now = os.clock()
	local b = brain
	if b.captured then
		return
	end
	if b.knockedUntil > 0 then
		if now < b.knockedUntil then
			return
		end
		wake()
	end

	local survivors = ctx.team.standing()
	if b.mode ~= "Attacco" then
		updateLight(dt, survivors)
	end
	b.sedation = math.max(0, b.sedation - R.SEDATION_DECAY * dt)

	-- aggressività: tempo, rumore, giocatori isolati
	local gain = R.AGGRESSION_PER_SECOND * (1 + ctx.nightProgress * 1.5) * ctx.aggressionMultiplier
	local target = pickTarget(survivors)
	for _, s in survivors do
		local d = (s.root.Position - root.Position).Magnitude
		if d < 160 and s.root.AssemblyLinearVelocity.Magnitude > Config.PLAYER.WALK_SPEED + 3 then
			gain += 0.3
		end
		if s.isolation and s.isolation > 60 then
			gain += 0.2
		end
	end
	b.aggression = math.clamp(b.aggression + gain * dt, 0, 100)
	b.target = target and target.player

	if now >= b.modeUntil then
		if b.mode == "Attacco" then
			flee(root.Position, range(R.FLEE_TIME))
		elseif b.mode == "Mostra" or b.mode == "Carica" or b.mode == "Finta" then
			flee(target and target.root.Position or root.Position, range({ 5, 8 }))
		else
			setMode(target and "Pedina" or "Vaga")
		end
	end
	if not target and b.mode ~= "Fuga" and b.mode ~= "Vaga" then
		setMode("Vaga")
	end

	local mode = b.mode
	local reached = b.goal and flat(b.goal - root.Position).Magnitude < 5
	if mode == "Vaga" then
		if target then
			setMode("Pedina")
		else
			if not b.goal or reached or now - (b.goalTime or 0) > 25 then
				b.goal = avoidStation(Forest.randomGround(rng, b.lair, 0, 120))
				b.goalTime = now
			end
			moveTo(b.goal, R.WALK_SPEED)
		end
	elseif mode == "Pedina" then
		local t = target.root.Position
		local d = flat(t - root.Position).Magnitude
		-- lontano e invisibile: si riposiziona alle spalle del bersaglio
		if d > 150 and not seenByAnyone(survivors, root.Position + Vector3.new(0, 3, 0)) then
			local spot = hiddenSpot(survivors, target, 60, 80, 1.2)
			root.CFrame = CFrame.new(spot + Vector3.new(0, RakeRig.ROOT_HEIGHT, 0))
			b.goal = nil
			b.pathGoal = nil
		end
		-- se si accorge di essere visto: di solito sparisce, a volte attacca
		if sees(target, root.Position + Vector3.new(0, 3, 0)) then
			b.seenTime += dt
			if b.seenTime > 0.7 then
				if rng:NextNumber() < 0.65 - b.aggression / 300 then
					flee(t, range({ 5, 9 }))
				else
					setMode("Carica", R.CHARGE_TIMEOUT)
					playSound(screechSound)
				end
				return
			end
		else
			b.seenTime = 0
		end
		if b.noise and now - (b.noiseTime or 0) < 6 then
			b.goal = avoidStation(Forest.clampToMap(b.noise + Vector3.new(rng:NextNumber(-15, 15), 0, rng:NextNumber(-15, 15))))
			b.goalTime = now
			b.noise = nil
		elseif not b.goal or reached or now - (b.goalTime or 0) > 4 then
			b.goal = hiddenSpot(survivors, target, 32, 50, 0.9)
			b.goalTime = now
		end
		moveTo(b.goal, d > 90 and R.CHASE_SPEED or R.STALK_SPEED)
		if now >= (b.nextAction or 0) and d < 110 then
			chooseAction(now, target)
		end
	elseif mode == "Mostra" then
		local t = target.root.Position
		local d = flat(t - root.Position).Magnitude
		if not b.standing then
			local spot = b.revealSpot or t
			if flat(spot - root.Position).Magnitude < 4 or now - b.modeStart > 5 then
				b.standing = true
				b.modeUntil = now + range(R.REVEAL_TIME)
				stop()
				playSound(rng:NextNumber() < 0.5 and jawSound or growlSound)
			else
				moveTo(spot, R.CHASE_SPEED)
			end
		else
			stop()
			face(t)
			if d < 14 then
				setMode("Carica", R.CHARGE_TIMEOUT)
				playSound(screechSound)
			end
		end
	elseif mode == "Carica" or mode == "Finta" then
		local vel = target.root.AssemblyLinearVelocity
		local predicted = target.root.Position + Vector3.new(vel.X, 0, vel.Z) * 0.45
		local d = (target.root.Position - root.Position).Magnitude
		local direct = d < 35 and rayClear(root.Position + Vector3.new(0, 2, 0), target.root.Position, { target.char })
		moveTo(predicted, R.CHASE_SPEED, direct)
		if mode == "Finta" and d < 11 then
			playSound(screechSound)
			flee(target.root.Position, range({ 6, 10 }))
		elseif d < R.ATTACK_RANGE then
			b.lastAttack = now
			playSound(screechSound)
			ctx.team.down(target.player)
			b.aggression = 45
			setMode("Attacco", R.ATTACK_PAUSE)
			stop()
			face(target.root.Position)
		end
	elseif mode == "Attacco" then
		stop()
	elseif mode == "Fuga" then
		if not b.goal or reached then
			local from = b.fleeFrom or root.Position
			local away = flat(root.Position - from)
			if away.Magnitude < 1 then
				away = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
			end
			b.goal = avoidStation(Forest.clampToMap(root.Position + (CFrame.Angles(0, rng:NextNumber(-0.6, 0.6), 0) * away.Unit) * rng:NextNumber(90, 140)))
		end
		moveTo(b.goal, R.CHASE_SPEED)
	end

	-- tracce e versi
	if mode ~= "Fuga" and mode ~= "Carica" and now - b.lastDrop > Config.EVIDENCE.DROP_INTERVAL then
		b.lastDrop = now
		ctx.evidence.dropNear(root.Position)
	end
	if (mode == "Pedina" or mode == "Vaga") and now > b.nextCall then
		b.nextCall = now + rng:NextNumber(18, 40)
		local roll = rng:NextNumber()
		if roll < 0.3 then
			Sfx.at("Call", Forest.randomGround(rng, root.Position, 80, 140) + Vector3.new(0, 5, 0), { Volume = 2.2, RollOffMinDistance = 12, RollOffMaxDistance = 320 })
		elseif roll < 0.55 then
			playSound(callSound)
		elseif roll < 0.8 then
			playSound(jawSound)
		else
			playSound(growlSound)
		end
	end

	if footsteps then
		local moving = root.AssemblyLinearVelocity.Magnitude > 2
		if moving and not footsteps.IsPlaying then
			footsteps:Play()
		elseif not moving and footsteps.IsPlaying then
			footsteps:Stop()
		end
		footsteps.PlaybackSpeed = hum.WalkSpeed >= R.CHASE_SPEED and 1.4 or 0.8
	end
end

---------------------------------------------------------------------------------------------

function Rake.init(c)
	ctx = c
end

function Rake.spawn(lair: Vector3)
	Rake.despawn()
	local now = os.clock()
	brain = {
		state = "",
		mode = "Vaga",
		modeStart = now,
		modeUntil = math.huge,
		aggression = 15,
		sedation = 0,
		light = 0,
		knockedUntil = 0,
		lastAttack = 0,
		nextAction = now + 25,
		goal = nil,
		goalTime = 0,
		lair = lair,
		lastDrop = now,
		nextCall = now + 20,
		captured = false,
		seenTime = 0,
		path = nil,
		pathIndex = 0,
		pathGoal = nil,
		pathTime = 0,
	}
	revealed = false
	local m = build(lair)
	m.Parent = ctx.world
	root:SetNetworkOwner(nil)
	Rake.model = m
	setMode("Vaga")

	capturePrompt.Triggered:Connect(function(player)
		if brain.knockedUntil > 0 and not brain.captured and ctx.team.isStanding(player) then
			brain.captured = true
			capturePrompt.Enabled = false
			root.Anchored = true
			setState("Catturata")
			ctx.onCapture(player)
		end
	end)

	local token = {}
	loopToken = token
	task.spawn(function()
		local last = os.clock()
		while loopToken == token and m.Parent do
			task.wait(0.15)
			local now = os.clock()
			local ok, err = pcall(step, now - last)
			if not ok then
				warn("[TheRake] " .. tostring(err))
			end
			last = now
		end
	end)
end

function Rake.despawn()
	loopToken = nil
	if Rake.model then
		Rake.model:Destroy()
		Rake.model = nil
	end
end

return Rake
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Team</string><ProtectedString name="Source"><![CDATA[-- La squadra: spawn, attrezzatura (torcia, telecamere, fucile a dardi), stato "Braccato" e rianimazione.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(Shared:WaitForChild("Models"))
local Sfx = require(Shared:WaitForChild("Sfx"))
local Forest = require(script.Parent.Forest)

local EQ = Config.EQUIPMENT
local P = Config.PLAYER
local make = Forest.make

local Team = {}

local ctx
local downedToken: { [Player]: any } = {}
local lastDart: { [Player]: number } = {}

-- Stati del giocatore (attributo "Status"): Lobby, OK, Braccato, Fuori

function Team.isStanding(player: Player): boolean
	return player:GetAttribute("Status") == "OK"
end

function Team.isDowned(player: Player): boolean
	return player:GetAttribute("Status") == "Braccato"
end

-- Giocatori in piedi durante la notte, con le parti del personaggio già risolte
function Team.standing()
	local list = {}
	for _, player in Players:GetPlayers() do
		if Team.isStanding(player) then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				table.insert(list, { player = player, char = char, root = hrp, head = char:FindFirstChild("Head") })
			end
		end
	end
	return list
end

function Team.anyStanding(): boolean
	return #Team.standing() > 0
end

local function torchLight(player: Player): SpotLight?
	local char = player.Character
	local tool = char and char:FindFirstChild("Torcia")
	local lens = tool and tool:FindFirstChild("Lente")
	return lens and lens:FindFirstChild("TorchLight") :: SpotLight?
end

function Team.setTorch(player: Player, on: boolean)
	if on and (player:GetAttribute("TorchBattery") or 0) <= 0 then
		ctx.notify("🔦 Torcia scarica: ricaricala al Rifornimento della Ranger Station.", player)
		on = false
	end
	if on and not Team.isStanding(player) then
		on = false
	end
	if player:GetAttribute("TorchOn") ~= on then
		local char = player.Character
		local head = char and char:FindFirstChild("Head")
		if head then
			Sfx.at("TorchClick", head.Position, { Volume = 0.6, RollOffMaxDistance = 30 })
		end
	end
	player:SetAttribute("TorchOn", on)
	local light = torchLight(player)
	if light then
		light.Enabled = on
		local lens = light.Parent :: BasePart
		lens.Material = on and Enum.Material.Neon or Enum.Material.Glass
		local glow = lens:FindFirstChild("Alone") :: PointLight?
		if glow then
			glow.Enabled = on
		end
	end
end

-- Attrezzo con impugnatura invisibile e modello 3D saldato (il fronte del modello punta in avanti)
local function newTool(name: string, tip: string, mesh: string, scale: number, offset: CFrame?): (Tool, BasePart)
	local tool = Instance.new("Tool")
	tool.Name = name
	tool.ToolTip = tip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 0.3)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.Massless = true
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	local visual = Models.mesh(mesh, (offset or CFrame.new()), scale, {
		Name = "Modello",
		Anchored = false,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Massless = true,
	}, tool)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = visual
	weld.Parent = handle
	return tool, handle
end

local function attachPart(tool: Tool, handle: BasePart, props: { [string]: any }): BasePart
	local part = make("Part", nil, props)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = part
	weld.Parent = part
	return part
end

function Team.equip(player: Player)
	local char = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not char or not backpack then
		return
	end
	for _, container in { backpack, char } do
		for _, item in container:GetChildren() do
			if item:IsA("Tool") then
				item:Destroy()
			end
		end
	end

	player:SetAttribute("Darts", EQ.DARTS)
	player:SetAttribute("TorchBattery", EQ.TORCH_BATTERY)
	player:SetAttribute("TorchOn", false)
	player:SetAttribute("Samples", 0)
	player:SetAttribute("SamplePoints", 0)
	player:SetAttribute("CarryingTape", false)
	player:SetAttribute("CamType", "Fissa")
	for camType, count in EQ.CAMERA_KITS do
		player:SetAttribute("Kits_" .. camType, count)
	end
	player:SetAttribute("SupplyTick", os.clock())
	Team.buildTools(player, backpack)
end

-- Crea gli attrezzi nello zaino (separato da equip per poterlo provare senza un giocatore vero)
function Team.buildTools(player: Player, backpack: Instance)
	-- Torcia: la luce esce dalla lente e segue il braccio
	local torch, torchHandle = newTool("Torcia", "Clic: accendi/spegni la torcia", "Tool_Torch", 0.95)
	local lens = attachPart(torch, torchHandle, {
		Name = "Lente",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.05, 0.5, 0.5),
		CFrame = CFrame.new(0, 0, -0.83) * CFrame.Angles(0, math.pi / 2, 0),
		Color = Color3.fromRGB(255, 244, 220),
		Material = Enum.Material.Glass,
	})
	local beam = make("SpotLight", lens, {
		Name = "TorchLight",
		Face = Enum.NormalId.Right,
		Angle = 50,
		Range = 60,
		Brightness = 7,
		Shadows = true,
		Color = Color3.fromRGB(255, 238, 205),
		Enabled = false,
	})
	Forest.flicker(beam)
	make("PointLight", lens, { Name = "Alone", Range = 5, Brightness = 0.6, Color = Color3.fromRGB(255, 230, 200), Enabled = false })
	torch.Activated:Connect(function()
		Team.setTorch(player, not player:GetAttribute("TorchOn"))
	end)
	torch.Unequipped:Connect(function()
		Team.setTorch(player, false)
	end)
	torch.Parent = backpack

	local camera, cameraHandle = newTool("Telecamera", "Clic: piazza una telecamera · R: cambia tipo", "Cam_Body", 0.55, CFrame.new(0, 0.1, -0.2))
	attachPart(camera, cameraHandle, {
		Name = "Led",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.06, 0.06, 0.06),
		CFrame = CFrame.new(0.2, 0.27, -0.6),
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.Neon,
	})
	camera.Activated:Connect(function()
		ctx.cameras.place(player)
	end)
	camera.Parent = backpack

	local gun, gunHandle = newTool("Fucile a dardi", "Clic: spara un dardo tranquillante", "Tool_Rifle", 0.8)
	attachPart(gun, gunHandle, {
		Name = "Volata",
		Size = Vector3.new(0.1, 0.1, 0.1),
		CFrame = CFrame.new(0, 0.12, -2.15),
		Transparency = 1,
	})
	gun.Parent = backpack

	local tablet, tabletHandle = newTool("Tablet", "Clic (o T): guarda le telecamere", "Tool_Tablet", 1, CFrame.new(0, 0.3, -0.6) * CFrame.Angles(math.rad(-65), 0, 0))
	local screen = attachPart(tablet, tabletHandle, {
		Name = "Schermo",
		Size = Vector3.new(1.35, 0.85, 0.02),
		CFrame = CFrame.new(0, 0.3, -0.6) * CFrame.Angles(math.rad(-65), 0, 0) * CFrame.new(0, 0, -0.07),
		Color = Color3.fromRGB(30, 80, 60),
		Material = Enum.Material.Neon,
	})
	make("PointLight", screen, { Range = 5, Brightness = 0.5, Color = Color3.fromRGB(90, 220, 160) })
	tablet.Parent = backpack
end

function Team.spawn(player: Player, equip: boolean)
	if not player.Parent then
		return
	end
	downedToken[player] = nil
	player:SetAttribute("Status", equip and "OK" or "Lobby")
	player:SetAttribute("TorchOn", false)
	player:SetAttribute("CarryingTape", false)
	player:LoadCharacter()
	if equip then
		Team.equip(player)
	end
end

function Team.cycleCamType(player: Player)
	local types = Config.CAMERAS.TYPES
	local current = table.find(types, player:GetAttribute("CamType")) or 1
	for i = 1, #types do
		local candidate = types[(current + i - 1) % #types + 1]
		if (player:GetAttribute("Kits_" .. candidate) or 0) > 0 then
			player:SetAttribute("CamType", candidate)
			return
		end
	end
end

function Team.supply(player: Player)
	if not ctx.round.active or not Team.isStanding(player) then
		ctx.notify("Il rifornimento è disponibile durante la notte.", player)
		return
	end
	player:SetAttribute("Darts", EQ.DARTS)
	player:SetAttribute("TorchBattery", EQ.TORCH_BATTERY)
	player:SetAttribute("SupplyTick", os.clock())
	ctx.notify("🎒 Rifornimento completato: dardi, torcia e visore notturno carichi.", player)
end

function Team.fireDart(player: Player, targetPos: any)
	if typeof(targetPos) ~= "Vector3" or not ctx.round.active or not Team.isStanding(player) then
		return
	end
	local char = player.Character
	local gun = char and char:FindFirstChild("Fucile a dardi")
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not gun or not head then
		return
	end
	local now = os.clock()
	if now - (lastDart[player] or 0) < EQ.DART_COOLDOWN then
		return
	end
	local ammo = player:GetAttribute("Darts") or 0
	if ammo <= 0 then
		ctx.notify("Dardi finiti: torna al Rifornimento.", player)
		return
	end
	lastDart[player] = now
	player:SetAttribute("Darts", ammo - 1)

	local dir = targetPos - head.Position
	if dir.Magnitude < 0.1 then
		return
	end
	dir = dir.Unit * EQ.DART_RANGE
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, ctx.cameras.folder() }
	local result = workspace:Raycast(head.Position, dir, params)
	local hitPos = result and result.Position or head.Position + dir
	local muzzle = gun:FindFirstChild("Volata") :: BasePart?
	local from = muzzle and muzzle.Position or head.Position

	local rake = ctx.rake.model
	local hitRake = result ~= nil and rake ~= nil and result.Instance:IsDescendantOf(rake)
	local kind = "none"
	if hitRake then
		kind = "rake"
	elseif result then
		kind = result.Instance == workspace.Terrain and "terrain" or "wood"
	end
	-- effetti (fiammata, dardo in volo, impatto, rinculo) disegnati dai client
	ctx.remotes.DartFx:FireAllClients(player, from, hitPos, kind, result and result.Normal or Vector3.yAxis, result and result.Instance or nil)
	ctx.rake.hearNoise(from, 1)
	if hitRake then
		local travel = (hitPos - from).Magnitude / EQ.DART_SPEED
		task.delay(travel, function()
			Sfx.at("HitFlesh", hitPos, { Volume = 2, RollOffMaxDistance = 160 })
			ctx.rake.hitByDart(player)
		end)
	end
end

local function clearRevivePrompt(player: Player)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local prompt = hrp and hrp:FindFirstChild("RevivePrompt")
	if prompt then
		prompt:Destroy()
	end
end

function Team.eliminate(player: Player)
	downedToken[player] = nil
	player:SetAttribute("Status", "Fuori")
	clearRevivePrompt(player)
	ctx.objectives.onDowned(player)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then
		hum.Health = 0
	end
	ctx.notifyAll(("💀 %s non ce l'ha fatta."):format(player.DisplayName))
end

function Team.revive(player: Player, reviver: Player)
	if not Team.isDowned(player) then
		return
	end
	downedToken[player] = nil
	clearRevivePrompt(player)
	player:SetAttribute("Status", "OK")
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
		hum.WalkSpeed = P.WALK_SPEED
		hum.JumpPower = 50
		hum.JumpHeight = 7.2
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	ctx.credit(reviver.UserId, "revives")
	ctx.notifyAll(("❤ %s ha rianimato %s!"):format(reviver.DisplayName, player.DisplayName))
end

function Team.down(player: Player)
	if not Team.isStanding(player) then
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then
		return
	end
	player:SetAttribute("Status", "Braccato")
	Team.setTorch(player, false)
	hum:UnequipTools()
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.JumpHeight = 0
	hum.PlatformStand = true
	ctx.objectives.onDowned(player)

	local token = {}
	downedToken[player] = token
	player:SetAttribute("DownedUntil", workspace:GetServerTimeNow() + P.DOWNED_TIME)
	local prompt = make("ProximityPrompt", hrp, {
		Name = "RevivePrompt",
		ActionText = "Rianima",
		ObjectText = player.DisplayName,
		HoldDuration = P.REVIVE_TIME,
		MaxActivationDistance = 9,
		RequiresLineOfSight = false,
	})
	prompt.Triggered:Connect(function(reviver)
		if reviver ~= player and Team.isStanding(reviver) then
			Team.revive(player, reviver)
		end
	end)
	ctx.notifyAll(("⚠ %s è stato colpito! Rianimalo entro %d secondi."):format(player.DisplayName, P.DOWNED_TIME))

	task.delay(P.DOWNED_TIME, function()
		if downedToken[player] == token and Team.isDowned(player) then
			Team.eliminate(player)
		end
	end)
end

function Team.tick(dt: number)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("TorchOn") then
			local battery = math.max(0, (player:GetAttribute("TorchBattery") or 0) - dt)
			player:SetAttribute("TorchBattery", battery)
			if battery <= 0 then
				Team.setTorch(player, false)
				ctx.notify("🔦 La torcia si è scaricata.", player)
			end
		end
	end
end

function Team.init(c)
	ctx = c
	Players.PlayerRemoving:Connect(function(player)
		downedToken[player] = nil
		lastDart[player] = nil
	end)
end

-- Collega gli eventi del personaggio (morte durante la notte = fuori dalla partita)
function Team.watchCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	hum.Died:Connect(function()
		local status = player:GetAttribute("Status")
		if ctx.round.active and (status == "OK" or status == "Braccato") then
			downedToken[player] = nil
			player:SetAttribute("Status", "Fuori")
			player:SetAttribute("TorchOn", false)
			ctx.objectives.onDowned(player)
		elseif not ctx.round.active then
			task.delay(3, function()
				if player.Parent and player.Character == char and not ctx.round.active then
					Team.spawn(player, ctx.state:GetAttribute("Phase") == "Briefing")
				end
			end)
		end
	end)
end

return Team
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX39"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX38"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX37"><Properties><string name="Name">RakeClient</string><ProtectedString name="Source"><![CDATA[-- Client di "The Rake": controlli, stamina e fiatone, Paura e allucinazioni, visore notturno,
-- fucile a dardi, tablet delle telecamere, atmosfera, animazione della creatura e HUD.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(Shared:WaitForChild("Models"))
local RakeRig = require(Shared:WaitForChild("RakeRig"))
local Hud = require(script:WaitForChild("Hud"))
local Tablet = require(script:WaitForChild("Tablet"))
local Ambience = require(script:WaitForChild("Ambience"))
local RakeAnimator = require(script:WaitForChild("RakeAnimator"))
local Scope = require(script:WaitForChild("Scope"))
local CamFeed = require(script:WaitForChild("CamFeed"))
local Compass = require(script:WaitForChild("Compass"))
local Gunfx = require(script:WaitForChild("Gunfx"))
local Scares = require(script:WaitForChild("Scares"))

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local state = ReplicatedStorage:WaitForChild("RakeState")
local remotes = ReplicatedStorage:WaitForChild("RakeRemotes")

local P = Config.PLAYER
local NV_MAX = Config.EQUIPMENT.NIGHT_VISION_BATTERY

Models.load()
local hud = Hud.new(player, state)
local tablet = Tablet.new(player, state, remotes)
local scope = Scope.new(player)
scope:bind()
RakeAnimator.start(state)
CamFeed.start(player)
Compass.new(player, state, hud.gui)
Gunfx.start(remotes)
Scares.start(player, state, function()
	hud:pulse()
end)

remotes.Notify.OnClientEvent:Connect(function(message)
	hud:notify(message)
end)
remotes.Debrief.OnClientEvent:Connect(function(data)
	tablet:close()
	hud:showDebrief(data)
end)
remotes.OpenTablet.OnClientEvent:Connect(function()
	tablet:open()
end)

---------------------------------------------------------------------------------------------
-- Controlli

local sprintHeld = false
local nvOn = false
local nvBattery = NV_MAX

ContextActionService:BindAction("Scatto", function(_, inputState)
	sprintHeld = inputState == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Pass
end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
ContextActionService:SetTitle("Scatto", "Corri")

ContextActionService:BindAction("Tablet", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		tablet:toggle()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.T, Enum.KeyCode.ButtonY)
ContextActionService:SetTitle("Tablet", "Tablet")

ContextActionService:BindAction("Visore", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		if not nvOn and nvBattery <= 0 then
			hud:notify("Visore notturno scarico: ricaricalo al Rifornimento.")
		else
			nvOn = not nvOn
		end
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.N, Enum.KeyCode.ButtonX)
ContextActionService:SetTitle("Visore", "Visore")

ContextActionService:BindAction("TipoCamera", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		remotes.CycleCameraType:FireServer()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonB)
ContextActionService:SetTitle("TipoCamera", "Tipo cam")

player:GetAttributeChangedSignal("SupplyTick"):Connect(function()
	nvBattery = NV_MAX
end)

-- Fucile a dardi (mira dove punta il mouse o il tocco) e tablet impugnato
local hooked = setmetatable({}, { __mode = "k" })
local function hookTool(tool: Instance)
	if not tool:IsA("Tool") or hooked[tool] then
		return
	end
	hooked[tool] = true
	if tool.Name == "Fucile a dardi" then
		tool.Activated:Connect(function()
			if not tablet.isOpen and Gunfx.fireLocal(tool, scope.active) then
				remotes.FireDart:FireServer(mouse.Hit.Position)
			end
		end)
	elseif tool.Name == "Tablet" then
		tool.Activated:Connect(function()
			scope:exit()
			tablet:open()
		end)
	end
end

local function watchContainer(container: Instance)
	for _, child in container:GetChildren() do
		hookTool(child)
	end
	container.ChildAdded:Connect(hookTool)
end

player.CharacterAdded:Connect(function(char)
	tablet:close()
	watchContainer(char)
	watchContainer(player:WaitForChild("Backpack"))
end)
if player.Character then
	watchContainer(player.Character)
	watchContainer(player:WaitForChild("Backpack"))
end

---------------------------------------------------------------------------------------------
-- Effetti locali

local nvEffect = Instance.new("ColorCorrectionEffect")
nvEffect.Name = "VisoreNotturno"
nvEffect.TintColor = Color3.fromRGB(130, 255, 150)
nvEffect.Brightness = 0.3
nvEffect.Contrast = 0.25
nvEffect.Saturation = -1
nvEffect.Enabled = false
nvEffect.Parent = Lighting

local fearEffect = Instance.new("ColorCorrectionEffect")
fearEffect.Name = "Paura"
fearEffect.Parent = Lighting

local fearBlur = Instance.new("BlurEffect")
fearBlur.Name = "PauraSfocatura"
fearBlur.Size = 0
fearBlur.Parent = Lighting

local function groundY(pos: Vector3): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -200, 0), params)
	return hit and hit.Position.Y or pos.Y - 4
end

local updateAmbience, whisperAt = Ambience.start(player, state, function()
	hud:pulse()
end)

-- Allucinazione: la sagoma della creatura appare un istante tra gli alberi (solo per te)
local function hallucinate()
	local camera = workspace.CurrentCamera
	local look = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.1 then
		return
	end
	local dir = CFrame.Angles(0, math.rad(math.random(-35, 35)), 0) * look.Unit
	local pos = camera.CFrame.Position + dir * math.random(22, 38)
	local ground = Vector3.new(pos.X, groundY(pos), pos.Z)
	local facing = Vector3.new(camera.CFrame.Position.X, ground.Y, camera.CFrame.Position.Z)
	local ghost = Instance.new("Model")
	ghost.Name = "Allucinazione"
	local rig = RakeRig.build(ghost, CFrame.lookAt(ground, facing) * CFrame.new(0, RakeRig.ROOT_HEIGHT, 0), { ghost = true })
	-- posa storta: testa piegata, braccia aperte, mascella spalancata (ossa ruotate di 180 gradi)
	for name, cf in {
		Head = CFrame.Angles(-0.2, 0.3, -1.1),
		Jaw = CFrame.Angles(0.7, 0, 0),
		ShoulderL = CFrame.Angles(-1.2, 0, 0.5),
		ShoulderR = CFrame.Angles(-0.4, 0, -0.9),
	} do
		local bone = rig.body:FindFirstChild(name, true)
		if bone and bone:IsA("Bone") then
			bone.Transform = cf
		end
	end
	ghost.Parent = workspace
	local headBone = rig.body:FindFirstChild("Head", true)
	if headBone and headBone:IsA("Bone") then
		for _, side in { -1, 1 } do
			local eye = Instance.new("Part")
			eye.Shape = Enum.PartType.Ball
			eye.Size = Vector3.new(0.12, 0.12, 0.12)
			eye.Material = Enum.Material.Neon
			eye.Color = Color3.fromRGB(255, 245, 230)
			eye.Anchored = true
			eye.CanCollide = false
			eye.CanQuery = false
			eye.CFrame = headBone.TransformedWorldCFrame * CFrame.new(-side * 0.15, 0.34, 0.66)
			eye.Parent = ghost
		end
	end
	Debris:AddItem(ghost, 0.8)
	whisperAt(ground + Vector3.new(0, 5, 0))
end

local function spectate()
	local camera = workspace.CurrentCamera
	local subject = camera.CameraSubject
	if subject and subject:IsA("Humanoid") and subject.Health > 0 and subject.Parent ~= player.Character then
		return
	end
	for _, other in Players:GetPlayers() do
		local hum = other ~= player and other.Character and other.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 and other:GetAttribute("Status") ~= "Fuori" then
			camera.CameraSubject = hum
			return
		end
	end
end

---------------------------------------------------------------------------------------------
-- Ciclo per frame: stamina, paura, velocità, visore, atmosfera

local stamina, fear = 100, 0
local exhausted, panic = false, false
local nextHallucination = 0

RunService.RenderStepped:Connect(function(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local status = player:GetAttribute("Status") or "Lobby"
	local phase = state:GetAttribute("Phase")

	-- Stamina e fiatone
	local moving = hum ~= nil and hum.MoveDirection.Magnitude > 0.1
	local sprinting = sprintHeld and moving and not exhausted and stamina > 0 and (status == "OK" or status == "Lobby")
	if sprinting then
		stamina -= P.STAMINA_DRAIN * dt
		if stamina <= 0 then
			stamina = 0
			exhausted = true
		end
	else
		stamina = math.min(100, stamina + P.STAMINA_REGEN * dt)
		if exhausted and stamina >= 35 then
			exhausted = false
		end
	end

	-- Paura: sale al buio, da soli e con la creatura vicina; scende vicino ai compagni e alle luci
	local root = Ambience.rakeRoot()
	if phase == "Notte" and status == "OK" and hrp then
		local pos = hrp.Position
		local dark = Lighting.ClockTime >= 19.5 or Lighting.ClockTime < 6
		local atStation = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(Config.MAP.POIS[1].pos.X, 0, Config.MAP.POIS[1].pos.Z)).Magnitude < Config.MAP.STATION_RADIUS
		local lit = player:GetAttribute("TorchOn") or nvOn or atStation
		local mates = 0
		for _, other in Players:GetPlayers() do
			local otherRoot = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot and other:GetAttribute("Status") == "OK" and (otherRoot.Position - pos).Magnitude < 25 then
				mates += 1
			end
		end
		local rate = 0
		if dark and not lit then
			rate += 5
		end
		rate += mates == 0 and 2.5 or -4 * mates
		if lit then
			rate -= 3
		end
		if atStation then
			rate -= 10
		end
		if root then
			local d = (root.Position - pos).Magnitude
			if d < 70 then
				rate += (70 - d) / 70 * 30
			end
		end
		fear = math.clamp(fear + rate * dt, 0, 100)
	else
		fear = math.max(0, fear - 20 * dt)
	end
	if fear >= 100 then
		panic = true
	elseif fear < 70 then
		panic = false
	end
	if panic and os.clock() > nextHallucination then
		nextHallucination = os.clock() + math.random(5, 11)
		local ok, err = pcall(hallucinate)
		if not ok then
			warn("[Allucinazione] " .. tostring(err))
		end
	end
	local fearAmount = math.clamp((fear - 40) / 60, 0, 1)
	fearEffect.Saturation = -0.6 * fearAmount
	fearEffect.Contrast = 0.25 * fearAmount
	fearBlur.Size = panic and 3 + math.sin(os.clock() * 6) * 2 or 0

	-- Tremolio della visuale quando la creatura è vicina
	-- (CameraOffset non si accumula: modificare la CFrame della visuale la farebbe derivare)
	if hum then
		local shake = 0
		if root and hrp and not tablet.isOpen and not scope.active then
			shake = math.clamp(1 - (root.Position - hrp.Position).Magnitude / 30, 0, 1) * 0.25
		end
		hum.CameraOffset = Vector3.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0)
	end

	-- Velocità (il server la azzera quando sei braccato)
	if hum then
		if status == "Braccato" or tablet.isOpen then
			hum.WalkSpeed = 0
		elseif status == "OK" or status == "Lobby" then
			local speed = sprinting and P.SPRINT_SPEED or P.WALK_SPEED
			if exhausted then
				speed = P.WALK_SPEED * 0.8
			end
			if panic then
				speed *= P.FEAR_SLOWDOWN
			end
			hum.WalkSpeed = speed
		end
	end

	-- Visore notturno
	if nvOn then
		nvBattery -= dt
		if nvBattery <= 0 then
			nvBattery = 0
			nvOn = false
			hud:notify("Visore notturno scarico.")
		end
	end
	nvEffect.Enabled = nvOn and not tablet.isOpen

	if status == "Fuori" and phase == "Notte" and not tablet.isOpen then
		spectate()
	end

	scope.sway = math.clamp(fear / 100 + (exhausted and 0.6 or 0) + (sprinting and 0.4 or 0), 0, 1.5)
	updateAmbience(dt, { exhausted = exhausted, panic = panic })
	local closeness = 0
	if root and hrp then
		closeness = math.clamp(1 - (root.Position - hrp.Position).Magnitude / 60, 0, 1)
	end
	hud:update({
		config = Config,
		stamina = stamina,
		fear = fear,
		nv = nvBattery / NV_MAX,
		nvOn = nvOn,
		exhausted = exhausted,
		panic = panic,
		closeness = closeness,
		sprinting = sprinting,
		dt = dt,
	})
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">Ambience</string><ProtectedString name="Source"><![CDATA[-- Atmosfera locale: nebbia bassa, lucciole, pioggia e lampi, luci che tremano (e muoiono quando la
-- creatura è vicina), suoni d'ambiente, battito cardiaco, respiro affannato e rumori improvvisi.
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Sfx = require(Shared:WaitForChild("Sfx"))

local Ambience = {}

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function rakeRoot(): BasePart?
	local folder = workspace:FindFirstChild("RakeHunt")
	local rake = folder and folder:FindFirstChild("TheRake")
	return rake and rake:FindFirstChild("HumanoidRootPart") :: BasePart?
end
Ambience.rakeRoot = rakeRoot

local function emitterPart(parent: Instance, size: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = size
	p.Parent = parent
	return p
end

local function seq(points: { { number } }): NumberSequence
	local kps = {}
	for _, p in points do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(kps)
end

local function groundBelow(pos: Vector3): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(pos + Vector3.new(0, 20, 0), Vector3.new(0, -200, 0), params)
	return hit and hit.Position.Y or pos.Y - 3
end

-- Ritorna una funzione che va chiamata a ogni frame con lo stato corrente
function Ambience.start(player: Player, state: Folder, onHallucination: () -> ())
	local folder = Instance.new("Folder")
	folder.Name = "EffettiLocali"
	folder.Parent = workspace

	-- Nebbia che striscia a terra intorno al giocatore
	local fogPart = emitterPart(folder, Vector3.new(170, 2, 170))
	local fog = Instance.new("ParticleEmitter")
	fog.Texture = SMOKE
	fog.Color = ColorSequence.new(Color3.fromRGB(150, 160, 176))
	fog.LightInfluence = 1
	fog.LightEmission = 0
	fog.Size = seq({ { 0, 9 }, { 1, 18 } })
	fog.Transparency = seq({ { 0, 1 }, { 0.3, 0.84 }, { 0.7, 0.87 }, { 1, 1 } })
	fog.Lifetime = NumberRange.new(10, 16)
	fog.Rate = 16
	fog.Speed = NumberRange.new(0.3, 1.2)
	fog.SpreadAngle = Vector2.new(180, 180)
	fog.Rotation = NumberRange.new(0, 360)
	fog.RotSpeed = NumberRange.new(-6, 6)
	fog.Acceleration = Vector3.new(0.3, 0, 0.15)
	fog.Parent = fogPart

	-- Lucciole nella palude e al campeggio
	local fliesPart = emitterPart(folder, Vector3.new(90, 8, 90))
	local flies = Instance.new("ParticleEmitter")
	flies.Texture = SPARKLE
	flies.Color = ColorSequence.new(Color3.fromRGB(200, 255, 120))
	flies.LightEmission = 1
	flies.LightInfluence = 0
	flies.Size = seq({ { 0, 0.1 }, { 0.5, 0.25 }, { 1, 0.08 } })
	flies.Transparency = seq({ { 0, 1 }, { 0.2, 0.1 }, { 0.4, 0.8 }, { 0.6, 0.1 }, { 0.8, 0.7 }, { 1, 1 } })
	flies.Lifetime = NumberRange.new(3, 6)
	flies.Rate = 7
	flies.Speed = NumberRange.new(0.3, 1)
	flies.SpreadAngle = Vector2.new(180, 180)
	flies.Enabled = false
	flies.Parent = fliesPart

	-- Pioggia
	local rainPart = emitterPart(folder, Vector3.new(120, 1, 120))
	local rain = Instance.new("ParticleEmitter")
	rain.Color = ColorSequence.new(Color3.fromRGB(170, 182, 200))
	rain.LightInfluence = 1
	rain.Size = NumberSequence.new(0.08)
	rain.Squash = NumberSequence.new(-2.5)
	rain.Transparency = NumberSequence.new(0.45)
	rain.Orientation = Enum.ParticleOrientation.VelocityParallel
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Lifetime = NumberRange.new(0.9, 1.1)
	rain.Speed = NumberRange.new(75, 85)
	rain.Rate = 900
	rain.Enabled = false
	rain.Parent = rainPart

	local lightning = Instance.new("ColorCorrectionEffect")
	lightning.Name = "Fulmine"
	lightning.Parent = Lighting

	-- Suoni
	local ambience = Instance.new("Sound")
	ambience.Name = "Ambiente"
	ambience.SoundId = Audio.AMBIENCE
	ambience.Looped = true
	ambience.Volume = 0.55
	ambience.Parent = SoundService
	ambience:Play()
	local rainSound = Sfx.new("Rain", SoundService, { Volume = 0 })
	local heartbeat = Sfx.new("Heartbeat", SoundService, { Volume = 0 })
	local breathing = Sfx.new("Breathing", SoundService, { Volume = 0 })
	rainSound:Play()
	heartbeat:Play()
	breathing:Play()

	-- Luci tremolanti
	local lights: { [Light]: number } = {}
	local function track(light: Instance)
		if light:IsA("Light") then
			lights[light] = math.random() * 100
		end
	end
	for _, l in CollectionService:GetTagged("Flicker") do
		track(l)
	end
	CollectionService:GetInstanceAddedSignal("Flicker"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("Flicker"):Connect(function(l)
		lights[l :: Light] = nil
	end)

	local nextFollow, nextSnap, nextBolt = 0, os.clock() + 25, os.clock() + 20
	local nextFlicker = 0

	return function(dt: number, info: { exhausted: boolean, panic: boolean })
		local now = os.clock()
		local camera = workspace.CurrentCamera
		local camPos = camera.CFrame.Position
		local phase = state:GetAttribute("Phase")
		local night = Lighting.ClockTime >= 19.5 or Lighting.ClockTime < 6
		local raining = state:GetAttribute("Weather") == "Pioggia" and phase == "Notte"

		if now >= nextFollow then
			nextFollow = now + 0.3
			local ground = groundBelow(camPos)
			fogPart.CFrame = CFrame.new(camPos.X, ground + 1.5, camPos.Z)
			fliesPart.CFrame = CFrame.new(camPos.X, ground + 4, camPos.Z)
			local swampOrCamp = camPos.X < 0
			flies.Enabled = night and swampOrCamp and not raining
			fog.Rate = (state:GetAttribute("Weather") == "Nebbia" and 26 or 14) * (night and 1 or 0.4)
		end
		rainPart.CFrame = CFrame.new(camPos + Vector3.new(0, 35, 0))
		rain.Enabled = raining
		rainSound.Volume = raining and 0.6 or 0

		if raining and now >= nextBolt then
			nextBolt = now + math.random(15, 40)
			task.spawn(function()
				for _ = 1, math.random(1, 3) do
					lightning.Brightness = 0.45
					lightning.Contrast = 0.3
					TweenService:Create(lightning, TweenInfo.new(0.18), { Brightness = 0, Contrast = 0 }):Play()
					task.wait(0.12 + math.random() * 0.15)
				end
			end)
		end

		-- Creatura vicina: battito, luci che muoiono
		local root = rakeRoot()
		local rakePos = root and root.Position
		local dist = rakePos and (rakePos - camPos).Magnitude or math.huge
		local closeness = math.clamp(1 - dist / 55, 0, 1)
		heartbeat.Volume = closeness * 1.3
		heartbeat.PlaybackSpeed = 1 + closeness * 0.5
		breathing.Volume = (info.exhausted or info.panic) and 0.7 or 0
		ambience.Volume = 0.55 * (1 - closeness * 0.6)

		if now >= nextFlicker then
			nextFlicker = now + 1 / 20
			for light, seed in lights do
				if not light.Parent then
					lights[light] = nil
					continue
				end
				local base = light:GetAttribute("BaseBrightness") or light.Brightness
				local f = 0.9 + math.noise(now * 3, seed) * 0.25
				local holder = light.Parent
				if rakePos and holder:IsA("BasePart") then
					local d = (holder.Position - rakePos).Magnitude
					if d < 45 then
						local k = 1 - d / 45
						if math.random() < 0.15 + k * 0.4 then
							f = math.random() * (1 - k) * 0.6
						end
					end
				end
				light.Brightness = base * math.max(f, 0)
			end
		end

		-- Rumori improvvisi alle spalle
		if phase == "Notte" and now >= nextSnap then
			nextSnap = now + math.random(22, 55)
			local back = -camera.CFrame.LookVector * Vector3.new(1, 0, 1)
			if back.Magnitude > 0.1 then
				local dir = CFrame.Angles(0, math.rad(math.random(-60, 60)), 0) * back.Unit
				local p = camPos + dir * math.random(14, 30)
				Sfx.at("Snap", Vector3.new(p.X, groundBelow(p) + 1, p.Z), { Volume = 1.3, PlaybackSpeed = 0.85 + math.random() * 0.3 })
			end
		end
	end, function(position: Vector3)
		-- suono sussurrato per le allucinazioni
		Sfx.at("Whisper", position, { Volume = 1.6, RollOffMinDistance = 10 })
		onHallucination()
	end
end

return Ambience
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">CamFeed</string><ProtectedString name="Source"><![CDATA[-- Anteprime delle telecamere sui monitor della Ranger Station (solo client).
-- Ogni monitor ha un ViewportFrame con una ricostruzione della scena davanti alla telecamera:
-- terreno campionato, alberi/rocce/costruzioni clonati una volta, creatura (con la sua posa) e
-- compagni aggiornati 10 volte al secondo. I feed si attivano solo vicino alla stazione.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local CamFeed = {}

local RANGE = 85
local MAX_PARTS = 260
local GRID = 6

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

local function cameras(): { Model }
	local folder = workspace:FindFirstChild("RakeHunt")
	folder = folder and folder:FindFirstChild("Telecamere")
	local list = {}
	if folder then
		for _, m in folder:GetChildren() do
			if m:IsA("Model") and m:FindFirstChild("Body") and m:GetAttribute("Type") ~= "Trappola" then
				table.insert(list, m)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Id") or 0) < (b:GetAttribute("Id") or 0)
	end)
	return list
end

-- Ricostruisce in un Folder la scena statica davanti alla telecamera
local function buildScene(body: BasePart): Folder
	local scene = Instance.new("Folder")
	scene.Name = "Scena"
	local origin = body.Position
	local look = body.CFrame.LookVector
	-- terreno: griglia di blocchi alla quota del suolo
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	local terrain = workspace.Terrain
	local center = origin + Vector3.new(look.X, 0, look.Z).Unit * 35
	for gx = -7, 7 do
		for gz = -7, 7 do
			local p = center + Vector3.new(gx * GRID, 0, gz * GRID)
			local hit = workspace:Raycast(Vector3.new(p.X, origin.Y + 60, p.Z), Vector3.new(0, -160, 0), params)
			if hit then
				local color = hit.Material == Enum.Material.Water and Color3.fromRGB(14, 20, 18) or terrain:GetMaterialColor(hit.Material)
				make("Part", {
					Anchored = true,
					CanCollide = false,
					CanQuery = false,
					CanTouch = false,
					Size = Vector3.new(GRID + 0.4, 2, GRID + 0.4),
					CFrame = CFrame.new(hit.Position - Vector3.new(0, 1, 0)) * CFrame.Angles(math.asin(math.clamp(-hit.Normal.Z, -1, 1)) * 0.8, 0, math.asin(math.clamp(hit.Normal.X, -1, 1)) * 0.8),
					Color = color,
					Material = Enum.Material.SmoothPlastic,
				}, scene)
			end
		end
	end
	-- oggetti vicini nel campo visivo
	local candidates = {}
	local world = workspace:FindFirstChild("RakeHunt")
	for _, name in { "Vegetazione", "Mappa", "Prove" } do
		local folder = world and world:FindFirstChild(name)
		if folder then
			for _, d in folder:GetDescendants() do
				if d:IsA("BasePart") and d.Transparency < 0.95 then
					local to = d.Position - origin
					local dist = to.Magnitude
					if dist < RANGE and (dist < 6 or to.Unit:Dot(look) > 0.35) then
						table.insert(candidates, { d, dist })
					end
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a[2] < b[2]
	end)
	for i = 1, math.min(#candidates, MAX_PARTS) do
		local ok, copy = pcall(function()
			return candidates[i][1]:Clone()
		end)
		if ok and copy then
			for _, child in copy:GetChildren() do
				if not child:IsA("SpecialMesh") and not child:IsA("SurfaceAppearance") then
					child:Destroy()
				end
			end
			copy.Anchored = true
			copy.CanCollide = false
			copy.CanQuery = false
			copy.CanTouch = false
			copy.Parent = scene
		end
	end
	return scene
end

type Monitor = {
	part: BasePart,
	gui: SurfaceGui,
	viewport: ViewportFrame,
	vcam: Camera,
	title: TextLabel,
	alert: TextLabel,
	message: TextLabel,
	snow: Frame,
	camModel: Model?,
	scene: Folder?,
	rake: BasePart?,
	rakeBones: { [string]: Bone }?,
	eyes: { BasePart },
	people: { [Player]: BasePart },
}

local function newMonitor(part: BasePart, playerGui: Instance): Monitor
	local old = part:FindFirstChildOfClass("SurfaceGui")
	if old then
		old.Enabled = false
	end
	-- la SurfaceGui sta nel PlayerGui (Adornee sul monitor): i pezzi del ViewportFrame non devono
	-- mai trovarsi sotto Workspace, altrimenti diventano oggetti fisici veri
	local gui = make("SurfaceGui", {
		Name = "Feed",
		Adornee = part,
		ResetOnSpawn = false,
		Face = Enum.NormalId.Back,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 140,
		LightInfluence = 0,
		Brightness = 1.6,
		ClipsDescendants = true,
	}, playerGui)
	local viewport = make("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(2, 4, 3),
		Ambient = Color3.fromRGB(60, 66, 76),
		LightColor = Color3.fromRGB(150, 160, 180),
		LightDirection = Vector3.new(-0.3, -1, -0.2),
	}, gui)
	local vcam = make("Camera", { FieldOfView = 70 }, viewport)
	viewport.CurrentCamera = vcam
	for i = 0, 29 do
		make("Frame", { Position = UDim2.fromScale(0, i / 30), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.75, BorderSizePixel = 0 }, gui)
	end
	local snow = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(180, 180, 180), BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)
	local function text(props)
		local t = make("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.Code, TextColor3 = Color3.fromRGB(170, 255, 190), TextStrokeTransparency = 0.5, TextScaled = true }, gui)
		for k, v in props do
			(t :: any)[k] = v
		end
		return t
	end
	return {
		part = part,
		gui = gui,
		viewport = viewport,
		vcam = vcam,
		snow = snow,
		title = text({ Position = UDim2.fromScale(0.03, 0.03), Size = UDim2.fromScale(0.94, 0.12), TextXAlignment = Enum.TextXAlignment.Left }),
		alert = text({ Position = UDim2.fromScale(0.05, 0.8), Size = UDim2.fromScale(0.9, 0.13), TextColor3 = Color3.fromRGB(255, 80, 70) }),
		message = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.85, 0.3) }),
		camModel = nil,
		scene = nil,
		rake = nil,
		rakeBones = nil,
		eyes = {},
		people = {},
	}
end

local function clearDynamic(mon: Monitor)
	if mon.rake then
		mon.rake:Destroy()
		mon.rake = nil
		mon.rakeBones = nil
	end
	for _, e in mon.eyes do
		e:Destroy()
	end
	table.clear(mon.eyes)
	for _, p in mon.people do
		p:Destroy()
	end
	table.clear(mon.people)
end

local function setCamera(mon: Monitor, camModel: Model?)
	if mon.camModel == camModel then
		return
	end
	clearDynamic(mon)
	if mon.scene then
		mon.scene:Destroy()
		mon.scene = nil
	end
	mon.camModel = camModel
	if camModel then
		local body = camModel:FindFirstChild("Body") :: BasePart
		local ok, scene = pcall(buildScene, body)
		if ok then
			scene.Parent = mon.viewport
			mon.scene = scene
		else
			warn("[Monitor] " .. tostring(scene))
		end
	end
end

local function updateDynamic(mon: Monitor, body: BasePart)
	local folder = workspace:FindFirstChild("RakeHunt")
	local rake = folder and folder:FindFirstChild("TheRake")
	local realBody = rake and rake:FindFirstChild("Body") :: BasePart?
	if realBody and (realBody.Position - body.Position).Magnitude < RANGE + 20 then
		if not mon.rake then
			local copy = realBody:Clone()
			for _, d in copy:GetDescendants() do
				if not d:IsA("Bone") then
					d:Destroy()
				end
			end
			copy.Anchored = true
			copy.CanCollide = false
			copy.CanQuery = false
			copy.CanTouch = false
			copy.Parent = mon.viewport
			mon.rake = copy
			mon.rakeBones = {}
			for _, d in copy:GetDescendants() do
				if d:IsA("Bone") then
					(mon.rakeBones :: any)[d.Name] = d
				end
			end
		end
		local copy = mon.rake :: BasePart
		copy.CFrame = realBody.CFrame
		for _, d in realBody:GetDescendants() do
			if d:IsA("Bone") then
				local twin = (mon.rakeBones :: any)[d.Name]
				if twin then
					twin.Transform = d.Transform
				end
			end
		end
		local realEyes = {}
		for _, e in workspace:GetChildren() do
			if e.Name == "OcchioLocale" and e:IsA("BasePart") then
				table.insert(realEyes, e)
			end
		end
		for i, e in realEyes do
			local twin = mon.eyes[i]
			if not twin then
				twin = make("Part", { Shape = Enum.PartType.Ball, Size = Vector3.new(0.3, 0.3, 0.3), Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanQuery = false }, mon.viewport)
				mon.eyes[i] = twin
			end
			twin.CFrame = e.CFrame
			twin.Color = e.Color
		end
	elseif mon.rake then
		clearDynamic(mon)
	end
	-- compagni come sagome scure
	for _, p in Players:GetPlayers() do
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local near = hrp and (hrp.Position - body.Position).Magnitude < RANGE
		local twin = mon.people[p]
		if near and hrp then
			if not twin then
				twin = make("Part", { Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 1.8, 1.8), Color = Color3.fromRGB(40, 44, 40), Material = Enum.Material.SmoothPlastic, Anchored = true, CanCollide = false, CanQuery = false }, mon.viewport)
				mon.people[p] = twin
			end
			twin.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, 0, math.pi / 2)
		elseif twin then
			twin:Destroy()
			mon.people[p] = nil
		end
	end
end

CamFeed._buildScene = buildScene

function CamFeed.start(player: Player)
	local monitors: { Monitor } = {}
	local page, nextPage, nextUpdate = 0, 0, 0

	local function refreshList()
		table.clear(monitors)
		local parts = CollectionService:GetTagged("MonitorScreen")
		table.sort(parts, function(a, b)
			return (a:GetAttribute("Index") or 0) < (b:GetAttribute("Index") or 0)
		end)
		for _, p in parts do
			if p:IsA("BasePart") then
				table.insert(monitors, newMonitor(p, player:WaitForChild("PlayerGui")))
			end
		end
	end

	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextUpdate then
			return
		end
		nextUpdate = now + 0.1
		if #monitors == 0 then
			if #CollectionService:GetTagged("MonitorScreen") == 0 then
				return
			end
			refreshList()
		end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local nearStation = hrp ~= nil and (hrp.Position - monitors[1].part.Position).Magnitude < 60
		local list = cameras()
		if now >= nextPage then
			nextPage = now + 8
			page += 1
		end
		local pages = math.max(1, math.ceil(#list / #monitors))
		local offset = ((page % pages) * #monitors)
		local blink = now % 1 < 0.55
		local night = Lighting.ClockTime >= 19.5 or Lighting.ClockTime < 6
		for i, mon in monitors do
			local camModel = nearStation and list[offset + i] or nil
			setCamera(mon, camModel)
			if not camModel then
				mon.viewport.Visible = false
				mon.title.Text = ("CAM -- %s"):format(blink and "●" or "")
				mon.message.Text = #list == 0 and "NESSUNA TELECAMERA" or "IN ATTESA"
				mon.alert.Text = ""
				mon.snow.BackgroundTransparency = 0.85
				continue
			end
			local body = camModel:FindFirstChild("Body") :: BasePart?
			if not body then
				continue
			end
			local camType = camModel:GetAttribute("Type")
			local online = camModel:GetAttribute("Online")
			mon.title.Text = ("CAM %02d %s %s %s"):format(camModel:GetAttribute("Id") or 0, string.upper(camType or ""), string.upper(camModel:GetAttribute("Label") or ""), blink and "● REC" or "")
			if not online then
				mon.viewport.Visible = false
				mon.message.Text = "NESSUN SEGNALE"
				mon.alert.Text = ""
				mon.snow.BackgroundTransparency = 0.5 + math.random() * 0.2
				continue
			end
			mon.viewport.Visible = true
			mon.message.Text = ""
			mon.vcam.CFrame = body.CFrame * CFrame.new(0, 0, -1.25)
			-- tutte le telecamere hanno la visione notturna a infrarossi
			if night then
				mon.viewport.ImageColor3 = Color3.fromRGB(150, 255, 165)
				mon.viewport.Ambient = camType == "IR" and Color3.fromRGB(175, 185, 175) or Color3.fromRGB(140, 150, 140)
				mon.viewport.LightColor = Color3.fromRGB(200, 220, 200)
			else
				mon.viewport.ImageColor3 = Color3.fromRGB(205, 215, 225)
				mon.viewport.Ambient = Color3.fromRGB(150, 150, 150)
				mon.viewport.LightColor = Color3.fromRGB(150, 160, 180)
			end
			updateDynamic(mon, body)
			local noise = 0
			if mon.rake then
				noise = math.clamp(1 - ((mon.rake :: BasePart).Position - body.Position).Magnitude / 45, 0, 1)
			end
			mon.snow.BackgroundTransparency = 1 - noise * 0.45 * (0.5 + math.random() * 0.5)
			mon.alert.Text = camModel:GetAttribute("Sees") and (blink and "⚠ MOVIMENTO" or "") or ""
		end
	end)
end

return CamFeed
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">Compass</string><ProtectedString name="Source"><![CDATA[-- Bussola in alto, trasparente: tacche e punti cardinali, icone dei punti di interesse con la
-- distanza in metri, la destinazione (che indica la direzione del sentiero da seguire e la
-- distanza lungo il percorso), compagni, area di caccia e ultimo avvistamento.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Nav = require(script.Parent:WaitForChild("Nav"))

local Compass = {}
Compass.__index = Compass

local WIDTH = 640
local HALF_FOV = 95 -- gradi visibili per lato

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

local function heading(v: Vector3): number
	return (math.deg(math.atan2(v.X, -v.Z)) + 360) % 360
end

local function relative(target: number, current: number): number
	return ((target - current + 540) % 360) - 180
end

function Compass.new(player: Player, state: Folder, parent: Instance)
	local self = setmetatable({}, Compass)
	self.player = player
	self.state = state
	local bar = make("Frame", {
		Name = "Bussola",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(WIDTH, 58),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, parent)
	make("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.18, 0.2),
			NumberSequenceKeypoint.new(0.82, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, bar)
	self.bar = bar
	self.ticks = {}
	for deg = 0, 345, 15 do
		local cardinal = ({ [0] = "N", [45] = "NE", [90] = "E", [135] = "SE", [180] = "S", [225] = "SO", [270] = "O", [315] = "NO" })[deg]
		local tick = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(cardinal and 2 or 1, cardinal and 10 or 6),
			BackgroundColor3 = Color3.fromRGB(230, 230, 220),
			BackgroundTransparency = cardinal and 0.1 or 0.45,
			BorderSizePixel = 0,
		}, bar)
		local text
		if cardinal then
			text = make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0),
				Size = UDim2.fromOffset(30, 14),
				BackgroundTransparency = 1,
				Text = cardinal,
				Font = Enum.Font.GothamBold,
				TextSize = cardinal == "N" and 14 or 12,
				TextColor3 = cardinal == "N" and Color3.fromRGB(255, 120, 100) or Color3.fromRGB(235, 235, 225),
				TextStrokeTransparency = 0.6,
			}, bar)
		end
		table.insert(self.ticks, { deg = deg, tick = tick, text = text })
	end
	make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -3),
		Size = UDim2.fromOffset(14, 10),
		BackgroundTransparency = 1,
		Text = "▼",
		TextSize = 10,
		TextColor3 = Color3.fromRGB(255, 220, 90),
		ZIndex = 5,
	}, bar)
	self.degrees = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 2),
		Size = UDim2.fromOffset(120, 14),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(230, 230, 220),
		TextStrokeTransparency = 0.6,
	}, parent)
	self.destination = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 82),
		Size = UDim2.fromOffset(400, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(255, 220, 90),
		TextStrokeTransparency = 0.5,
	}, parent)
	self.markers = {}
	self.nextRoute = 0
	if RunService:IsClient() then
		RunService.RenderStepped:Connect(function()
			local ok, err = pcall(self.update, self)
			if not ok and not self.warned then
				self.warned = true
				warn("[Bussola] " .. tostring(err))
			end
		end)
	end
	return self
end

function Compass:marker(key: string, text: string, color: Color3, size: number): TextLabel
	local m = self.markers[key]
	if not m then
		m = make("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(70, 34),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextStrokeTransparency = 0.45,
			RichText = true,
			ZIndex = 4,
		}, self.bar)
		self.markers[key] = m
	end
	m.Text = text
	m.TextColor3 = color
	m.TextSize = size
	self.used[key] = true
	return m
end

function Compass:place(m: TextLabel, rel: number, clampEdge: boolean)
	if math.abs(rel) > HALF_FOV then
		if not clampEdge then
			m.Visible = false
			return
		end
		rel = math.sign(rel) * HALF_FOV
	end
	m.Visible = true
	m.Position = UDim2.new(0.5, rel / HALF_FOV * WIDTH / 2, 0, 14)
	m.TextTransparency = math.clamp((math.abs(rel) - HALF_FOV * 0.7) / (HALF_FOV * 0.3), 0, 0.7)
end

function Compass:update()
	local camera = workspace.CurrentCamera
	local look = camera.CFrame.LookVector
	local current = heading(look)
	self.degrees.Text = ("%03d°"):format(math.floor(current))
	for _, t in self.ticks do
		local rel = relative(t.deg, current)
		local visible = math.abs(rel) <= HALF_FOV
		t.tick.Visible = visible
		local x = rel / HALF_FOV * WIDTH / 2
		t.tick.Position = UDim2.new(0.5, x, 0, 0)
		if t.text then
			t.text.Visible = visible
			t.text.Position = UDim2.new(0.5, x, 0, 10)
		end
	end

	local char = self.player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local origin = hrp and hrp.Position or camera.CFrame.Position
	self.used = {}
	local function dir(p: Vector3): (number, number)
		local d = Vector3.new(p.X - origin.X, 0, p.Z - origin.Z)
		return relative(heading(d), current), d.Magnitude
	end

	local dest = Nav.destination(self.state)
	for i, poi in Nav.POIS do
		local rel, dist = dir(poi.pos)
		local isDest = dest and dest.poi == i
		if not isDest then
			local m = self:marker("poi" .. i, ("%s\n<font size=\"10\">%d m</font>"):format(Nav.ICONS[i], Nav.meters(dist)), Color3.fromRGB(235, 235, 225), 15)
			self:place(m, rel, false)
		end
	end
	if dest then
		local now = os.clock()
		if now >= self.nextRoute then
			self.nextRoute = now + 0.5
			self.routePoints, self.routeLength = Nav.route(origin, dest.pos)
		end
		local target = Nav.nextWaypoint(self.routePoints, origin)
		local rel = dir(target)
		local icon = dest.poi and Nav.ICONS[dest.poi] or "◆"
		local m = self:marker("dest", ("%s\n<font size=\"11\">%d m</font>"):format(icon, Nav.meters(self.routeLength or 0)), Color3.fromRGB(255, 220, 90), 18)
		self:place(m, rel, true)
		self.destination.Text = ("▶ %s · %d m lungo il sentiero"):format(dest.name, Nav.meters(self.routeLength or 0))
	else
		self.destination.Text = ""
	end
	local state = self.state
	if (state:GetAttribute("HintR") or 0) > 0 and not (dest and dest.name == "Area di caccia") then
		local rel, dist = dir(Vector3.new(state:GetAttribute("HintX") or 0, 0, state:GetAttribute("HintZ") or 0))
		self:place(self:marker("hunt", ("⚠\n<font size=\"10\">%d m</font>"):format(Nav.meters(dist)), Color3.fromRGB(255, 80, 60), 15), rel, false)
	end
	local seenAt = state:GetAttribute("LastSeenTime") or 0
	if seenAt > 0 and workspace:GetServerTimeNow() - seenAt < 45 then
		local rel, dist = dir(Vector3.new(state:GetAttribute("LastSeenX") or 0, 0, state:GetAttribute("LastSeenZ") or 0))
		self:place(self:marker("seen", ("✕\n<font size=\"10\">%d m</font>"):format(Nav.meters(dist)), Color3.fromRGB(255, 60, 50), 16), rel, false)
	end
	for _, p in Players:GetPlayers() do
		if p ~= self.player then
			local phrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local status = p:GetAttribute("Status")
			if phrp and (status == "OK" or status == "Braccato") then
				local rel, dist = dir(phrp.Position)
				local color = status == "Braccato" and Color3.fromRGB(255, 70, 60) or Color3.fromRGB(110, 230, 120)
				self:place(self:marker("p" .. p.UserId, ("●\n<font size=\"10\">%s %d m</font>"):format(p.DisplayName:sub(1, 8), Nav.meters(dist)), color, 12), rel, status == "Braccato")
			end
		end
	end
	for key, m in self.markers do
		if not self.used[key] then
			m.Visible = false
		end
	end
end

return Compass
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">Gunfx</string><ProtectedString name="Source"><![CDATA[-- Effetti del fucile a dardi (client): fiammata con luce che illumina il bosco, fumo, rinculo
-- (la canna sale e torna giù a metà), sobbalzo dell'arma, lampo e colpo di zoom, sparo con eco e
-- otturatore, dardo visibile in volo che resta conficcato dove colpisce, conferma del colpo.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Sfx = require(Shared:WaitForChild("Sfx"))

local Gunfx = {}

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local EQ = Config.EQUIPMENT

local player = Players.LocalPlayer
local lastShot = 0
local overlay: ScreenGui? = nil
local flashFrame: Frame? = nil
local hitMarker: TextLabel? = nil

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

local function burst(position: Vector3, props: { [string]: any }, count: number, life: number)
	local holder = part({ Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(position) })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	for k, v in props do
		(emitter :: any)[k] = v
	end
	emitter.Parent = holder
	holder.Parent = workspace
	emitter:Emit(count)
	Debris:AddItem(holder, life)
end

local function muzzleFlash(from: Vector3, dir: Vector3)
	local flash = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.9, 0.9, 0.9),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 200, 120),
		CFrame = CFrame.new(from + dir * 0.3),
	})
	local cone = part({
		Size = Vector3.new(0.35, 0.35, 1.6),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 170, 80),
		CFrame = CFrame.lookAt(from + dir * 0.8, from + dir * 2),
		Transparency = 0.2,
	})
	local light = Instance.new("PointLight")
	light.Range = 38
	light.Brightness = 9
	light.Color = Color3.fromRGB(255, 190, 120)
	light.Shadows = true
	light.Parent = flash
	flash.Parent = workspace
	cone.Parent = workspace
	Debris:AddItem(flash, 0.06)
	Debris:AddItem(cone, 0.04)
	burst(from + dir * 0.4, {
		Texture = SMOKE,
		Color = ColorSequence.new(Color3.fromRGB(170, 170, 165)),
		LightInfluence = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 2.6) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(1.2, 2.4),
		Speed = NumberRange.new(1.5, 4),
		SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0, 1.2, 0),
		Drag = 2,
		EmissionDirection = Enum.NormalId.Top,
	}, 14, 3)
	burst(from + dir * 0.4, {
		Texture = SPARK,
		Color = ColorSequence.new(Color3.fromRGB(255, 200, 120)),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.08, 0.2),
		Speed = NumberRange.new(10, 25),
		SpreadAngle = Vector2.new(20, 20),
	}, 10, 1)
end

local function ensureOverlay()
	if overlay then
		return
	end
	overlay = Instance.new("ScreenGui")
	overlay.Name = "Sparo"
	overlay.IgnoreGuiInset = true
	overlay.ResetOnSpawn = false
	overlay.DisplayOrder = 6
	overlay.Parent = player:WaitForChild("PlayerGui")
	flashFrame = Instance.new("Frame")
	flashFrame.Size = UDim2.fromScale(1, 1)
	flashFrame.BackgroundColor3 = Color3.fromRGB(255, 220, 170)
	flashFrame.BackgroundTransparency = 1
	flashFrame.BorderSizePixel = 0
	flashFrame.Parent = overlay
	hitMarker = Instance.new("TextLabel")
	hitMarker.AnchorPoint = Vector2.new(0.5, 0.5)
	hitMarker.Position = UDim2.fromScale(0.5, 0.5)
	hitMarker.Size = UDim2.fromOffset(40, 40)
	hitMarker.BackgroundTransparency = 1
	hitMarker.Text = "✕"
	hitMarker.Font = Enum.Font.GothamBlack
	hitMarker.TextSize = 30
	hitMarker.TextColor3 = Color3.fromRGB(255, 50, 40)
	hitMarker.TextTransparency = 1
	hitMarker.Parent = overlay
end

local function recoil(scoped: boolean)
	local camera = workspace.CurrentCamera
	local kick = math.rad(scoped and 2.4 or 4.2)
	local yaw = (math.random() - 0.5) * kick * 0.5
	task.spawn(function()
		for _ = 1, 3 do
			camera.CFrame *= CFrame.Angles(kick / 3, yaw / 3, 0)
			RunService.RenderStepped:Wait()
		end
		for _ = 1, 16 do
			camera.CFrame *= CFrame.Angles(-kick * 0.55 / 16, -yaw * 0.5 / 16, 0)
			RunService.RenderStepped:Wait()
		end
	end)
	if not scoped then
		local fov = camera.FieldOfView
		camera.FieldOfView = fov + 4
		TweenService:Create(camera, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = fov }):Play()
	end
	ensureOverlay()
	local frame = flashFrame :: Frame
	frame.BackgroundTransparency = scoped and 0.9 or 0.8
	TweenService:Create(frame, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
end

local function gripKick(tool: Tool)
	local original = tool:GetAttribute("GripOriginale")
	if typeof(original) ~= "CFrame" then
		original = tool.Grip
		tool:SetAttribute("GripOriginale", original)
	end
	tool.Grip = (original :: CFrame) * CFrame.new(0, -0.05, -0.45) * CFrame.Angles(-0.25, 0, 0)
	TweenService:Create(tool, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Grip = original }):Play()
end

-- Il dardo vola fino al punto colpito e resta conficcato
local function projectile(from: Vector3, to: Vector3, kind: string, normal: Vector3, hitInst: Instance?, isMine: boolean)
	local dir = to - from
	local dist = dir.Magnitude
	if dist < 0.5 then
		return
	end
	local unit = dir.Unit
	local dart = Instance.new("Model")
	dart.Name = "Dardo"
	local shaft = part({ Size = Vector3.new(0.07, 0.07, 1), Color = Color3.fromRGB(150, 150, 155), Material = Enum.Material.Metal })
	local needle = part({ Size = Vector3.new(0.03, 0.03, 0.5), Color = Color3.fromRGB(200, 200, 205), Material = Enum.Material.Metal })
	local fletch = part({ Size = Vector3.new(0.22, 0.22, 0.3), Color = Color3.fromRGB(255, 120, 30), Material = Enum.Material.Neon })
	shaft.Parent, needle.Parent, fletch.Parent = dart, dart, dart
	dart.PrimaryPart = shaft
	local whoosh = Sfx.new("DartWhoosh", shaft, { Volume = 0.8, RollOffMaxDistance = 35 })
	dart.Parent = workspace
	if not isMine then
		whoosh:Play()
	end
	local function place(pos: Vector3)
		local cf = CFrame.lookAt(pos, pos + unit)
		shaft.CFrame = cf
		needle.CFrame = cf * CFrame.new(0, 0, -0.7)
		fletch.CFrame = cf * CFrame.new(0, 0, 0.45) * CFrame.Angles(0, 0, math.pi / 4)
	end
	local duration = dist / EQ.DART_SPEED
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - start) / duration, 0, 1)
		place(from:Lerp(to, a) - Vector3.new(0, math.sin(a * math.pi) * 0.25, 0))
		if a >= 1 then
			conn:Disconnect()
			-- impatto: il dardo resta conficcato
			place(to - unit * 0.35)
			if kind == "rake" and hitInst and hitInst:IsA("BasePart") then
				for _, p in dart:GetChildren() do
					if p:IsA("BasePart") then
						p.Anchored = false
						p.Massless = true
						local weld = Instance.new("WeldConstraint")
						weld.Part0 = hitInst
						weld.Part1 = p
						weld.Parent = p
					end
				end
				burst(to, {
					Texture = SMOKE,
					Color = ColorSequence.new(Color3.fromRGB(70, 8, 8)),
					LightInfluence = 1,
					Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.9) }),
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
					Lifetime = NumberRange.new(0.3, 0.7),
					Speed = NumberRange.new(4, 9),
					SpreadAngle = Vector2.new(40, 40),
					Acceleration = Vector3.new(0, -30, 0),
				}, 22, 2)
				if isMine and hitMarker then
					hitMarker.TextTransparency = 0
					hitMarker.TextSize = 40
					TweenService:Create(hitMarker, TweenInfo.new(0.4), { TextTransparency = 1, TextSize = 28 }):Play()
				end
			elseif kind == "terrain" or kind == "wood" then
				burst(to, {
					Texture = SMOKE,
					Color = ColorSequence.new(kind == "terrain" and Color3.fromRGB(90, 75, 55) or Color3.fromRGB(120, 95, 70)),
					LightInfluence = 1,
					Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1.2) }),
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
					Lifetime = NumberRange.new(0.4, 0.9),
					Speed = NumberRange.new(2, 6),
					SpreadAngle = Vector2.new(50, 50),
					EmissionDirection = Enum.NormalId.Top,
				}, 10, 2)
				Sfx.at("HitWood", to, { Volume = 1.1, RollOffMaxDistance = 70, PlaybackSpeed = kind == "terrain" and 0.75 or 1 })
			else
				dart:Destroy()
				return
			end
			Debris:AddItem(dart, 25)
		end
	end)
	local _ = normal
end

-- Chiamato quando premi il grilletto: rinculo e fiammata immediati, poi il server conferma
function Gunfx.fireLocal(tool: Tool, scoped: boolean): boolean
	local now = os.clock()
	if now - lastShot < EQ.DART_COOLDOWN or (player:GetAttribute("Darts") or 0) <= 0 or player:GetAttribute("Status") ~= "OK" then
		return now - lastShot >= EQ.DART_COOLDOWN -- senza dardi il server avvisa
	end
	lastShot = now
	local muzzle = tool:FindFirstChild("Volata") :: BasePart?
	if muzzle then
		muzzleFlash(muzzle.Position, workspace.CurrentCamera.CFrame.LookVector)
	end
	Sfx.new("RifleShot", SoundService, { Volume = 1.6, PlayOnRemove = true }):Destroy()
	task.delay(0.55, function()
		Sfx.new("BoltCycle", SoundService, { Volume = 0.9, PlayOnRemove = true }):Destroy()
	end)
	recoil(scoped)
	gripKick(tool)
	return true
end

function Gunfx.start(remotes: Folder)
	ensureOverlay()
	remotes:WaitForChild("DartFx").OnClientEvent:Connect(function(shooter: Player, from: Vector3, to: Vector3, kind: string, normal: Vector3, hitInst: Instance?)
		local isMine = shooter == player
		if not isMine then
			muzzleFlash(from, (to - from).Unit)
			Sfx.at("RifleShot", from, { Volume = 2.4, RollOffMinDistance = 20, RollOffMaxDistance = 600 })
			task.delay(0.55, function()
				Sfx.at("BoltCycle", from, { Volume = 1.2, RollOffMaxDistance = 60 })
			end)
		end
		projectile(from, to, kind, normal, hitInst, isMine)
	end)
end

return Gunfx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- HUD minimale: fase e obiettivo, barre del giocatore, stato della caccia, squadra, notifiche e debriefing.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Watch = require(script.Parent:WaitForChild("Watch"))

local Hud = {}
Hud.__index = Hud

local TEXT = Color3.fromRGB(222, 226, 214)
local MUTED = Color3.fromRGB(150, 156, 145)
local PANEL = Color3.fromRGB(12, 15, 13)

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

local function corner(parent: Instance, radius: number?)
	make("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, parent)
end

local function padding(parent: Instance, px: number)
	make("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	}, parent)
end

local function panel(parent: Instance, props: { [string]: any }): Frame
	local f = make("Frame", props, parent)
	f.BackgroundColor3 = PANEL
	f.BackgroundTransparency = 0.3
	f.BorderSizePixel = 0
	corner(f)
	return f
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local t = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextColor3 = TEXT,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 18),
	}, parent)
	for k, v in props do
		(t :: any)[k] = v
	end
	return t
end

local function bar(parent: Instance, name: string, color: Color3, order: number)
	local holder = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order }, parent)
	local label = text(holder, { Text = name, Size = UDim2.new(1, 0, 0, 14), TextSize = 12, TextColor3 = MUTED })
	local back = make("Frame", {
		Position = UDim2.new(0, 0, 0, 16),
		Size = UDim2.new(1, 0, 0, 9),
		BackgroundColor3 = Color3.fromRGB(40, 44, 40),
		BorderSizePixel = 0,
	}, holder)
	corner(back, 4)
	local fill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0 }, back)
	corner(fill, 4)
	return { label = label, fill = fill, name = name }
end

local function setBar(b, value: number, suffix: string?)
	b.fill.Size = UDim2.fromScale(math.clamp(value, 0, 1), 1)
	b.label.Text = suffix and (b.name .. "  " .. suffix) or b.name
end

local function edgeFrame(parent: Instance, size: UDim2, pos: UDim2, rotation: number): Frame
	local f = make("Frame", {
		Size = size,
		Position = pos,
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BorderSizePixel = 0,
		BackgroundTransparency = 0,
	}, parent)
	make("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
	}, f)
	return f
end

function Hud.new(player: Player, state: Folder)
	local self = setmetatable({}, Hud)
	self.player = player
	self.state = state

	local gui = make("ScreenGui", {
		Name = "RakeHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))
	self.gui = gui

	-- Vignetta della paura
	local vignette = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0 }, gui)
	edgeFrame(vignette, UDim2.fromScale(0.35, 1), UDim2.fromScale(0, 0), 0)
	edgeFrame(vignette, UDim2.fromScale(0.35, 1), UDim2.fromScale(0.65, 0), 180)
	edgeFrame(vignette, UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0), 90)
	edgeFrame(vignette, UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0.65), 270)
	self.vignette = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, ZIndex = 0 }, gui)
	vignette.Parent = self.vignette

	self.flash = make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 20,
	}, gui)

	-- In alto: fase, orario, obiettivo
	local top = panel(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 104),
		Size = UDim2.new(0, 480, 0, 74),
	})
	padding(top, 10)
	self.phase = text(top, { Font = Enum.Font.GothamBold, TextSize = 17, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center })
	self.objective = text(top, { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center })
	self.progress = text(top, {
		Position = UDim2.new(0, 0, 0, 40),
		Size = UDim2.new(1, 0, 0, 16),
		TextSize = 13,
		TextColor3 = MUTED,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	-- Notifiche
	self.feed = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 186),
		Size = UDim2.new(0, 520, 0, 150),
		BackgroundTransparency = 1,
	}, gui)
	make("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center }, self.feed)

	-- Destra: tracciamento e squadra
	local right = panel(gui, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 130),
		Size = UDim2.new(0, 230, 0, 300),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	padding(right, 10)
	make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, right)
	self.tracking = bar(right, "Tracciamento", Color3.fromRGB(200, 70, 60), 1)
	self.zone = text(right, { LayoutOrder = 2, TextSize = 13 })
	self.coverage = text(right, { LayoutOrder = 3, TextSize = 13 })
	self.cams = text(right, { LayoutOrder = 4, TextSize = 13 })
	self.evidence = text(right, { LayoutOrder = 5, TextSize = 13 })
	self.threat = text(right, { LayoutOrder = 6, TextSize = 13 })
	self.weather = text(right, { LayoutOrder = 7, TextSize = 13 })
	text(right, { LayoutOrder = 8, Text = "SQUADRA", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = MUTED })
	self.team = text(right, { LayoutOrder = 9, TextSize = 13, AutomaticSize = Enum.AutomaticSize.Y, RichText = true })

	-- Sinistra in basso: smartwatch con vitali e attrezzatura
	self.watch = Watch.new(gui)

	-- Centro: messaggi grandi (briefing, braccato)
	self.center = text(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.new(0, 620, 0, 120),
		TextSize = 20,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		RichText = true,
	})

	-- Debriefing
	local debrief = panel(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 400, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		BackgroundTransparency = 0.1,
		ZIndex = 10,
	})
	padding(debrief, 16)
	self.debrief = debrief
	self.debriefText = text(debrief, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		RichText = true,
		TextSize = 15,
		ZIndex = 11,
	})

	self.lastUpdate = 0
	state:GetAttributeChangedSignal("Phase"):Connect(function()
		if state:GetAttribute("Phase") ~= "Debriefing" then
			debrief.Visible = false
		end
	end)
	return self
end

function Hud:notify(message: string)
	local label = text(self.feed, {
		Text = message,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 15,
		TextStrokeTransparency = 0.5,
	})
	local children = {}
	for _, c in self.feed:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(children, c)
		end
	end
	if #children > 5 then
		children[1]:Destroy()
	end
	task.delay(6, function()
		if label.Parent then
			local tween = TweenService:Create(label, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			label:Destroy()
		end
	end)
end

function Hud:pulse()
	self.flash.BackgroundTransparency = 0.2
	TweenService:Create(self.flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
end

local function clock(): string
	local t = Lighting.ClockTime
	return ("%02d:%02d"):format(math.floor(t), math.floor((t % 1) * 60))
end

local STATUS_TEXT = {
	OK = "<font color=\"#8fd18f\">●</font>",
	Braccato = "<font color=\"#ff7060\">⚠ braccato</font>",
	Fuori = "<font color=\"#888888\">✖ fuori</font>",
	Lobby = "<font color=\"#aaaaaa\">○</font>",
}

-- vitals: { stamina, fear, nv, nvOn, exhausted, panic }
function Hud:update(vitals)
	local player, state = self.player, self.state
	self.watch:update(vitals, player)
	self.vignette.GroupTransparency = 1 - math.clamp((vitals.fear - 30) / 70, 0, 1) * 0.85

	local now = os.clock()
	if now - self.lastUpdate < 0.15 then
		return
	end
	self.lastUpdate = now


	local phase = state:GetAttribute("Phase") or "Attesa"
	local timeLeft = state:GetAttribute("TimeLeft") or 0
	local status = player:GetAttribute("Status") or "Lobby"
	if phase == "Attesa" then
		self.phase.Text = "In attesa di giocatori…"
	elseif phase == "Briefing" then
		self.phase.Text = ("Briefing — si parte tra %d s"):format(timeLeft)
	elseif phase == "Notte" then
		self.phase.Text = ("Notte · %s · alba tra %d:%02d"):format(clock(), timeLeft // 60, timeLeft % 60)
	else
		self.phase.Text = ("Debriefing · %d s"):format(timeLeft)
	end
	local objective = state:GetAttribute("Objective")
	self.objective.Text = objective and phase ~= "Attesa" and (objective .. ": " .. (state:GetAttribute("ObjectiveText") or "")) or ""
	self.progress.Text = phase == "Notte" and (state:GetAttribute("ObjectiveProgress") or "") or ""

	local tracking = state:GetAttribute("Tracking") or 0
	setBar(self.tracking, tracking / 100, ("%d%%"):format(math.floor(tracking)))
	local zone = state:GetAttribute("ZoneHint") or ""
	self.zone.Text = "Zona di caccia: " .. (zone ~= "" and zone or "sconosciuta")
	self.coverage.Text = ("Copertura mappa: %d%%"):format(state:GetAttribute("Coverage") or 0)
	self.cams.Text = ("Telecamere attive: %d"):format(state:GetAttribute("CamerasActive") or 0)
	self.evidence.Text = ("Prove documentate: %d"):format(state:GetAttribute("Evidence") or 0)
	self.threat.Text = "Minaccia: " .. (state:GetAttribute("RakeState") or "Assente")
	self.weather.Text = "Meteo: " .. (state:GetAttribute("Weather") or "—")

	local lines = {}
	for _, p in Players:GetPlayers() do
		table.insert(lines, ("%s %s"):format(STATUS_TEXT[p:GetAttribute("Status") or "Lobby"] or "", p.DisplayName))
	end
	self.team.Text = table.concat(lines, "\n")

	-- Messaggio centrale
	if status == "Braccato" then
		local left = math.max(0, math.ceil((player:GetAttribute("DownedUntil") or 0) - workspace:GetServerTimeNow()))
		self.center.Text = ("<font color=\"#ff6a5a\">SEI STATO COLPITO</font>\nUn compagno deve rianimarti entro %d s"):format(left)
	elseif status == "Fuori" and phase == "Notte" then
		self.center.Text = "Sei fuori gioco. Osservi i compagni: puoi aprire il tablet [T] per aiutarli."
	elseif phase == "Briefing" then
		self.center.Text = "<font size=\"16\">1 Torcia · 2 Telecamera · 3 Fucile a dardi · 4 Tablet\n"
			.. "Shift scatto · T tablet · N visore · R tipo di camera · E interagisci</font>"
	else
		self.center.Text = ""
	end
end

function Hud:showDebrief(data)
	local lines = {
		data.won and "<font size=\"22\" color=\"#8fd18f\"><b>MISSIONE COMPIUTA</b></font>"
			or "<font size=\"22\" color=\"#ff7060\"><b>MISSIONE FALLITA</b></font>",
		data.reason,
		"",
		"<b>Obiettivo:</b> " .. tostring(data.objective),
		"",
	}
	for _, row in data.breakdown do
		table.insert(lines, ("%s: +%d XP"):format(row[1], row[2]))
	end
	table.insert(lines, "")
	table.insert(lines, ("<b>Totale: +%d XP</b>%s"):format(data.xp, data.halved and " (dimezzati per la sconfitta)" or ""))
	table.insert(lines, ("Rango: <b>%s</b> · Livello %d · %d XP"):format(data.rank, data.level, data.totalXP))
	if data.nextXP then
		table.insert(lines, ("Prossimo rango a %d XP"):format(data.nextXP))
	end
	self.debriefText.Text = table.concat(lines, "\n")
	self.debrief.Visible = true
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">MapView</string><ProtectedString name="Source"><![CDATA[-- Mappa del tablet: biomi, lago, sentieri, punti di interesse (toccali per sceglierli come
-- destinazione), percorso giallo da seguire, la tua freccia, compagni, telecamere con il loro
-- cono visivo, area di caccia e ultimo avvistamento.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Nav = require(script.Parent:WaitForChild("Nav"))

local MapView = {}
MapView.__index = MapView

local HALF = Config.MAP.SIZE / 2
local YELLOW = Color3.fromRGB(255, 215, 70)

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

local function round(parent: Instance)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, parent)
end

function MapView.new(parent: Instance, size: number, zIndex: number)
	local self = setmetatable({}, MapView)
	self.size = size
	self.z = zIndex
	local frame = make("Frame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Color3.fromRGB(16, 24, 18),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = zIndex,
	}, parent)
	make("UIStroke", { Color = Color3.fromRGB(150, 255, 180), Transparency = 0.5 }, frame)
	self.frame = frame
	local function z(n: number): number
		return zIndex + n
	end
	-- biomi
	local biomes = {
		{ 0.5, 0, Color3.fromRGB(26, 46, 28), "PINETA" },
		{ 0, 0, Color3.fromRGB(34, 44, 26), "CAMPEGGIO" },
		{ 0, 0.5, Color3.fromRGB(30, 34, 24), "PALUDE" },
		{ 0.5, 0.5, Color3.fromRGB(38, 38, 34), "MINIERA" },
	}
	for _, b in biomes do
		local f = make("Frame", { Position = UDim2.fromScale(b[1], b[2]), Size = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = b[3], BorderSizePixel = 0, ZIndex = z(0) }, frame)
		make("TextLabel", {
			Position = UDim2.fromScale(b[1] == 0 and 0.04 or 0.55, b[2] == 0 and 0.03 or 0.92),
			Size = UDim2.fromOffset(100, 12),
			BackgroundTransparency = 1,
			Text = b[4],
			Font = Enum.Font.GothamBold,
			TextSize = math.max(8, size / 40),
			TextColor3 = Color3.fromRGB(120, 140, 120),
			TextTransparency = 0.3,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = z(1),
		}, frame)
		f.Name = b[4]
	end
	-- griglia ogni 100 stud
	for i = 1, 7 do
		make("Frame", { Position = UDim2.fromScale(i / 8, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.94, BorderSizePixel = 0, ZIndex = z(1) }, frame)
		make("Frame", { Position = UDim2.fromScale(0, i / 8), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.94, BorderSizePixel = 0, ZIndex = z(1) }, frame)
	end
	local lake = Config.MAP.LAKE
	local lx, ly = self:toPx(lake.center)
	local lr = lake.radius / (HALF * 2) * size * 2
	local lakeFrame = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(lx, ly), Size = UDim2.fromOffset(lr, lr), BackgroundColor3 = Color3.fromRGB(30, 62, 92), BorderSizePixel = 0, ZIndex = z(2) }, frame)
	round(lakeFrame)
	-- sentieri
	for _, pair in Nav.PATHS do
		self:line(Nav.POIS[pair[1]].pos, Nav.POIS[pair[2]].pos, Color3.fromRGB(150, 118, 78), math.max(2, size / 110), z(3), frame)
	end
	self.routeLayer = make("Folder", { Name = "Percorso" }, frame)
	self.dynamic = make("Folder", { Name = "Dinamici" }, frame)
	-- punti di interesse (pulsanti)
	for i, poi in Nav.POIS do
		local x, y = self:toPx(poi.pos)
		local button = make("TextButton", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(math.max(18, size / 16), math.max(18, size / 16)),
			BackgroundColor3 = Color3.fromRGB(235, 225, 190),
			Text = Nav.ICONS[i],
			TextSize = math.max(11, size / 26),
			AutoButtonColor = true,
			ZIndex = z(6),
		}, frame)
		round(button)
		make("UIStroke", { Color = Color3.fromRGB(40, 30, 20), Thickness = 1.5 }, button)
		make("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 1, 1),
			Size = UDim2.fromOffset(120, 12),
			BackgroundTransparency = 1,
			Text = poi.name,
			Font = Enum.Font.GothamBold,
			TextSize = math.max(8, size / 42),
			TextColor3 = Color3.fromRGB(240, 235, 215),
			TextStrokeTransparency = 0.3,
			ZIndex = z(6),
		}, button)
		button.Activated:Connect(function()
			if Nav.manual and Nav.manual.poi == i then
				Nav.clear()
			else
				Nav.setPoi(i)
			end
			self.nextRoute = 0
		end)
	end
	self.info = make("TextLabel", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 6, 1, -4),
		Size = UDim2.new(1, -12, 0, 14),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		TextSize = math.max(10, size / 34),
		TextColor3 = YELLOW,
		TextStrokeTransparency = 0.4,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = z(9),
	}, frame)
	make("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 4),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		Text = "N▲",
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(255, 120, 100),
		ZIndex = z(9),
	}, frame)
	self.nextRoute = 0
	return self
end

function MapView:toPx(p: Vector3): (number, number)
	return (p.X + HALF) / (HALF * 2) * self.size, (p.Z + HALF) / (HALF * 2) * self.size
end

function MapView:line(a: Vector3, b: Vector3, color: Color3, thickness: number, z: number, parent: Instance)
	local ax, ay = self:toPx(a)
	local bx, by = self:toPx(b)
	local dx, dy = bx - ax, by - ay
	local len = math.sqrt(dx * dx + dy * dy)
	return make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2),
		Size = UDim2.fromOffset(len, thickness),
		Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = z,
	}, parent)
end

function MapView:dot(p: Vector3, size: number, color: Color3, z: number, roundIt: boolean?): Frame
	local x, y = self:toPx(p)
	local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size, size), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z }, self.dynamic)
	if roundIt then
		round(f)
	end
	return f
end

function MapView:update(player: Player, state: Folder, selectedCam: Model?)
	local z = self.z
	local s = self.size
	self.dynamic:ClearAllChildren()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local origin = hrp and hrp.Position or workspace.CurrentCamera.CFrame.Position

	-- percorso verso la destinazione
	local dest = Nav.destination(state)
	local now = os.clock()
	if now >= self.nextRoute then
		self.nextRoute = now + 0.5
		self.routeLayer:ClearAllChildren()
		if dest then
			local points, total = Nav.route(origin, dest.pos)
			for i = 2, #points do
				self:line(points[i - 1], points[i], YELLOW, math.max(3, s / 80), z + 4, self.routeLayer)
			end
			self.info.Text = ("▶ %s · %d m"):format(dest.name, Nav.meters(total))
		else
			self.info.Text = "Tocca un luogo per tracciare il percorso"
		end
	end
	if dest then
		local f = self:dot(dest.pos, math.max(10, s / 30), YELLOW, z + 5)
		f.Rotation = 45
	end

	local hintR = state:GetAttribute("HintR") or 0
	if hintR > 0 then
		local area = self:dot(Vector3.new(state:GetAttribute("HintX") or 0, 0, state:GetAttribute("HintZ") or 0), hintR / HALF * s, Color3.fromRGB(255, 40, 40), z + 3, true)
		area.BackgroundTransparency = 0.7
	end
	local seenAt = state:GetAttribute("LastSeenTime") or 0
	local age = workspace:GetServerTimeNow() - seenAt
	if seenAt > 0 and age < 60 then
		local x = self:dot(Vector3.new(state:GetAttribute("LastSeenX") or 0, 0, state:GetAttribute("LastSeenZ") or 0), math.max(8, s / 30), Color3.fromRGB(255, 60, 60), z + 7)
		x.Rotation = 45
		x.BackgroundTransparency = math.clamp(age / 60, 0, 0.8)
	end
	-- telecamere con cono visivo
	local world = workspace:FindFirstChild("RakeHunt")
	local cams = world and world:FindFirstChild("Telecamere")
	if cams then
		for _, m in cams:GetChildren() do
			local body = m:FindFirstChild("Body") :: BasePart?
			if body then
				local color = Color3.fromRGB(90, 170, 255)
				if not m:GetAttribute("Online") then
					color = Color3.fromRGB(90, 90, 90)
				elseif m:GetAttribute("Sees") then
					color = Color3.fromRGB(255, 70, 50)
				end
				if m == selectedCam then
					color = Color3.fromRGB(255, 255, 255)
				end
				local look = body.CFrame.LookVector * Vector3.new(1, 0, 1)
				if look.Magnitude > 0.1 and m:GetAttribute("Type") ~= "Trappola" then
					for _, ang in { -0.6, 0.6 } do
						local edge = CFrame.Angles(0, ang, 0) * look.Unit
						local ray = self:line(body.Position, body.Position + edge * 70, color, 1, z + 5, self.dynamic)
						ray.BackgroundTransparency = 0.5
					end
				end
				self:dot(body.Position, math.max(6, s / 45), color, z + 6, true)
			end
		end
	end
	for _, p in Players:GetPlayers() do
		local phrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local status = p:GetAttribute("Status")
		if phrp and status ~= "Fuori" and p ~= player then
			self:dot(phrp.Position, math.max(7, s / 40), status == "Braccato" and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(110, 230, 110), z + 7, true)
		end
	end
	-- la tua freccia
	local x, y = self:toPx(origin)
	local look = workspace.CurrentCamera.CFrame.LookVector
	if hrp then
		look = hrp.CFrame.LookVector
	end
	make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Text = "▲",
		TextSize = math.max(14, s / 22),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextStrokeTransparency = 0,
		Rotation = math.deg(math.atan2(look.X, -look.Z)),
		ZIndex = z + 8,
	}, self.dynamic)
end

return MapView
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">Nav</string><ProtectedString name="Source"><![CDATA[-- Navigazione condivisa da bussola e mappa del tablet: destinazione scelta (o automatica in base
-- all'obiettivo) e percorso lungo la rete dei sentieri (Dijkstra sui punti di interesse).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Nav = {}

local POIS = Config.MAP.POIS
local PATHS = Config.MAP.PATHS
Nav.POIS = POIS
Nav.PATHS = PATHS
Nav.ICONS = { "🏠", "🗼", "⛺", "🌊", "🛖", "⛏" }
Nav.STUD_TO_METERS = 0.28

-- nil = automatica; altrimenti { name, pos } scelta toccando la mappa
Nav.manual = nil :: { name: string, pos: Vector3, poi: number? }?

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function Nav.meters(studs: number): number
	return math.floor(studs * Nav.STUD_TO_METERS + 0.5)
end

function Nav.setPoi(index: number)
	Nav.manual = { name = POIS[index].name, pos = POIS[index].pos, poi = index }
end

function Nav.clear()
	Nav.manual = nil
end

-- Destinazione corrente: scelta a mano, oppure suggerita dall'obiettivo della notte
function Nav.destination(state: Folder): { name: string, pos: Vector3, poi: number? }?
	if Nav.manual then
		return Nav.manual
	end
	local player = Players.LocalPlayer
	local objective = state:GetAttribute("Objective")
	if objective == "Reperto" then
		if player:GetAttribute("CarryingTape") then
			return { name = "Ranger Station", pos = POIS[1].pos, poi = 1 }
		end
		local world = workspace:FindFirstChild("RakeHunt")
		local tape = world and world:FindFirstChild("NastroAudio")
		local part = tape and tape:FindFirstChild("Nastro") :: BasePart?
		if part then
			return { name = "Nastro audio", pos = part.Position }
		end
	end
	if (state:GetAttribute("HintR") or 0) > 0 then
		return { name = "Area di caccia", pos = Vector3.new(state:GetAttribute("HintX") or 0, 0, state:GetAttribute("HintZ") or 0) }
	end
	local seenAt = state:GetAttribute("LastSeenTime") or 0
	if seenAt > 0 and workspace:GetServerTimeNow() - seenAt < 60 then
		return { name = "Ultimo avvistamento", pos = Vector3.new(state:GetAttribute("LastSeenX") or 0, 0, state:GetAttribute("LastSeenZ") or 0) }
	end
	return nil
end

-- Punto più vicino sulla rete dei sentieri: posizione, indice del segmento, distanza
local function project(p: Vector3)
	local best, bestSeg, bestPoint = math.huge, 1, POIS[1].pos
	for i, pair in PATHS do
		local a, b = flat(POIS[pair[1]].pos), flat(POIS[pair[2]].pos)
		local ab = b - a
		local t = math.clamp((flat(p) - a):Dot(ab) / ab:Dot(ab), 0, 1)
		local q = a + ab * t
		local d = (flat(p) - q).Magnitude
		if d < best then
			best, bestSeg, bestPoint = d, i, q
		end
	end
	return bestPoint, bestSeg, best
end

-- Percorso dal punto `from` alla destinazione: lista di punti (piatti) e lunghezza totale in stud
function Nav.route(from: Vector3, to: Vector3): ({ Vector3 }, number)
	local start = flat(from)
	local goal = flat(to)
	if (goal - start).Magnitude < 45 then
		return { start, goal }, (goal - start).Magnitude
	end
	local entry, entrySeg = project(start)
	local exit, exitSeg = project(goal)
	-- nodi: 1..#POIS, poi S (ingresso) e T (uscita)
	local n = #POIS
	local S, Tn = n + 1, n + 2
	local pos = {}
	for i, poi in POIS do
		pos[i] = flat(poi.pos)
	end
	pos[S], pos[Tn] = entry, exit
	local edges: { [number]: { { number } } } = {}
	local function link(a: number, b: number)
		local w = (pos[a] - pos[b]).Magnitude
		edges[a] = edges[a] or {}
		edges[b] = edges[b] or {}
		table.insert(edges[a], { b, w })
		table.insert(edges[b], { a, w })
	end
	for i, pair in PATHS do
		if i ~= entrySeg and i ~= exitSeg then
			link(pair[1], pair[2])
		end
	end
	local function splitSegment(segIndex: number, node: number)
		local pair = PATHS[segIndex]
		link(node, pair[1])
		link(node, pair[2])
	end
	splitSegment(entrySeg, S)
	splitSegment(exitSeg, Tn)
	if entrySeg == exitSeg then
		link(S, Tn)
		-- il segmento originale serve ancora per gli altri percorsi
		link(PATHS[entrySeg][1], PATHS[entrySeg][2])
	else
		-- gli estremi dei due segmenti divisi restano collegati tra loro attraverso S e T
	end
	local dist, prev, done = { [S] = 0 }, {}, {}
	while true do
		local u, best = nil, math.huge
		for node, d in dist do
			if not done[node] and d < best then
				u, best = node, d
			end
		end
		if not u or u == Tn then
			break
		end
		done[u] = true
		for _, e in edges[u] or {} do
			local v, w = e[1], e[2]
			if not dist[v] or best + w < dist[v] then
				dist[v] = best + w
				prev[v] = u
			end
		end
	end
	local points = { goal }
	local node = Tn
	while node do
		table.insert(points, 1, pos[node])
		node = prev[node]
	end
	table.insert(points, 1, start)
	local total = 0
	for i = 2, #points do
		total += (points[i] - points[i - 1]).Magnitude
	end
	return points, total
end

-- Prossimo punto del percorso a più di 12 stud dal giocatore (dove "puntare")
function Nav.nextWaypoint(points: { Vector3 }, from: Vector3): Vector3
	for i = 2, #points do
		if (points[i] - flat(from)).Magnitude > 12 then
			return points[i]
		end
	end
	return points[#points]
end

return Nav
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">RakeAnimator</string><ProtectedString name="Source"><![CDATA[-- Animazione di The Rake (solo client, Bone.Transform sulle 40 ossa): movimenti violenti e a scatti.
-- La posa non viene interpolata: salta da una posa all'altra a intervalli irregolari (stop-motion),
-- con perturbazioni casuali enormi. Andatura sconclusionata, testa che ciondola e si capovolge,
-- convulsioni quando si mostra, braccia che si agitano quando carica, posa da jumpscare quando attacca.
-- Le ossa importate sono ruotate di 180 gradi attorno a Y: gli angoli di progetto (x, y, z) diventano
-- CFrame.Angles(-x, y, -z) nello spazio dell'osso.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sfx = require(Shared:WaitForChild("Sfx"))

local RakeAnimator = {}

local EYE_COLORS = {
	Inattiva = Color3.fromRGB(255, 240, 220),
	Curiosa = Color3.fromRGB(255, 240, 220),
	Territoriale = Color3.fromRGB(255, 170, 70),
	Aggressiva = Color3.fromRGB(255, 30, 20),
	Attacco = Color3.fromRGB(255, 10, 10),
	Fuga = Color3.fromRGB(255, 240, 220),
	Stordita = Color3.fromRGB(40, 40, 40),
	Catturata = Color3.fromRGB(40, 40, 40),
}

local function rot(x: number, y: number, z: number): CFrame
	return CFrame.Angles(-x, y, -z)
end

local function r(amount: number): number
	return (math.random() - 0.5) * 2 * amount
end

local FINGERS = {}
for f = 0, 3 do
	for _, side in { "L", "R" } do
		table.insert(FINGERS, { "Fing" .. f .. side .. "A", "Fing" .. f .. side .. "B" })
	end
end

function RakeAnimator.start(state: Folder)
	local model: Model? = nil
	local bones: { [string]: Bone } = {}
	local eyes: { BasePart } = {}
	local phase = 0
	local nextSnap = 0
	local quirk = { headFlip = 0, armUp = "L", lean = 0 }
	local quirkUntil = 0
	local convulseUntil, nextConvulse = 0, 0
	local lastStatus = ""
	local stateStart = 0
	local nextCrack = 0

	local function clearEyes()
		for _, e in eyes do
			e:Destroy()
		end
		table.clear(eyes)
	end

	local function attach(rake: Model)
		model = rake
		table.clear(bones)
		clearEyes()
		for _, d in rake:GetDescendants() do
			if d:IsA("Bone") then
				bones[d.Name] = d
			end
		end
		for i = 1, 2 do
			local eye = Instance.new("Part")
			eye.Name = "OcchioLocale"
			eye.Shape = Enum.PartType.Ball
			eye.Size = Vector3.new(0.12, 0.12, 0.12)
			eye.Material = Enum.Material.Neon
			eye.Anchored = true
			eye.CanCollide = false
			eye.CanQuery = false
			eye.CanTouch = false
			eye.CastShadow = false
			eye.Parent = workspace
			if i == 1 then
				local glow = Instance.new("PointLight")
				glow.Range = 7
				glow.Brightness = 1.4
				glow.Parent = eye
			end
			table.insert(eyes, eye)
		end
	end

	local function apply(pose: { [string]: CFrame })
		for name, bone in bones do
			bone.Transform = pose[name] or CFrame.new()
		end
	end

	local function update(dt: number)
		local folder = workspace:FindFirstChild("RakeHunt")
		local rake = folder and folder:FindFirstChild("TheRake") :: Model?
		if rake ~= model then
			if rake then
				attach(rake)
			else
				model = nil
				clearEyes()
			end
		end
		if not rake then
			return
		end
		local root = rake:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = rake:FindFirstChildOfClass("Humanoid")
		local head = bones.Head
		if not root or not hum or not head then
			return
		end
		local now = os.clock()
		local status = state:GetAttribute("RakeState") or "Inattiva"
		if status ~= lastStatus then
			lastStatus = status
			stateStart = now
			nextSnap = 0
		end
		local vel = root.AssemblyLinearVelocity
		local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
		local a = math.clamp(speed / 12, 0, 1.4)
		phase += dt * (2 + speed * 0.42)

		-- occhi nelle orbite (sempre fluidi)
		local color = EYE_COLORS[status] or EYE_COLORS.Inattiva
		local headCF = head.TransformedWorldCFrame
		for i, eye in eyes do
			local side = i == 1 and -1 or 1
			eye.CFrame = headCF * CFrame.new(-side * 0.15, 0.34, 0.66)
			eye.Color = color
			local glow = eye:FindFirstChildOfClass("PointLight")
			if glow then
				glow.Color = color
			end
		end

		if now < nextSnap then
			return -- mantiene la posa: movimento a scatti
		end
		local violent = status == "Aggressiva" or status == "Attacco"
		local interval = violent and (0.025 + math.random() * 0.04) or (0.06 + math.random() * 0.12)
		if math.random() < 0.08 then
			interval += 0.15 + math.random() * 0.25 -- "congelamenti" improvvisi
		end
		nextSnap = now + interval

		-- tic che durano qualche secondo: testa capovolta, braccio alzato, inclinazione
		if now > quirkUntil then
			quirkUntil = now + 1 + math.random() * 3
			quirk.headFlip = math.random() < 0.3 and (math.random() < 0.5 and 2.6 or -2.4) or r(1.1)
			quirk.armUp = math.random() < 0.5 and "L" or "R"
			quirk.lean = r(0.45)
		end
		local s, c = math.sin(phase), math.cos(phase)
		local pose: { [string]: CFrame } = {}
		local function set(name: string, x: number, y: number, z: number)
			pose[name] = rot(x, y, z)
		end

		if hum.PlatformStand or status == "Stordita" or status == "Catturata" then
			for name in bones do
				if math.random() < 0.35 then
					set(name, r(0.5), r(0.5), r(0.5))
				end
			end
			set("Jaw", -0.7 - math.random() * 0.2, 0, 0)
			apply(pose)
			return
		end

		local camPos = workspace.CurrentCamera.CFrame.Position
		local toCam = camPos - headCF.Position
		local local_ = root.CFrame:VectorToObjectSpace(toCam.Unit)
		local yawToCam = math.clamp(math.atan2(-local_.X, -local_.Z), -1.5, 1.5)
		local pitchToCam = math.clamp(math.asin(math.clamp(local_.Y, -1, 1)), -0.6, 0.8)
		local fingersOpen = 0.2

		if status == "Attacco" then
			-- jumpscare: braccia spalancate sopra la testa, fauci al massimo, tremore violento
			set("Spine1", -0.35 + r(0.15), r(0.2), r(0.15))
			set("Spine2", -0.3 + r(0.15), r(0.2), r(0.2))
			set("Spine3", -0.2 + r(0.2), r(0.2), r(0.2))
			set("Neck1", 0.6 + r(0.2), r(0.2), r(0.3))
			set("Neck2", 0.2 + r(0.3), r(0.4), r(0.4))
			set("Head", pitchToCam + r(0.35), yawToCam * 0.5 + r(0.6), r(0.8))
			set("Jaw", -0.95 - math.random() * 0.15, r(0.08), 0)
			set("ShoulderL", 2.5 + r(0.4), r(0.4), -0.9 + r(0.3))
			set("ShoulderR", 2.5 + r(0.4), r(0.4), 0.9 + r(0.3))
			set("ElbowL", 0.6 + r(0.4), 0, 0)
			set("ElbowR", 0.6 + r(0.4), 0, 0)
			set("WristL", r(0.6), r(0.6), 0)
			set("WristR", r(0.6), r(0.6), 0)
			set("KneeL", -0.5 + r(0.2), 0, 0)
			set("KneeR", -0.5 + r(0.2), 0, 0)
			fingersOpen = -0.4
		elseif status == "Aggressiva" or status == "Fuga" then
			-- corsa a quattro arti: busto quasi orizzontale, braccia che si agitano, testa che trema
			local charging = status == "Aggressiva"
			set("Spine1", -0.45 + r(0.15), s * 0.2 + r(0.2), quirk.lean * 0.5 + r(0.2))
			set("Spine2", -0.4 + r(0.15), r(0.25), r(0.2))
			set("Spine3", -0.3 + r(0.2), r(0.25), r(0.2))
			set("Neck1", 0.8 + r(0.2), r(0.2), 0)
			set("Neck2", 0.2 + r(0.2), r(0.3), r(0.3))
			if charging then
				set("Head", pitchToCam * 0.5 + r(0.4), yawToCam * 0.4 + r(0.7), r(0.9))
				set("Jaw", -0.6 - math.random() * 0.35, r(0.1), 0)
				set("ShoulderL", 1.3 + s * 0.9 + r(0.7), r(0.5), -0.3 + r(0.4))
				set("ShoulderR", 1.3 - s * 0.9 + r(0.7), r(0.5), 0.3 + r(0.4))
			else
				set("Head", r(0.3), (math.random() < 0.4 and 2.2 or 0) + r(0.4), r(0.5)) -- si guarda alle spalle
				set("Jaw", -0.15 + r(0.15), 0, 0)
				set("ShoulderL", -0.6 + s * 0.8 + r(0.5), r(0.4), -0.4 + r(0.3))
				set("ShoulderR", -0.6 - s * 0.8 + r(0.5), r(0.4), 0.4 + r(0.3))
			end
			set("ElbowL", 0.3 + math.max(0, s) * 0.9 + r(0.4), 0, 0)
			set("ElbowR", 0.3 + math.max(0, -s) * 0.9 + r(0.4), 0, 0)
			set("WristL", r(0.7), r(0.7), 0)
			set("WristR", r(0.7), r(0.7), 0)
			set("HipL", s * 1.0 * a + r(0.25), r(0.15), r(0.15))
			set("HipR", -s * 1.0 * a + r(0.25), r(0.15), r(0.15))
			set("KneeL", -math.max(0, c) * 1.4 * a - 0.2 + r(0.25), 0, 0)
			set("KneeR", -math.max(0, -c) * 1.4 * a - 0.2 + r(0.25), 0, 0)
			set("AnkleL", math.max(0, c) * 0.6 + r(0.2), 0, 0)
			set("AnkleR", math.max(0, -c) * 0.6 + r(0.2), 0, 0)
			fingersOpen = charging and -0.3 or 0.4
		elseif status == "Territoriale" and speed < 3 then
			-- si mostra: immobile, la testa si piega fino all'estremo, poi convulsioni violente
			local t = now - stateStart
			if now > nextConvulse then
				nextConvulse = now + 0.9 + math.random() * 1.4
				convulseUntil = now + 0.25 + math.random() * 0.3
			end
			local shake = now < convulseUntil and 1 or 0
			local tilt = math.min(t * 0.7, 1.6) * (quirk.headFlip >= 0 and 1 or -1)
			set("Spine1", -0.15 + r(0.5) * shake, r(0.4) * shake, r(0.4) * shake)
			set("Spine2", -0.2 + r(0.5) * shake, r(0.3) * shake, r(0.3) * shake)
			set("Spine3", -0.25 + r(0.4) * shake, 0, r(0.4) * shake)
			set("Neck1", 0.35 + r(0.3) * shake, 0, 0)
			set("Neck2", pitchToCam * 0.4, yawToCam * 0.45, 0)
			set("Head", pitchToCam * 0.5 + r(0.08) + r(0.6) * shake, yawToCam * 0.5 + r(0.08), tilt + r(0.9) * shake)
			set("Jaw", -math.min(t * 0.35, 0.8) - math.abs(r(0.3)) * shake, 0, 0)
			set("ShoulderL", 0.2 + r(0.15) + r(1.2) * shake, r(0.2), -0.35 + r(0.6) * shake)
			set("ShoulderR", 0.2 + r(0.15) + r(1.2) * shake, r(0.2), 0.35 + r(0.6) * shake)
			set("ElbowL", 0.25 + r(0.2) + r(0.8) * shake, 0, 0)
			set("ElbowR", 0.25 + r(0.2) + r(0.8) * shake, 0, 0)
			set("WristL", r(0.4), r(0.4), 0)
			set("WristR", r(0.4), r(0.4), 0)
			set("KneeL", -0.3 + r(0.3) * shake, 0, 0)
			set("KneeR", -0.3 + r(0.3) * shake, 0, 0)
			fingersOpen = 0.1 + r(0.5)
			if shake > 0 and now > nextCrack and toCam.Magnitude < 70 then
				nextCrack = now + 0.6
				Sfx.at("BoneCrack", headCF.Position, { Volume = 1.5, PlaybackSpeed = 0.7 + math.random() * 0.6, RollOffMaxDistance = 70 })
			end
		else
			-- andatura sconclusionata: zoppa, contorta, con un braccio che si agita
			local limp = 1 + 0.5 * math.max(0, math.sin(phase * 0.5))
			set("Spine1", -0.15 + r(0.12), s * 0.3 * a + r(0.15), quirk.lean + s * 0.25 * a + r(0.12))
			set("Spine2", -0.15 + r(0.12), r(0.2), -quirk.lean * 0.5 + r(0.15))
			set("Spine3", -0.2 + r(0.12), r(0.2), r(0.15))
			set("Neck1", 0.3 + r(0.15), r(0.15), 0)
			set("Neck2", pitchToCam * 0.3 + r(0.2), (toCam.Magnitude < 70 and yawToCam * 0.4 or 0) + r(0.3), r(0.3))
			set("Head", r(0.25), (toCam.Magnitude < 70 and yawToCam * 0.5 or r(0.6)), quirk.headFlip + r(0.25))
			set("Jaw", -0.05 - math.abs(r(0.25)), 0, 0)
			local up = quirk.armUp
			local flail = 1.4 + r(0.9)
			set("ShoulderL", up == "L" and flail or (-s * 0.5 * a + r(0.35)), r(0.4), up == "L" and -0.7 + r(0.4) or -0.1 + r(0.2))
			set("ShoulderR", up == "R" and flail or (s * 0.5 * a + r(0.35)), r(0.4), up == "R" and 0.7 + r(0.4) or 0.1 + r(0.2))
			set("ElbowL", 0.2 + math.max(0, s) * 0.5 * a + r(0.45), 0, 0)
			set("ElbowR", 0.2 + math.max(0, -s) * 0.5 * a + r(0.45), 0, 0)
			set("WristL", r(0.6), r(0.5), 0)
			set("WristR", r(0.6), r(0.5), 0)
			set("HipL", s * 0.85 * a * limp + r(0.2), r(0.2), -0.1 + r(0.1))
			set("HipR", -s * 0.55 * a + r(0.2), r(0.2), 0.1 + r(0.1))
			set("KneeL", -math.max(0, c) * 1.3 * a * limp + r(0.2), 0, 0)
			set("KneeR", -math.max(0, -c) * 0.9 * a + r(0.2), 0, 0)
			set("AnkleL", math.max(0, c) * 0.5 * a + r(0.2), 0, 0)
			set("AnkleR", math.max(0, -c) * 0.5 * a + r(0.2), 0, 0)
			fingersOpen = 0.3 + r(0.4)
		end
		for _, f in FINGERS do
			set(f[1], fingersOpen + r(0.5), 0, r(0.25))
			set(f[2], fingersOpen * 1.3 + r(0.6), 0, 0)
		end
		apply(pose)
	end

	RakeAnimator.update = update
	RunService.Stepped:Connect(function(_, dt)
		update(dt)
	end)
end

return RakeAnimator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">Scares</string><ProtectedString name="Source"><![CDATA[-- Spaventi locali: jumpscare quando la creatura ti abbatte (la visuale viene strappata sulla sua
-- faccia, urlo distorto, tremore e lampi rossi) e stacco musicale quando ti si mostra davanti.
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sfx = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sfx"))

local Scares = {}

local function rakeParts()
	local folder = workspace:FindFirstChild("RakeHunt")
	local rake = folder and folder:FindFirstChild("TheRake")
	local root = rake and rake:FindFirstChild("HumanoidRootPart") :: BasePart?
	local head = rake and rake:FindFirstChild("Head", true)
	return root, (head and head:IsA("Bone")) and head or nil
end

function Scares.start(player: Player, state: Folder, onFlash: () -> ())
	local gui = Instance.new("ScreenGui")
	gui.Name = "Jumpscare"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20
	gui.Parent = player:WaitForChild("PlayerGui")
	local red = Instance.new("Frame")
	red.Size = UDim2.fromScale(1, 1)
	red.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
	red.BackgroundTransparency = 1
	red.BorderSizePixel = 0
	red.Parent = gui
	local active = false

	local function jumpscare()
		local root, head = rakeParts()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if active or not root or not head or not hrp or (root.Position - hrp.Position).Magnitude > 18 then
			return
		end
		active = true
		local camera = workspace.CurrentCamera
		local savedType, savedFov = camera.CameraType, camera.FieldOfView
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = 52
		Sfx.new("Jumpscare", SoundService, { Volume = 2.6, PlayOnRemove = true }):Destroy()
		onFlash()
		local start = os.clock()
		RunService:BindToRenderStep("Jumpscare", Enum.RenderPriority.Camera.Value + 10, function()
			local t = os.clock() - start
			local headCF = head.TransformedWorldCFrame
			local face = root.CFrame.LookVector
			local eyePos = headCF.Position
			local shake = math.max(0.05, 0.35 * (1 - t / 1.3))
			local camPos = eyePos + face * (2.2 - math.min(t, 0.25) * 2) + Vector3.new(0, 0.15, 0)
			camera.CFrame = CFrame.lookAt(camPos, eyePos) * CFrame.Angles((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, (math.random() - 0.5) * shake * 1.5)
			red.BackgroundTransparency = (math.floor(t * 18) % 2 == 0) and 0.55 or 0.85
		end)
		task.delay(1.3, function()
			RunService:UnbindFromRenderStep("Jumpscare")
			red.BackgroundTransparency = 1
			camera.CameraType = savedType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or savedType
			camera.FieldOfView = savedFov
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				camera.CameraSubject = hum
			end
			active = false
		end)
	end

	player:GetAttributeChangedSignal("Status"):Connect(function()
		if player:GetAttribute("Status") == "Braccato" then
			jumpscare()
		end
	end)

	-- stacco musicale quando si mostra immobile nel tuo campo visivo
	local stung = false
	RunService.Heartbeat:Connect(function()
		if state:GetAttribute("RakeState") ~= "Territoriale" then
			stung = false
			return
		end
		if stung then
			return
		end
		local root = rakeParts()
		if not root or root.AssemblyLinearVelocity.Magnitude > 3 then
			return
		end
		local camera = workspace.CurrentCamera
		local to = root.Position - camera.CFrame.Position
		if to.Magnitude < 70 and camera.CFrame.LookVector:Dot(to.Unit) > 0.6 then
			stung = true
			Sfx.new("Sting", SoundService, { Volume = 1.6, PlayOnRemove = true }):Destroy()
		end
	end)
end

return Scares
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">Scope</string><ProtectedString name="Source"><![CDATA[-- Mirino telescopico del fucile a dardi: tasto destro (o pulsante "Mirino") con il fucile in mano.
-- Prima persona, zoom 2x-8x con la rotella, reticolo con tacche, oscillazione del respiro che
-- cresce con paura e fiatone, leggera intensificazione della luce.
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Sfx = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sfx"))

local Scope = {}
Scope.__index = Scope

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

function Scope.new(player: Player)
	local self = setmetatable({}, Scope)
	self.player = player
	self.active = false
	self.zoom = 4
	self.sway = 0

	local gui = make("ScreenGui", { Name = "Mirino", ResetOnSpawn = false, IgnoreGuiInset = true, Enabled = false, DisplayOrder = 4 }, player:WaitForChild("PlayerGui"))
	self.gui = gui
	-- lente circolare: tutto il resto è coperto da un bordo nero spessissimo
	local lens = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.78, 0.78),
		BackgroundTransparency = 1,
	}, gui)
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, lens)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, lens)
	make("UIStroke", { Thickness = 3000, Color = Color3.new(0, 0, 0) }, lens)
	self.lens = lens
	-- anello interno e vignetta della lente
	local ring = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, lens)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ring)
	make("UIStroke", { Thickness = 26, Color = Color3.fromRGB(0, 0, 0), Transparency = 0.25 }, ring)
	local inner = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.94, 0.94), BackgroundTransparency = 1 }, lens)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, inner)
	make("UIStroke", { Thickness = 40, Color = Color3.fromRGB(0, 0, 0), Transparency = 0.6 }, inner)
	-- riflesso sul vetro
	local glare = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(140, 170, 255), BackgroundTransparency = 0.94 }, lens)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, glare)
	make("UIGradient", { Rotation = 35, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(1, 1) }) }, glare)

	-- reticolo
	local ink = Color3.fromRGB(10, 10, 10)
	local function line(pos: UDim2, size: UDim2)
		make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = size, BackgroundColor3 = ink, BorderSizePixel = 0 }, lens)
	end
	line(UDim2.fromScale(0.5, 0.5), UDim2.new(1, 0, 0, 1))
	line(UDim2.fromScale(0.5, 0.5), UDim2.new(0, 1, 1, 0))
	line(UDim2.fromScale(0.13, 0.5), UDim2.new(0.26, 0, 0, 4))
	line(UDim2.fromScale(0.87, 0.5), UDim2.new(0.26, 0, 0, 4))
	line(UDim2.fromScale(0.5, 0.87), UDim2.new(0, 4, 0.26, 0))
	for i = -4, 4 do
		if i ~= 0 then
			local len = i % 2 == 0 and 14 or 8
			line(UDim2.new(0.5 + i * 0.035, 0, 0.5, 0), UDim2.fromOffset(1, len))
			line(UDim2.new(0.5, 0, 0.5 + i * 0.035, 0), UDim2.fromOffset(len, 1))
		end
	end
	local dot = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = Color3.fromRGB(255, 40, 30), BorderSizePixel = 0 }, lens)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	self.label = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 14),
		Size = UDim2.fromOffset(300, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		TextSize = 15,
		TextColor3 = Color3.fromRGB(170, 175, 170),
	}, lens)

	self.cc = make("ColorCorrectionEffect", { Name = "Mirino", Enabled = false, Brightness = 0.12, Contrast = 0.15, TintColor = Color3.fromRGB(235, 245, 255) }, Lighting)
	return self
end

function Scope:holdingRifle(): boolean
	local char = self.player.Character
	return char ~= nil and char:FindFirstChild("Fucile a dardi") ~= nil
end

function Scope:enter()
	if self.active or not self:holdingRifle() or self.player:GetAttribute("Status") ~= "OK" then
		return
	end
	self.active = true
	self.gui.Enabled = true
	self.cc.Enabled = true
	self.savedMode = self.player.CameraMode
	self.player.CameraMode = Enum.CameraMode.LockFirstPerson
	UserInputService.MouseDeltaSensitivity = 0.3
	Sfx.new("ScopeZoom", SoundService, { Volume = 0.7, PlayOnRemove = true }):Destroy()
	local camera = workspace.CurrentCamera
	self.savedFov = camera.FieldOfView
	TweenService:Create(camera, TweenInfo.new(0.18), { FieldOfView = 70 / self.zoom }):Play()
	self.wheel = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			self.zoom = math.clamp(self.zoom + input.Position.Z, 2, 8)
			workspace.CurrentCamera.FieldOfView = 70 / self.zoom
		end
	end)
	-- mirino stabilizzato: nessun movimento della visuale, solo un lievissimo ondeggiare del
	-- reticolo quando hai il fiatone o sei nel panico
	RunService:BindToRenderStep("MirinoOscillazione", Enum.RenderPriority.Camera.Value + 2, function()
		local t = os.clock()
		local drift = math.max(0, self.sway - 0.8) * 4
		self.lens.Position = UDim2.new(0.5, math.sin(t * 1.1) * drift, 0.5, math.sin(t * 0.8 + 1) * drift * 0.6)
		self.label.Text = ("%dx · dardi %d"):format(self.zoom, self.player:GetAttribute("Darts") or 0)
	end)
end

function Scope:exit()
	if not self.active then
		return
	end
	self.active = false
	self.gui.Enabled = false
	self.cc.Enabled = false
	self.player.CameraMode = self.savedMode or Enum.CameraMode.Classic
	UserInputService.MouseDeltaSensitivity = 1
	RunService:UnbindFromRenderStep("MirinoOscillazione")
	self.lens.Position = UDim2.fromScale(0.5, 0.5)
	if self.wheel then
		self.wheel:Disconnect()
		self.wheel = nil
	end
	workspace.CurrentCamera.FieldOfView = self.savedFov or 70
end

function Scope:bind()
	ContextActionService:BindAction("Mirino", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			if self.active then
				self:exit()
			else
				self:enter()
			end
		end
		return self:holdingRifle() and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	ContextActionService:SetTitle("Mirino", "Mirino")
	RunService.Heartbeat:Connect(function()
		if self.active and (not self:holdingRifle() or self.player:GetAttribute("Status") ~= "OK") then
			self:exit()
		end
	end)
end

return Scope
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">Tablet</string><ProtectedString name="Source"><![CDATA[-- Tablet di sorveglianza: la visuale passa alla telecamera scelta, dentro la cornice di un tablet
-- rinforzato, con scanline, rumore quando la creatura è vicina, visione IR, zoom e mini-mappa.
-- Ogni frame è protetto da pcall: in caso di errore il tablet lo mostra e resta chiudibile.
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Sfx = require(Shared:WaitForChild("Sfx"))
local MapView = require(script.Parent:WaitForChild("MapView"))

local Tablet = {}
Tablet.__index = Tablet

local STATIC_LINES = 40
local SCANLINES = 70
local BEZEL = Color3.fromRGB(20, 21, 22)
local GREEN = Color3.fromRGB(150, 255, 180)

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local t = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		TextColor3 = GREEN,
		TextSize = 16,
		TextStrokeTransparency = 0.6,
		ZIndex = 6,
	}, parent)
	for k, v in props do
		(t :: any)[k] = v
	end
	return t
end

local function corner(parent: Instance, r: number)
	make("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function rakeRoot(): BasePart?
	local folder = workspace:FindFirstChild("RakeHunt")
	local rake = folder and folder:FindFirstChild("TheRake")
	return rake and rake:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Tablet.new(player: Player, state: Folder, remotes: Folder)
	local self = setmetatable({}, Tablet)
	self.player = player
	self.state = state
	self.remotes = remotes
	self.isOpen = false
	self.index = 1
	self.zoom = 1
	self.nextMap = 0
	self.lastError = nil

	local gui = make("ScreenGui", {
		Name = "RakeTablet",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))
	self.gui = gui

	-- Schermo: tutto ciò che sta fuori è coperto dalla cornice (un tratto molto spesso)
	local screen = make("Frame", {
		Name = "Schermo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.47),
		Size = UDim2.fromScale(0.84, 0.76),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 1,
	}, gui)
	corner(screen, 22)
	local stroke = make("UIStroke", { Thickness = 1600, Color = BEZEL, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, screen)
	make("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(34, 36, 38), Color3.fromRGB(10, 10, 11)),
	}, stroke)
	self.screen = screen

	self.black = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(2, 4, 3), BorderSizePixel = 0, Visible = false, ZIndex = 2 }, screen)
	self.snow = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(170, 175, 170), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3 }, screen)
	self.lines = {}
	for i = 1, STATIC_LINES do
		self.lines[i] = make("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.fromRGB(235, 235, 235), BorderSizePixel = 0, Visible = false, ZIndex = 3 }, screen)
	end
	for i = 0, SCANLINES - 1 do
		make("Frame", {
			Position = UDim2.fromScale(0, i / SCANLINES),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			ZIndex = 4,
		}, screen)
	end
	-- vignetta interna dello schermo
	for _, info in { { 0, UDim2.fromScale(0.25, 1), UDim2.fromScale(0, 0) }, { 180, UDim2.fromScale(0.25, 1), UDim2.fromScale(0.75, 0) }, { 90, UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0) }, { 270, UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0.75) } } do
		local f = make("Frame", { Size = info[2], Position = info[3], BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 4 }, screen)
		make("UIGradient", { Rotation = info[1], Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }) }, f)
	end
	-- angoli del mirino e croce centrale
	for _, c in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		local x, y = c[1], c[2]
		local px = UDim2.new(x, x == 0 and 40 or -40, y, y == 0 and 50 or -50)
		make("Frame", { AnchorPoint = Vector2.new(x, y), Position = px, Size = UDim2.fromOffset(34, 2), BackgroundColor3 = GREEN, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 5 }, screen)
		make("Frame", { AnchorPoint = Vector2.new(x, y), Position = px, Size = UDim2.fromOffset(2, 34), BackgroundColor3 = GREEN, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 5 }, screen)
	end
	label(screen, { Text = "+", TextSize = 22, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(30, 30), TextTransparency = 0.4 })

	-- barra di stato
	self.rec = label(screen, { Position = UDim2.fromOffset(22, 14), Size = UDim2.fromOffset(90, 22), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 70, 70), Font = Enum.Font.Code })
	self.header = label(screen, { Position = UDim2.fromOffset(110, 14), Size = UDim2.new(1, -420, 0, 22), TextXAlignment = Enum.TextXAlignment.Left })
	self.clock = label(screen, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 14), Size = UDim2.fromOffset(140, 22), TextXAlignment = Enum.TextXAlignment.Right })
	local battery = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -60, 0, 18), Size = UDim2.fromOffset(38, 15), BackgroundTransparency = 1, ZIndex = 6 }, screen)
	make("UIStroke", { Color = GREEN, Thickness = 1.5 }, battery)
	self.batteryFill = make("Frame", { Position = UDim2.fromOffset(2, 2), Size = UDim2.new(1, -4, 1, -4), BackgroundColor3 = GREEN, BorderSizePixel = 0, ZIndex = 6 }, battery)
	self.signal = {}
	for i = 1, 4 do
		self.signal[i] = make("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(1, -118 + i * 7, 0, 33),
			Size = UDim2.fromOffset(5, 4 + i * 3),
			BackgroundColor3 = GREEN,
			BorderSizePixel = 0,
			ZIndex = 6,
		}, screen)
	end
	self.alert = label(screen, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 48),
		Size = UDim2.fromOffset(420, 32),
		TextSize = 20,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundColor3 = Color3.fromRGB(170, 20, 20),
		BackgroundTransparency = 1,
	})
	self.message = label(screen, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(0.8, 0, 0, 100),
		TextSize = 22,
		TextWrapped = true,
		ZIndex = 7,
	})
	self.info = label(screen, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 22, 1, -14),
		Size = UDim2.fromOffset(420, 40),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
	})

	-- mappa: piccola nell'angolo, a tutto schermo con M o con il tasto MAPPA
	self.miniMap = MapView.new(screen, 230, 6)
	self.miniMap.frame.AnchorPoint = Vector2.new(1, 1)
	self.miniMap.frame.Position = UDim2.new(1, -18, 1, -18)
	self.bigMapHolder = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(4, 8, 6),
		Visible = false,
		ZIndex = 20,
	}, screen)
	self.bigMap = nil
	self.mapMode = false

	-- cornice: marchio, sensore e tasti fisici
	label(gui, { Text = "BLACKWOOD RANGER · TRK-7", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Color3.fromRGB(110, 112, 110), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.08, 0, 0.09, -2), Size = UDim2.fromOffset(260, 18), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8 })
	local lensDot = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.045), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.fromRGB(8, 10, 14), ZIndex = 8 }, gui)
	corner(lensDot, 99)
	make("UIStroke", { Color = Color3.fromRGB(50, 52, 56), Thickness = 2 }, lensDot)
	self.powerLed = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.92, 0, 0.045, 0), Size = UDim2.fromOffset(7, 7), BackgroundColor3 = Color3.fromRGB(80, 255, 120), ZIndex = 8 }, gui)
	corner(self.powerLed, 99)

	local function key(text: string, x: number, callback: () -> ()): TextButton
		local b = make("TextButton", {
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 18,
			TextColor3 = Color3.fromRGB(190, 195, 190),
			BackgroundColor3 = Color3.fromRGB(38, 40, 42),
			AutoButtonColor = true,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, x, 0.93, 0),
			Size = UDim2.fromOffset(62, 36),
			ZIndex = 8,
		}, gui)
		corner(b, 8)
		make("UIStroke", { Color = Color3.fromRGB(70, 72, 74), Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
		b.Activated:Connect(callback)
		return b
	end
	key("◀", -170, function()
		self:switch(-1)
	end)
	self.rotL = key("⟲", -85, function()
		self:rotate(-1)
	end)
	key("✕", 0, function()
		self:close()
	end)
	self.rotR = key("⟳", 85, function()
		self:rotate(1)
	end)
	key("▶", 170, function()
		self:switch(1)
	end)
	local mapKey = key("MAPPA", 270, function()
		self:toggleMap()
	end)
	mapKey.Size = UDim2.fromOffset(90, 36)
	label(gui, {
		Text = "Q/E camera · Z/C ruota · rotella zoom · M mappa · T chiudi",
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(100, 104, 100),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.975),
		Size = UDim2.fromOffset(400, 16),
		ZIndex = 8,
	})

	self.cc = make("ColorCorrectionEffect", { Name = "TabletFeed", Enabled = false }, Lighting)
	self.staticSound = Sfx.new("Static", SoundService, { Volume = 0 })
	return self
end

function Tablet:cameras(): { Model }
	local folder = workspace:FindFirstChild("RakeHunt")
	folder = folder and folder:FindFirstChild("Telecamere")
	local list = {}
	if folder then
		for _, m in folder:GetChildren() do
			if m:IsA("Model") and m:FindFirstChild("Body") then
				table.insert(list, m)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Id") or 0) < (b:GetAttribute("Id") or 0)
	end)
	return list
end

function Tablet:current(): Model?
	local list = self:cameras()
	if #list == 0 then
		return nil
	end
	self.index = (self.index - 1) % #list + 1
	return list[self.index]
end

function Tablet:switch(dir: number)
	self.index += dir
	self.zoom = 1
end

function Tablet:rotate(dir: number)
	local m = self:current()
	if m and m:GetAttribute("Type") == "Motorizzata" then
		self.remotes.RotateCamera:FireServer(m:GetAttribute("Id"), dir)
	end
end

function Tablet:toggle()
	if self.isOpen then
		self:close()
	else
		self:open()
	end
end

function Tablet:open()
	if self.isOpen or self.player:GetAttribute("Status") == "Braccato" then
		return
	end
	self.isOpen = true
	self.lastError = nil
	self.gui.Enabled = true
	local camera = workspace.CurrentCamera
	self.savedFov = camera.FieldOfView
	camera.CameraType = Enum.CameraType.Scriptable
	self.staticSound:Play()

	local function bind(name: string, keys: { Enum.KeyCode }, fn: (Enum.KeyCode) -> ())
		ContextActionService:BindActionAtPriority(name, function(_, inputState, input)
			if inputState == Enum.UserInputState.Begin then
				fn(input.KeyCode)
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, table.unpack(keys))
	end
	bind("TabletPrev", { Enum.KeyCode.Q, Enum.KeyCode.Left, Enum.KeyCode.DPadLeft }, function()
		self:switch(-1)
	end)
	bind("TabletNext", { Enum.KeyCode.E, Enum.KeyCode.Right, Enum.KeyCode.DPadRight }, function()
		self:switch(1)
	end)
	bind("TabletRotate", { Enum.KeyCode.Z, Enum.KeyCode.C }, function(code)
		self:rotate(code == Enum.KeyCode.Z and -1 or 1)
	end)
	bind("TabletMap", { Enum.KeyCode.M }, function()
		self:toggleMap()
	end)
	self.wheel = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			self.zoom = math.clamp(self.zoom + input.Position.Z * 0.25, 1, 3)
		end
	end)

	RunService:BindToRenderStep("RakeTablet", Enum.RenderPriority.Camera.Value + 1, function()
		local ok, err = pcall(self.render, self)
		if not ok and err ~= self.lastError then
			self.lastError = err
			warn("[Tablet] " .. tostring(err))
			self.black.Visible = true
			self.message.Text = "ERRORE DEL TABLET\n" .. tostring(err)
		end
	end)
end

-- Accende in locale l'illuminatore IR della camera che stai guardando (e alza l'esposizione)
function Tablet:setIlluminator(light: SpotLight?)
	if self.illuminator == light then
		return
	end
	if self.illuminator then
		self.illuminator.Enabled = false
	end
	self.illuminator = light
	if light then
		light.Enabled = true
		if not self.savedExposure then
			self.savedExposure = Lighting.ExposureCompensation
		end
		Lighting.ExposureCompensation = (self.savedExposure or 0) + 1.3
	elseif self.savedExposure then
		Lighting.ExposureCompensation = self.savedExposure
		self.savedExposure = nil
	end
end

function Tablet:close()
	if not self.isOpen then
		return
	end
	self:setIlluminator(nil)
	self.isOpen = false
	self.gui.Enabled = false
	self.cc.Enabled = false
	self.staticSound:Stop()
	RunService:UnbindFromRenderStep("RakeTablet")
	for _, name in { "TabletPrev", "TabletNext", "TabletRotate", "TabletMap" } do
		ContextActionService:UnbindAction(name)
	end
	if self.wheel then
		self.wheel:Disconnect()
		self.wheel = nil
	end
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = self.savedFov or 70
	local hum = self.player.Character and self.player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		camera.CameraSubject = hum
	end
end

function Tablet:setStatic(noise: number)
	self.snow.BackgroundTransparency = 1 - noise * 0.5
	for _, line in self.lines do
		if math.random() < noise then
			line.Visible = true
			line.Position = UDim2.fromScale(0, math.random())
			line.BackgroundTransparency = 0.2 + math.random() * 0.6
			line.Size = UDim2.new(1, 0, 0, math.random(1, 5))
		else
			line.Visible = false
		end
	end
	self.staticSound.Volume = 0.05 + noise * 0.6
	for i, bar in self.signal do
		bar.BackgroundTransparency = (i / 4 > 1 - noise * 0.9 + 0.05) and 0.8 or 0
	end
end

function Tablet:render()
	if self.player:GetAttribute("Status") == "Braccato" then
		self:close()
		return
	end
	local camera = workspace.CurrentCamera
	local m = self:current()
	local blink = os.clock() % 1 < 0.55
	local t = Lighting.ClockTime
	self.clock.Text = ("%02d:%02d:%02d"):format(math.floor(t), math.floor(t % 1 * 60), math.floor(os.clock() * 7 % 60))
	self.alert.Text = ""
	self.alert.BackgroundTransparency = 1
	self.rotL.Visible = false
	self.rotR.Visible = false
	self.powerLed.BackgroundTransparency = blink and 0 or 0.6

	if not m then
		self:setIlluminator(nil)
		self.black.Visible = true
		self.cc.Enabled = false
		self:setStatic(0.2)
		self.header.Text = "NESSUNA TELECAMERA"
		self.rec.Text = ""
		self.info.Text = ""
		self.batteryFill.Size = UDim2.new(0, 0, 1, -4)
		self.message.Text = "Nessuna telecamera piazzata.\nEquipaggia la Telecamera [2] e fai clic per piazzarla."
	else
		local id = m:GetAttribute("Id") or 0
		local camType = m:GetAttribute("Type") or "Fissa"
		local online = m:GetAttribute("Online")
		local battery = math.clamp((m:GetAttribute("Battery") or 0) / Config.CAMERAS.BATTERY, 0, 1)
		self.header.Text = ("CAM %02d · %s · %s"):format(id, string.upper(camType), string.upper(m:GetAttribute("Label") or ""))
		self.batteryFill.Size = UDim2.new(battery, -4, 1, -4)
		self.batteryFill.BackgroundColor3 = battery < 0.2 and Color3.fromRGB(255, 80, 60) or GREEN
		local nightNow = Lighting.ClockTime >= 19.5 or Lighting.ClockTime < 6
		self.info.Text = ("ZOOM %.1fx · %s\nproprietario: %s"):format(self.zoom, nightNow and "VISIONE NOTTURNA IR" or "DIURNA", m:GetAttribute("OwnerName") or "?")

		if not online or camType == "Trappola" then
			self:setIlluminator(nil)
		end
		if not online then
			self.black.Visible = true
			self.cc.Enabled = false
			self:setStatic(0.7)
			self.rec.Text = ""
			self.message.Text = "NESSUN SEGNALE\nBatteria esaurita: recupera la camera per ricaricarla."
		elseif camType == "Trappola" then
			self.black.Visible = true
			self.cc.Enabled = false
			self:setStatic(0.05)
			self.rec.Text = blink and "● ARMATA" or ""
			self.message.Text = "CAMERA TRAPPOLA\nNessun video in diretta: scatta una foto quando rileva un movimento."
		else
			self.black.Visible = false
			self.message.Text = ""
			self.rec.Text = blink and "● REC" or ""
			local body = m:FindFirstChild("Body") :: BasePart
			local noise = 0
			local root = rakeRoot()
			if root then
				noise = math.clamp(1 - (root.Position - body.Position).Magnitude / Config.CAMERAS.DISTORT_RANGE, 0, 1)
			end
			for _, w in Config.WEATHER do
				if w.name == self.state:GetAttribute("Weather") then
					noise = math.max(noise, w.cameraNoise * 0.35)
				end
			end
			local jitter = noise * 0.035
			camera.CFrame = body.CFrame
				* CFrame.new(0, 0, -1.25)
				* CFrame.Angles((math.random() - 0.5) * jitter, (math.random() - 0.5) * jitter, 0)
			camera.FieldOfView = Config.CAMERAS.FOV / self.zoom
			self:setStatic(noise)

			local night = Lighting.ClockTime >= 19.5 or Lighting.ClockTime < 6
			local cc = self.cc
			cc.Enabled = true
			-- visione notturna a infrarossi di serie su tutte le telecamere
			self:setIlluminator(night and body:FindFirstChild("Illuminatore") :: SpotLight? or nil)
			if night then
				cc.TintColor = Color3.fromRGB(170, 255, 175)
				cc.Brightness = camType == "IR" and 0.3 or 0.24
				cc.Contrast = 0.4 + noise * 0.4
				cc.Saturation = -1
			else
				cc.TintColor = Color3.fromRGB(230, 240, 255)
				cc.Brightness = night and 0.04 or 0
				cc.Contrast = 0.2 + noise * 0.6
				cc.Saturation = -0.7
			end
			if m:GetAttribute("Sees") then
				self.alert.Text = "⚠ MOVIMENTO RILEVATO"
				self.alert.BackgroundTransparency = blink and 0.2 or 0.6
			elseif noise > 0.45 then
				self.alert.Text = blink and "INTERFERENZA" or ""
			end
			local motorized = camType == "Motorizzata"
			self.rotL.Visible = motorized
			self.rotR.Visible = motorized
		end
	end

	if os.clock() >= self.nextMap then
		self.nextMap = os.clock() + 0.2
		if self.mapMode and self.bigMap then
			self.bigMap:update(self.player, self.state, m)
		else
			self.miniMap:update(self.player, self.state, m)
		end
	end
end

function Tablet:toggleMap()
	self.mapMode = not self.mapMode
	if self.mapMode and not self.bigMap then
		local size = math.floor(math.min(self.screen.AbsoluteSize.X, self.screen.AbsoluteSize.Y) * 0.92)
		self.bigMap = MapView.new(self.bigMapHolder, math.max(size, 300), 21)
		self.bigMap.frame.AnchorPoint = Vector2.new(0.5, 0.5)
		self.bigMap.frame.Position = UDim2.fromScale(0.5, 0.5)
	end
	self.bigMapHolder.Visible = self.mapMode
	self.miniMap.frame.Visible = not self.mapMode
	self.nextMap = 0
end

return Tablet
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">Watch</string><ProtectedString name="Source"><![CDATA[-- Smartwatch al polso (HUD in basso a sinistra): anelli di stamina e paura, ora e bussola,
-- battito cardiaco che pulsa, batterie di torcia e visore, attrezzatura e avvisi con bip.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Sfx = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sfx"))

local Watch = {}
Watch.__index = Watch

local DOTS = 40
local FACE = 176
local TEAL = Color3.fromRGB(70, 230, 190)
local PURPLE = Color3.fromRGB(190, 90, 255)
local RED = Color3.fromRGB(255, 70, 60)
local DIM = Color3.fromRGB(38, 42, 44)
local TEXT = Color3.fromRGB(225, 235, 230)
local MUTED = Color3.fromRGB(120, 130, 128)

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

local function corner(parent: Instance, r: number)
	make("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local t = make("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextColor3 = TEXT, TextSize = 12 }, parent)
	for k, v in props do
		(t :: any)[k] = v
	end
	return t
end

local function ring(parent: Instance, radius: number, size: number)
	local dots = {}
	for i = 1, DOTS do
		local a = (i - 1) / DOTS * math.pi * 2 - math.pi / 2
		local d = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.cos(a) * radius, 0.5, math.sin(a) * radius),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = DIM,
			BorderSizePixel = 0,
			ZIndex = 4,
		}, parent)
		corner(d, 99)
		dots[i] = d
	end
	return dots
end

local function fill(dots, value: number, color: Color3)
	local lit = math.floor(math.clamp(value, 0, 1) * #dots + 0.5)
	for i, d in dots do
		d.BackgroundColor3 = i <= lit and color or DIM
	end
end

local function battery(parent: Instance, pos: UDim2, name: string)
	local holder = make("Frame", { Position = pos, Size = UDim2.fromOffset(58, 12), BackgroundTransparency = 1, ZIndex = 4 }, parent)
	label(holder, { Text = name, Size = UDim2.fromOffset(14, 12), TextSize = 10, TextColor3 = MUTED, ZIndex = 4 })
	local shell = make("Frame", { Position = UDim2.fromOffset(16, 1), Size = UDim2.fromOffset(28, 10), BackgroundTransparency = 1, ZIndex = 4 }, holder)
	make("UIStroke", { Color = MUTED, Thickness = 1 }, shell)
	corner(shell, 2)
	local bar = make("Frame", { Position = UDim2.fromOffset(1, 1), Size = UDim2.new(1, -2, 1, -2), BackgroundColor3 = TEAL, BorderSizePixel = 0, ZIndex = 4 }, shell)
	local pct = label(holder, { Position = UDim2.fromOffset(46, 0), Size = UDim2.fromOffset(20, 12), TextSize = 9, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = MUTED, ZIndex = 4 })
	return { bar = bar, pct = pct }
end

local function setBattery(b, value: number, active: boolean)
	value = math.clamp(value, 0, 1)
	b.bar.Size = UDim2.new(value, -2, 1, -2)
	b.bar.BackgroundColor3 = value < 0.2 and RED or (active and Color3.fromRGB(255, 220, 120) or TEAL)
	b.pct.Text = ("%d"):format(math.floor(value * 100))
end

function Watch.new(parent: Instance)
	local self = setmetatable({}, Watch)
	local root = make("Frame", {
		Name = "Smartwatch",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 26, 1, -18),
		Size = UDim2.fromOffset(210, 290),
		BackgroundTransparency = 1,
	}, parent)
	self.root = root
	-- cinturino
	for _, info in { { 0, -0.02 }, { 1, 1.02 } } do
		local strap = make("Frame", {
			AnchorPoint = Vector2.new(0.5, info[1]),
			Position = UDim2.fromScale(0.5, info[2] == -0.02 and 0 or 1),
			Size = UDim2.fromOffset(120, 64),
			BackgroundColor3 = Color3.fromRGB(26, 27, 29),
			BorderSizePixel = 0,
			ZIndex = 1,
		}, root)
		corner(strap, 16)
		make("UIGradient", { Rotation = 0, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(18, 18, 20)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(44, 45, 48)), ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 18, 20)) }) }, strap)
		for k = 1, 3 do
			local hole = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, info[1] == 0 and 0.2 or 0.8, (k - 2) * 0), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = Color3.fromRGB(8, 8, 9), ZIndex = 1 }, strap)
			corner(hole, 99)
			hole.Position = UDim2.new(0.5, (k - 2) * 26, info[1] == 0 and 0.3 or 0.7, 0)
		end
	end
	-- cassa
	local case = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(204, 204),
		BackgroundColor3 = Color3.fromRGB(70, 74, 78),
		ZIndex = 2,
	}, root)
	corner(case, 52)
	make("UIGradient", { Rotation = 45, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 155, 160)), ColorSequenceKeypoint.new(0.35, Color3.fromRGB(60, 63, 67)), ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 32, 34)) }) }, case)
	make("UIStroke", { Color = Color3.fromRGB(20, 21, 22), Thickness = 2 }, case)
	local crown = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(1, -2, 0.42, 0), Size = UDim2.fromOffset(9, 30), BackgroundColor3 = Color3.fromRGB(90, 94, 98), ZIndex = 1 }, case)
	corner(crown, 4)
	local button = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(1, -2, 0.68, 0), Size = UDim2.fromOffset(6, 20), BackgroundColor3 = Color3.fromRGB(170, 40, 30), ZIndex = 1 }, case)
	corner(button, 3)
	-- schermo
	local screen = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(FACE, FACE),
		BackgroundColor3 = Color3.fromRGB(4, 6, 7),
		ClipsDescendants = true,
		ZIndex = 3,
	}, case)
	corner(screen, 42)
	make("UIStroke", { Color = Color3.fromRGB(8, 9, 10), Thickness = 3 }, screen)
	self.screen = screen
	self.stamina = ring(screen, 80, 5)
	self.fear = ring(screen, 70, 4)
	self.time = label(screen, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 30), Size = UDim2.fromOffset(120, 30), Font = Enum.Font.GothamBold, TextSize = 30, ZIndex = 4 })
	self.compass = label(screen, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 60), Size = UDim2.fromOffset(120, 12), TextSize = 10, TextColor3 = MUTED, ZIndex = 4 })
	self.heart = label(screen, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0.5, -4, 0, 88), Size = UDim2.fromOffset(24, 24), Text = "♥", TextSize = 18, TextColor3 = RED, ZIndex = 4 })
	self.bpm = label(screen, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 0, 0, 88), Size = UDim2.fromOffset(60, 20), Font = Enum.Font.GothamBold, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4 })
	label(screen, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 36, 0, 90), Size = UDim2.fromOffset(30, 12), Text = "BPM", TextSize = 8, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4 })
	self.torch = battery(screen, UDim2.fromOffset(32, 104), "T")
	self.nv = battery(screen, UDim2.fromOffset(92, 104), "V")
	self.gear = label(screen, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 122), Size = UDim2.fromOffset(130, 12), TextSize = 10, TextColor3 = TEXT, ZIndex = 4 })
	self.status = label(screen, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 136), Size = UDim2.fromOffset(120, 12), Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = TEAL, ZIndex = 4 })
	self.alarm = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RED, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, screen)
	self.sos = label(self.alarm, { Size = UDim2.fromScale(1, 1), Text = "SOS", Font = Enum.Font.GothamBlack, TextSize = 44, TextTransparency = 1, ZIndex = 6 })
	-- riflesso del vetro
	local glass = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.9, BorderSizePixel = 0, ZIndex = 7 }, screen)
	make("UIGradient", { Rotation = 60, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.35, 1), NumberSequenceKeypoint.new(1, 1) }) }, glass)
	self.rank = label(root, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.fromOffset(200, 12), TextSize = 10, TextColor3 = MUTED, ZIndex = 2 })

	self.beatPhase = 0
	self.lastAlert = ""
	self.beep = Sfx.new("WatchBeep", SoundService, { Volume = 0.5 })
	return self
end

-- info: { stamina, fear, nv, nvOn, exhausted, panic, closeness, sprinting, dt }
function Watch:update(info, player: Player)
	local status = player:GetAttribute("Status") or "Lobby"
	fill(self.stamina, info.stamina / 100, info.exhausted and Color3.fromRGB(255, 170, 60) or TEAL)
	fill(self.fear, info.fear / 100, info.panic and RED or PURPLE)

	-- battito: sale con paura, corsa e creatura vicina
	local bpm = 66 + info.fear * 0.7 + (info.sprinting and 28 or 0) + info.closeness * 35
	self.beatPhase += info.dt * bpm / 60
	local beat = self.beatPhase % 1
	local pulse = beat < 0.12 and 1 or (beat < 0.3 and 0.5 or 0)
	self.heart.TextSize = 16 + pulse * 6
	self.bpm.Text = tostring(math.floor(bpm))
	self.bpm.TextColor3 = bpm > 130 and RED or TEXT

	local t = Lighting.ClockTime
	self.time.Text = ("%02d:%02d"):format(math.floor(t), math.floor(t % 1 * 60))
	local look = workspace.CurrentCamera.CFrame.LookVector
	local heading = (math.deg(math.atan2(look.X, -look.Z)) + 360) % 360
	local names = { "N", "NE", "E", "SE", "S", "SO", "O", "NO" }
	self.compass.Text = ("%s  %03d°"):format(names[math.floor((heading + 22.5) / 45) % 8 + 1], math.floor(heading))

	setBattery(self.torch, (player:GetAttribute("TorchBattery") or 0) / info.config.EQUIPMENT.TORCH_BATTERY, player:GetAttribute("TorchOn") == true)
	setBattery(self.nv, info.nv, info.nvOn)
	self.gear.Text = ("DARDI %d · %s %d · CAMP %d"):format(
		player:GetAttribute("Darts") or 0,
		string.upper(string.sub(player:GetAttribute("CamType") or "Fissa", 1, 4)),
		player:GetAttribute("Kits_" .. (player:GetAttribute("CamType") or "Fissa")) or 0,
		player:GetAttribute("Samples") or 0
	)

	local alert = ""
	if status == "Braccato" then
		alert = "SOS"
	elseif info.panic then
		alert = "PANICO"
	elseif info.closeness > 0.3 then
		alert = "MOVIMENTO VICINO"
	elseif info.exhausted then
		alert = "FIATONE"
	elseif (player:GetAttribute("TorchBattery") or 1) < 20 then
		alert = "BATTERIA TORCIA"
	end
	self.status.Text = alert ~= "" and alert or "OK"
	self.status.TextColor3 = alert ~= "" and RED or TEAL
	if alert ~= self.lastAlert then
		self.lastAlert = alert
		if alert ~= "" then
			self.beep:Play()
		end
	end
	local sos = status == "Braccato"
	local flash = sos and (os.clock() % 0.8 < 0.4)
	self.alarm.BackgroundTransparency = flash and 0.25 or 1
	self.sos.TextTransparency = sos and 0 or 1

	local stats = player:FindFirstChild("leaderstats")
	local rank = stats and stats:FindFirstChild("Rango")
	local level = stats and stats:FindFirstChild("Livello")
	self.rank.Text = rank and level and ("%s · LIV %d"):format(string.upper(rank.Value), level.Value) or ""
end

return Watch
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>