<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX3"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX2"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Impostazioni della modalità "Coin Rush". Modifica questi valori per bilanciare il gioco.
return {
	-- Giocatori necessari per avviare un round (metti 2+ per un server pubblico)
	MIN_PLAYERS = 1,

	-- Durate in secondi
	INTERMISSION = 15,
	ROUND_DURATION = 90,
	RESULTS_DURATION = 6,

	-- Monete
	COIN_SPAWN_INTERVAL = 1.2,
	MAX_COINS = 25,
	COIN_VALUE = 1,

	-- Arena (generata automaticamente in Workspace se non esiste)
	ARENA_CENTER = Vector3.new(0, 200, 0),
	ARENA_SIZE = 120,
	PILLAR_COUNT = 14,

	-- Sotto questa distanza dal pavimento dell'arena il giocatore è eliminato
	FALL_LIMIT = 25,
}
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX7"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX6"><Properties><string name="Name">GameMode</string><ProtectedString name="Source"><![CDATA[-- Coin Rush: ciclo dei round (attesa -> intervallo -> round -> risultati).
-- Durante il round i giocatori vengono portati nell'arena sospesa e devono raccogliere
-- più monete possibile. Chi cade o muore è eliminato. Vince chi ha più monete.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Arena = require(script.Arena)
local Coins = require(script.Coins)

-- Stato condiviso letto dall'HUD dei client
local gameState = Instance.new("Folder")
gameState.Name = "GameState"
local status = Instance.new("StringValue")
status.Name = "Status"
status.Parent = gameState
local timeLeft = Instance.new("IntValue")
timeLeft.Name = "TimeLeft"
timeLeft.Parent = gameState
gameState.Parent = ReplicatedStorage

local function setupLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Monete"
	coins.Parent = leaderstats
	local wins = Instance.new("IntValue")
	wins.Name = "Vittorie"
	wins.Parent = leaderstats
	leaderstats.Parent = player
end

Players.PlayerAdded:Connect(setupLeaderstats)
for _, player in Players:GetPlayers() do
	setupLeaderstats(player)
end

local arena = Arena.build()
local participants: { [Player]: boolean } = {}

Players.PlayerRemoving:Connect(function(player)
	participants[player] = nil
end)

local function participantCount(): number
	local count = 0
	for _ in participants do
		count += 1
	end
	return count
end

local function stat(player: Player, name: string): IntValue
	return (player:WaitForChild("leaderstats") :: Folder):WaitForChild(name) :: IntValue
end

-- Conto alla rovescia; onTick viene chiamato ogni secondo e può interromperlo restituendo true.
local function countdown(seconds: number, text: string, onTick: (() -> boolean)?)
	status.Value = text
	for t = seconds, 1, -1 do
		timeLeft.Value = t
		if onTick and onTick() then
			break
		end
		task.wait(1)
	end
	timeLeft.Value = 0
end

-- Elimina chi è caduto dall'arena senza aspettare FallenPartsDestroyHeight.
local function eliminateFallen()
	local limit = Arena.floorHeight(arena) - Config.FALL_LIMIT
	for player in participants do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and root.Position.Y < limit then
			humanoid.Health = 0
		end
	end
end

local function waitForPlayers()
	while #Players:GetPlayers() < Config.MIN_PLAYERS do
		status.Value = string.format("In attesa di giocatori (%d/%d)", #Players:GetPlayers(), Config.MIN_PLAYERS)
		timeLeft.Value = 0
		task.wait(1)
	end
end

local function runRound()
	participants = {}
	local connections = {}

	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if character and humanoid and humanoid.Health > 0 then
			participants[player] = true
			stat(player, "Monete").Value = 0
			character:PivotTo(CFrame.new(Arena.randomSurfacePoint(arena, 4)))
			table.insert(
				connections,
				humanoid.Died:Connect(function()
					participants[player] = nil
				end)
			)
		end
	end

	if participantCount() == 0 then
		return
	end

	local coins = Coins.new(arena, function(player)
		if not participants[player] then
			return false
		end
		stat(player, "Monete").Value += Config.COIN_VALUE
		return true
	end)

	local running = true
	task.spawn(function()
		while running do
			coins:spawn()
			task.wait(Config.COIN_SPAWN_INTERVAL)
		end
	end)

	countdown(Config.ROUND_DURATION, "Raccogli le monete!", function()
		eliminateFallen()
		return participantCount() == 0
	end)

	running = false
	coins:destroy()
	for _, connection in connections do
		connection:Disconnect()
	end

	-- Vince chi è sopravvissuto con più monete (pareggio = vittoria per tutti)
	local best, winners = 0, {}
	for player in participants do
		local score = stat(player, "Monete").Value
		if score > best then
			best, winners = score, { player }
		elseif score == best and score > 0 then
			table.insert(winners, player)
		end
	end

	if #winners == 0 then
		status.Value = "Nessun vincitore questa volta!"
	else
		local names = {}
		for _, player in winners do
			stat(player, "Vittorie").Value += 1
			table.insert(names, player.DisplayName)
		end
		status.Value = string.format("Vince %s con %d monete!", table.concat(names, ", "), best)
	end
	timeLeft.Value = 0
	task.wait(Config.RESULTS_DURATION)

	-- Riporta i sopravvissuti nella lobby
	for player in participants do
		if player.Parent then
			player:LoadCharacter()
		end
	end
	participants = {}
end

while true do
	waitForPlayers()
	countdown(Config.INTERMISSION, "Il round inizia tra poco", function()
		return #Players:GetPlayers() < Config.MIN_PLAYERS
	end)
	if #Players:GetPlayers() >= Config.MIN_PLAYERS then
		runRound()
	end
end
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Arena</string><ProtectedString name="Source"><![CDATA[-- Costruisce l'arena sospesa e la lobby, e trova punti casuali sulle superfici.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Arena = {}

local rng = Random.new()

local function makePart(props: { [string]: any }, parent: Instance): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

local function ensureLobbySpawn()
	if workspace:FindFirstChildWhichIsA("SpawnLocation", true) then
		return
	end
	makePart({
		Name = "LobbyFloor",
		Size = Vector3.new(60, 1, 60),
		Position = Vector3.new(0, 0, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(90, 90, 110),
	}, workspace)
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 1, 0)
	spawn.Neutral = true
	spawn.Parent = workspace
end

function Arena.build(): Model
	ensureLobbySpawn()

	local existing = workspace:FindFirstChild("CoinRushArena")
	if existing then
		return existing
	end

	local model = Instance.new("Model")
	model.Name = "CoinRushArena"

	local size = Config.ARENA_SIZE
	local center = Config.ARENA_CENTER

	local floor = makePart({
		Name = "Floor",
		Size = Vector3.new(size, 2, size),
		Position = center,
		Material = Enum.Material.Grass,
		Color = Color3.fromRGB(75, 151, 75),
	}, model)
	model.PrimaryPart = floor

	-- Pilastri di altezze diverse: le monete in cima premiano chi sa saltare.
	local layout = Random.new(42)
	local half = size / 2 - 10
	for i = 1, Config.PILLAR_COUNT do
		local height = layout:NextInteger(3, 14)
		local width = layout:NextInteger(6, 12)
		makePart({
			Name = "Pillar" .. i,
			Size = Vector3.new(width, height, width),
			Position = center
				+ Vector3.new(layout:NextNumber(-half, half), 1 + height / 2, layout:NextNumber(-half, half)),
			Material = Enum.Material.Slate,
			Color = Color3.fromHSV(layout:NextNumber(), 0.35, 0.75),
		}, model)
	end

	model.Parent = workspace
	return model
end

-- Restituisce un punto casuale sopra la prima superficie dell'arena colpita dall'alto.
function Arena.randomSurfacePoint(model: Model, heightOffset: number): Vector3
	local floor = model.PrimaryPart :: BasePart
	local half = Config.ARENA_SIZE / 2 - 6
	local x = floor.Position.X + rng:NextNumber(-half, half)
	local z = floor.Position.Z + rng:NextNumber(-half, half)
	local top = floor.Position.Y + 100

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { model }

	local result = workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -200, 0), params)
	local y = if result then result.Position.Y else floor.Position.Y + floor.Size.Y / 2
	return Vector3.new(x, y + heightOffset, z)
end

function Arena.floorHeight(model: Model): number
	local floor = model.PrimaryPart :: BasePart
	return floor.Position.Y + floor.Size.Y / 2
end

return Arena
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Coins</string><ProtectedString name="Source"><![CDATA[-- Genera le monete nell'arena e notifica quando un giocatore ne raccoglie una.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Arena = require(script.Parent.Arena)

local Coins = {}
Coins.__index = Coins

export type Coins = typeof(setmetatable(
	{} :: { arena: Model, folder: Folder, onCollected: (Player) -> boolean },
	Coins
))

-- onCollected riceve il giocatore e restituisce true se la moneta va assegnata.
function Coins.new(arena: Model, onCollected: (Player) -> boolean): Coins
	local folder = Instance.new("Folder")
	folder.Name = "CoinRushCoins"
	folder.Parent = workspace
	return setmetatable({ arena = arena, folder = folder, onCollected = onCollected }, Coins)
end

function Coins.spawn(self: Coins)
	if #self.folder:GetChildren() >= Config.MAX_COINS then
		return
	end

	local coin = Instance.new("Part")
	coin.Name = "Coin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.6, 3, 3)
	coin.Color = Color3.fromRGB(255, 200, 40)
	coin.Material = Enum.Material.Neon
	coin.Anchored = true
	coin.CanCollide = false
	coin.Position = Arena.randomSurfacePoint(self.arena, 2.5)

	local taken = false
	coin.Touched:Connect(function(hit)
		if taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and self.onCollected(player) then
			taken = true
			coin:Destroy()
		end
	end)

	coin.Parent = self.folder
end

function Coins.destroy(self: Coins)
	self.folder:Destroy()
end

return Coins
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX10"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX9"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX8"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- Mostra lo stato del round in alto allo schermo e fa ruotare le monete (solo effetto visivo).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local gameState = ReplicatedStorage:WaitForChild("GameState")
local status = gameState:WaitForChild("Status") :: StringValue
local timeLeft = gameState:WaitForChild("TimeLeft") :: IntValue

local gui = Instance.new("ScreenGui")
gui.Name = "CoinRushHUD"
gui.ResetOnSpawn = false

local label = Instance.new("TextLabel")
label.AnchorPoint = Vector2.new(0.5, 0)
label.Position = UDim2.new(0.5, 0, 0, 12)
label.Size = UDim2.new(0, 420, 0, 44)
label.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
label.BackgroundTransparency = 0.25
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.Font = Enum.Font.GothamBold
label.TextScaled = true
label.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = label

local padding = Instance.new("UIPadding")
padding.PaddingLeft = UDim.new(0, 12)
padding.PaddingRight = UDim.new(0, 12)
padding.PaddingTop = UDim.new(0, 6)
padding.PaddingBottom = UDim.new(0, 6)
padding.Parent = label

local function refresh()
	local t = timeLeft.Value
	if t > 0 then
		label.Text = string.format("%s  •  %d:%02d", status.Value, t // 60, t % 60)
	else
		label.Text = status.Value
	end
end

status.Changed:Connect(refresh)
timeLeft.Changed:Connect(refresh)
refresh()

gui.Parent = player:WaitForChild("PlayerGui")

RunService.RenderStepped:Connect(function(dt)
	local folder = workspace:FindFirstChild("CoinRushCoins")
	if not folder then
		return
	end
	for _, coin in folder:GetChildren() do
		if coin:IsA("BasePart") then
			coin.CFrame *= CFrame.Angles(0, dt * 3, 0)
		end
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>
